      catch (_) { /* 読めなければ lang 属性で判断する */ }
      return document.documentElement.lang === "en";
    })();
    return english
      ? {
        badge: "Preview",
        title: "Stage Sketch (Preview)",
        storageNotice: "Up to three scenes. Nothing is saved; reloading restores the sample.",
