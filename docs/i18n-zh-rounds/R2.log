     日本語の端末で英語の体験版を見ていた人が、押した先で日本語へ戻ってしまう。 */
  function lpHref() {
    return `./?lang=${document.documentElement.lang === "en" ? "en" : "ja"}`;
  }

  function previewLabels() {
    const english = (() => {
