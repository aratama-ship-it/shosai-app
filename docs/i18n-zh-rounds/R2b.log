  function clampZoom(zs) {
    zs.z = clamp(zs.z, ZOOM_MIN, ZOOM_MAX);
    const maxX = W - W / zs.z;
    const maxY = H - H / zs.z;
    zs.ox = clamp(zs.ox, 0, Math.max(0, maxX));
