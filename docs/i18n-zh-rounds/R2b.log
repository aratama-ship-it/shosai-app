         （previewLabels と同じ考え方）。 */
      const PERFORMER_LABELS = new Set(["演者", "Performer"]);
    
      function rosterCount(group) {
        const host = document.getElementById(ROSTER_LISTS[group]);
        return host ? host.children.length : 0;
