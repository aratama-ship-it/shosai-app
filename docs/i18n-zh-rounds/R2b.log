  function lockLabel() {
    return document.documentElement.lang === "en"
      ? 'This is available in the full beta. The preview lets you move performers and change the venue.'
      : 'この機能は製品版（β）で使えます。体験版では、演者を動かすことと会場を変えることができます。';
