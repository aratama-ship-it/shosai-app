    [/^「([\s\S]*?)」をこのショーから外します([\s\S]*?)。ページを閉じるまでは「一つ戻す」で戻せます。$/, (match, title, assigned) => { const count = Number((assigned.match(/(\d+)/) || [])[1] || 0); return `Remove “${title}” from this show${count ? ` and ${count} assigned ${count === 1 ? "scene" : "scenes"}` : ""}? You can undo this until the page is closed.`; }],
    [/^([\s\S]*?)・([\s\S]*?)シーン$/, (match, duration, assigned) => `${duration} · ${assigned} ${Number(assigned) === 1 ? "scene" : "scenes"}`],
