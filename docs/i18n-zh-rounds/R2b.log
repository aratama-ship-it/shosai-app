+  const publicLanguage = () => document.documentElement.lang || "ja";
+  const translatePublicSay = (say, message) => {
+    for (const [re, translatedValue] of say || []) {
+      re.lastIndex = 0;
+      if (!re.test(message)) continue;
+      re.lastIndex = 0;
+      return message.replace(re, translatedValue);
