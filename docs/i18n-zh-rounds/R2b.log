+    for (const code of lang === "en" ? ["en"] : [lang, "en"]) {
+      template = packs[code] && packs[code].generated && packs[code].generated[key];
+      if (template) break;
+    }
+    return Object.entries(values).reduce(
+      (value, [name, replacement]) => value.replace(`{${name}}`, String(replacement)),
