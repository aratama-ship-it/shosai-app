        op.arrows.forEach((raw) => scene.arrows.push(normalizeArrow({ ...raw, guest: true })));
        render(); persistSoon();
        return true;
      }
      return false;
    },
    clearGuestArrows() {
      checkpoint();
      state.project.scenes.forEach((scene) => {
        scene.arrows = (scene.arrows || []).filter((arrow) => arrow.guest !== true);
      });
      render(); persistSoon();
    },
    isEnglish() { return isEn(); },
  });
})();
