    ["zh-TW", "zh-Hant"], ["zh-Hant", "zh-Hant"], ["zh-HK", "zh-Hant"],
    ["fr", "en"],
  ];
  cases.forEach(([input, expected]) => {
    assert.equal(languageModel.normalizeLanguage(input), expected, input);
