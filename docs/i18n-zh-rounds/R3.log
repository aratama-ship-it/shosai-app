    if (els.helpModal && !els.helpModal.hidden) renderManualHelp();
    renderMachineryPresets();
    renderModelPicker();
    if (els.animMsValue) els.animMsValue.textContent = `${(state.sceneAnimMs / 1000).toFixed(1)}${languageValue(() => ("s"), () => ("秒"))}`;
