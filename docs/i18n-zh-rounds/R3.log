      </span>
      <button type="button" class="stage-lang" id="stage-lang" aria-pressed="false"
              title="日本語 / English">EN</button>
    </div>
    <!-- 使い方まわりは5つある。全部並べると設定の主目的（機能のオン/オフ）が
