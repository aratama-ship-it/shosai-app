          ), 0);
          if (event.type !== "pointercancel" && draft && draft.points.length >= 2 && length >= 12) {
            if (!hasCapacity(sc().arrows, "arrowsPerScene", 1, "矢印")) return;
            checkpoint();
            sc().arrows.push(normalizeArrow({ ...draft, id: rid("arrow") }));
            render();
            persistSoon();
            announce("矢印を描きました。");
