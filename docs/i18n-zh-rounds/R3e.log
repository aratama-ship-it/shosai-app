+test("会場寸法と書き出し注記は日本語以外で既存の英語経路へ落ちる", () => {
+  assert.match(stageSource, /els\.venueScale\.textContent = languageValue\(/);
+  assert.match(stageSource, /els\.exportNote\.textContent = sx\(note, english\)/);
+  assert.equal(translatedSay(englishPack.say,
+    "2シーン × 正面と平面 ＝ 合計4枚をZIP 1個にまとめます。"),
+  "2 scenes × front and plan = 4 images in 1 ZIP.");
+  assert.equal(translatedSay(englishPack.say,
+    "3シーン × 1枚 ＝ 合計3枚をZIP 1個にまとめます。"),
+  "3 scenes × 1 image = 3 images in 1 ZIP.");
+  assert.equal(translatedSay(englishPack.say, "1枚を落とします。"),
+    "1 image will be downloaded.");
+});
+
