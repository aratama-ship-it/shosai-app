diff --git a//private/tmp/shosai-r3e-browser-evidence.mjs b//private/tmp/shosai-r3e-browser-evidence.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..f1e1695a62fc9a5fafbd838d2f83b475ab82ca93
--- /dev/null
+++ b//private/tmp/shosai-r3e-browser-evidence.mjs
@@ -0,0 +1,158 @@
+import { createHash } from "node:crypto";
+import { writeFile } from "node:fs/promises";
+
+const origin = "http://127.0.0.1:18431";
+const out = "/Users/arata/Library/Mobile Documents/com~apple~CloudDocs/claude code files/show-creative-ideas/shosai-app/docs/i18n-zh-2026-09";
+const pages = await (await fetch("http://127.0.0.1:18445/json/list")).json();
+const target = pages.find((item) => item.type === "page");
+if (!target) throw new Error("page target missing");
+const ws = new WebSocket(target.webSocketDebuggerUrl);
+await new Promise((resolve, reject) => { ws.onopen = resolve; ws.onerror = reject; });
+let id = 0;
+const pending = new Map();
+ws.onmessage = (event) => {
+  const message = JSON.parse(event.data);
+  if (!message.id || !pending.has(message.id)) return;
+  const waiter = pending.get(message.id);
+  pending.delete(message.id);
+  message.error ? waiter.reject(new Error(JSON.stringify(message.error))) : waiter.resolve(message.result);
+};
+const send = (method, params = {}) => new Promise((resolve, reject) => {
+  const current = ++id;
+  pending.set(current, { resolve, reject });
+  ws.send(JSON.stringify({ id: current, method, params }));
+});
+const evaluate = async (expression) => (await send("Runtime.evaluate", {
+  expression,
+  returnByValue: true,
+  awaitPromise: true,
+})).result.value;
+const settle = async () => {
+  for (let attempt = 0; attempt < 200; attempt += 1) {
+    if (await evaluate("document.readyState") === "complete") break;
+    await new Promise((resolve) => setTimeout(resolve, 25));
+  }
+  await new Promise((resolve) => setTimeout(resolve, 400));
+};
+const navigate = async (url) => {
+  await send("Page.navigate", { url });
+  await settle();
+};
+const shot = async (name) => {
+  const png = await send("Page.captureScreenshot", { format: "png", fromSurface: true });
+  await writeFile(`${out}/${name}`, Buffer.from(png.data, "base64"));
+};
+const collect = `(() => {
+  const roots = [document.querySelector('#view-stage'), ...[...document.querySelectorAll('.stage-modal')].filter((node) => !node.hidden)];
+  const rows = [];
+  const seen = new Set();
+  for (const root of roots) {
+    if (!root) continue;
+    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
+    for (let node = walker.nextNode(); node; node = walker.nextNode()) {
+      const parent = node.parentElement;
+      if (!parent || parent.closest('[data-no-i18n], input, textarea, [contenteditable="true"]')) continue;
+      if (!parent.getClientRects().length || getComputedStyle(parent).visibility === 'hidden') continue;
+      const matches = node.data.match(/[\\p{Script=Hiragana}\\p{Script=Katakana}]+/gu) || [];
+      for (const match of matches) {
+        const row = { match, text: parent.textContent.trim(), element: parent.tagName.toLowerCase(), id: parent.id || '', className: String(parent.className || '') };
+        const key = JSON.stringify(row);
+        if (!seen.has(key)) rows.push(row);
+        seen.add(key);
+      }
+    }
+  }
+  return rows;
+})()`;
+
+await send("Page.enable");
+await send("Runtime.enable");
+await send("Network.enable");
+await send("Network.setCacheDisabled", { cacheDisabled: true });
+await send("Network.setBypassServiceWorker", { bypass: true });
+await send("Emulation.setDeviceMetricsOverride", { width: 1440, height: 1000, deviceScaleFactor: 1, mobile: false });
+
+const languageResults = {};
+for (const code of ["en", "ja", "zh-Hans", "zh-Hant"]) {
+  await navigate(`${origin}/index.html?lang=${code}#stage`);
+  await evaluate("localStorage.clear(); true");
+  await send("Page.reload", { ignoreCache: true });
+  await settle();
+  await evaluate("document.getElementById('stage-tour-close')?.click(); true");
+  for (const name of ["cast", "light", "scenes"]) {
+    await evaluate(`(() => { const panel = document.querySelector('[data-panel="${name}"]'); if (panel?.classList.contains('is-collapsed')) panel.querySelector('[data-panel-head]')?.click(); return true; })()`);
+  }
+  const base = await evaluate(`(() => ({
+    lang: document.documentElement.lang,
+    body: document.body.innerText,
+    selectValue: document.querySelector('#stage-lang')?.value,
+    selectOptions: [...document.querySelectorAll('#stage-lang option')].map((option) => option.textContent),
+    venueScale: document.querySelector('#stage-venue-scale')?.textContent,
+    fonts: (() => { const s=getComputedStyle(document.documentElement); return {sans:s.getPropertyValue('--sans').trim(),serif:s.getPropertyValue('--serif').trim()}; })(),
+  }))()`);
+  const states = { main: await evaluate(collect) };
+  if (code.startsWith("zh-")) await shot(`${code}-front.png`);
+  let exportNote = "";
+  for (const [state, openId, closeId] of [
+    ["scenes", "stage-scene-grid-open", "stage-scene-grid-close"],
+    ["export", "stage-export", "stage-export-close"],
+    ["settings", "stage-prefs-btn", "stage-prefs-close"],
+  ]) {
+    await evaluate(`document.getElementById(${JSON.stringify(openId)})?.click(); true`);
+    await new Promise((resolve) => setTimeout(resolve, 120));
+    states[state] = await evaluate(collect);
+    if (state === "export") exportNote = await evaluate("document.querySelector('#stage-export-note')?.textContent || ''");
+    if (code.startsWith("zh-") && state === "settings") await shot(`${code}-settings.png`);
+    await evaluate(`document.getElementById(${JSON.stringify(closeId)})?.click(); true`);
+    await new Promise((resolve) => setTimeout(resolve, 80));
+  }
+  const kana = [];
+  const seen = new Set();
+  for (const [state, rows] of Object.entries(states)) {
+    for (const row of rows) {
+      const key = JSON.stringify(row);
+      if (!seen.has(key)) kana.push({ state, ...row });
+      seen.add(key);
+    }
+  }
+  languageResults[code] = {
+    lang: base.lang,
+    bytes: Buffer.byteLength(base.body),
+    sha256: createHash("sha256").update(base.body).digest("hex"),
+    selectValue: base.selectValue,
+    selectOptions: base.selectOptions,
+    venueScale: base.venueScale,
+    exportNote,
+    fonts: base.fonts,
+    kana,
+  };
+}
+
+const measuredLoad = async (path, run) => {
+  await navigate(`${origin}/${path}?measure=${run}#stage`);
+  const navigation = await evaluate(`(() => { const e=performance.getEntriesByType('navigation')[0]; return {duration:e.duration,loadEventEnd:e.loadEventEnd}; })()`);
+  const resources = await evaluate("performance.getEntriesByType('resource').map((e) => ({name:e.name,transferSize:e.transferSize,encodedBodySize:e.encodedBodySize}))");
+  return {
+    loadEventEnd: navigation.loadEventEnd,
+    transferSize: resources.reduce((sum, item) => sum + item.transferSize, 0),
+    encodedBodySize: resources.reduce((sum, item) => sum + item.encodedBodySize, 0),
+    zhTransferSize: resources.filter((item) => /stage-i18n\.zh-Han[st]\.js/.test(item.name)).reduce((sum, item) => sum + item.transferSize, 0),
+    zhEncodedBodySize: resources.filter((item) => /stage-i18n\.zh-Han[st]\.js/.test(item.name)).reduce((sum, item) => sum + item.encodedBodySize, 0),
+  };
+};
+const loadRuns = { baseline: [], current: [] };
+for (let run = 1; run <= 7; run += 1) {
+  loadRuns.baseline.push(await measuredLoad("index_backup_2026-09-09-before-zh.html", run));
+  loadRuns.current.push(await measuredLoad("index.html", run));
+}
+const median = (values) => [...values].sort((a, b) => a - b)[Math.floor(values.length / 2)];
+const medians = Object.fromEntries(Object.entries(loadRuns).map(([name, rows]) => [name, {
+  loadEventEnd: median(rows.map((row) => row.loadEventEnd)),
+  transferSize: median(rows.map((row) => row.transferSize)),
+  encodedBodySize: median(rows.map((row) => row.encodedBodySize)),
+  zhTransferSize: median(rows.map((row) => row.zhTransferSize)),
+  zhEncodedBodySize: median(rows.map((row) => row.zhEncodedBodySize)),
+}]));
+
+console.log(JSON.stringify({ languageResults, medians, loadRuns }, null, 2));
+ws.close();
