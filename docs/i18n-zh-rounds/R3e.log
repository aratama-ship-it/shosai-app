+import { createHash } from "node:crypto";
+const pages = await (await fetch("http://127.0.0.1:18445/json/list")).json();
+const target = pages.find((item) => item.type === "page");
+const ws = new WebSocket(target.webSocketDebuggerUrl);
+await new Promise((resolve, reject) => { ws.onopen = resolve; ws.onerror = reject; });
+let id = 0;
+const pending = new Map();
+ws.onmessage = ({ data }) => {
+  const message = JSON.parse(data);
+  const waiter = pending.get(message.id);
+  if (!waiter) return;
+  pending.delete(message.id);
+  message.error ? waiter.reject(message.error) : waiter.resolve(message.result);
+};
+const send = (method, params = {}) => new Promise((resolve, reject) => {
+  const callId = ++id;
+  pending.set(callId, { resolve, reject });
+  ws.send(JSON.stringify({ id: callId, method, params }));
+});
+const evaluate = async (expression) => (await send("Runtime.evaluate", { expression, returnByValue: true })).result.value;
+const results = [];
+for (const page of ["stage.html", "index.html"]) {
+  for (const code of ["en", "ja"]) {
+    await send("Page.navigate", { url: `http://127.0.0.1:18431/${page}?lang=${code}#stage` });
+    for (let n = 0; n < 200 && await evaluate("document.readyState") !== "complete"; n += 1) {
+      await new Promise((resolve) => setTimeout(resolve, 25));
+    }
+    await evaluate("localStorage.clear(); true");
+    await send("Page.reload", { ignoreCache: true });
+    for (let n = 0; n < 200 && await evaluate("document.readyState") !== "complete"; n += 1) {
+      await new Promise((resolve) => setTimeout(resolve, 25));
+    }
+    await new Promise((resolve) => setTimeout(resolve, 2200));
+    const value = JSON.parse(await evaluate("JSON.stringify({lang:document.documentElement.lang,text:document.body.innerText})"));
+    const bytes = Buffer.from(value.text);
+    results.push({ page, code, lang: value.lang, bytes: bytes.length, sha256: createHash("sha256").update(bytes).digest("hex") });
+  }
+}
+console.log(JSON.stringify(results, null, 2));
+ws.close();
