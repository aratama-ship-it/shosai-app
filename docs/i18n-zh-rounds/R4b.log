   111	function templateChoices(expr) {
   112	  const quoted = [...expr.matchAll(/"((?:\\.|[^"])*)"|'((?:\\.|[^'])*)'/g)]
   113	    .map((match) => parseLiteral(match[0]));
   114	  if (expr.includes("?") && expr.includes(":") && quoted.length >= 2) {
   115	    return quoted.slice(0, 2);
   116	  }
   117	  if (expr.trim() === "word") {
   118	    return ["動線", "演者の動線", "照明の動線", "装置の動線"];
   119	  }
   120	  return ["名前X", "3"];
