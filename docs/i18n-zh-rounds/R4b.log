    90	function readQuotedLiteral(source, start) {
    91	  const quote = source[start];
    92	  let cursor = start + 1;
    93	  let escaped = false;
    94	  for (; cursor < source.length; cursor += 1) {
    95	    const char = source[cursor];
    96	    if (escaped) {
    97	      escaped = false;
    98	    } else if (char === "\\") {
    99	      escaped = true;
   100	    } else if (char === quote) {
   101	      return { raw: source.slice(start, cursor + 1), end: cursor + 1 };
   102	    }
   103	  }
   104	  return null;
