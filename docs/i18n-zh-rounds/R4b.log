   123	function expandTemplate(raw) {
   124	  const body = raw.slice(1, -1);
   125	  let parts = [""];
   126	  let cursor = 0;
   127	  while (cursor < body.length) {
   128	    const exprStart = body.indexOf("${", cursor);
   129	    if (exprStart === -1) {
   130	      parts = parts.map((part) => part + body.slice(cursor));
   131	      break;
   132	    }
   133	    parts = parts.map((part) => part + body.slice(cursor, exprStart));
   134	    let depth = 1;
   135	    let inner = exprStart + 2;
   136	    let quote = "";
   137	    let escaped = false;
   138	    for (; inner < body.length; inner += 1) {
   139	      const char = body[inner];
   140	      if (quote) {
   141	        if (escaped) {
   142	          escaped = false;
   143	        } else if (char === "\\") {
   144	          escaped = true;
   145	        } else if (char === quote) {
   146	          quote = "";
   147	        }
   148	      } else if (char === "\"" || char === "'") {
   149	        quote = char;
   150	      } else if (char === "{") {
   151	        depth += 1;
   152	      } else if (char === "}") {
   153	        depth -= 1;
   154	        if (!depth) break;
   155	      }
   156	    }
   157	    const choices = templateChoices(body.slice(exprStart + 2, inner));
   158	    parts = parts.flatMap((part) => choices.map((choice) => part + choice));
   159	    cursor = inner + 1;
   160	  }
   161	  return parts;
   162	}
