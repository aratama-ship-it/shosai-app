   243	  assert.deepEqual(duplicates, []);
   244	
   245	  const shadowed = [];
   246	  SAY.forEach(([pattern], index) => {
   247	    const sample = sampleForPattern(pattern);
   248	    const blocker = SAY.findIndex(([earlier], earlierIndex) => earlierIndex < index && earlier.test(sample));
   249	    if (blocker !== -1) {
   250	      shadowed.push(`${pattern} is shadowed by ${SAY[blocker][0]} for ${sample}`);
   251	    }
   252	  });
   253	  assert.deepEqual(shadowed, []);
   254	});

