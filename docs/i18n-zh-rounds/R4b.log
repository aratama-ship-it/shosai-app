    48	function extractAnnounceArguments(source) {
    49	  const args = [];
    50	  let index = 0;
    51	  while ((index = source.indexOf("announce(", index)) !== -1) {
    52	    let cursor = index + "announce(".length;
    53	    let depth = 1;
    54	    let quote = "";
    55	    let escaped = false;
    56	    let templateDepth = 0;
    57	    const start = cursor;
    58	    for (; cursor < source.length; cursor += 1) {
    59	      const char = source[cursor];
    60	      if (quote) {
    61	        if (escaped) {
    62	          escaped = false;
    63	        } else if (char === "\\") {
    64	          escaped = true;
    65	        } else if (quote === "`" && char === "$" && source[cursor + 1] === "{") {
    66	          templateDepth += 1;
    67	          cursor += 1;
    68	        } else if (quote === "`" && templateDepth && char === "}") {
    69	          templateDepth -= 1;
    70	        } else if (char === quote && (!templateDepth || quote !== "`")) {
    71	          quote = "";
    72	        }
    73	        continue;
    74	      }
    75	      if (char === "\"" || char === "'" || char === "`") {
    76	        quote = char;
    77	      } else if (char === "(") {
    78	        depth += 1;
    79	      } else if (char === ")") {
    80	        depth -= 1;
    81	        if (!depth) break;
    82	      }
    83	    }
    84	    args.push(source.slice(start, cursor).trim());
    85	    index = cursor + 1;
    86	  }
    87	  return args;
    88	}
