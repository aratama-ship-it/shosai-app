      19:
        source: '^(\\d+)件のうち(\\d+)件を取り込みました。残り(\\d+)件は件数上限のため取り込んでいません。$'
        flags: ''
        replacement: '已匯入$1個中的$2個。其餘$3個因數量上限未匯入。'
