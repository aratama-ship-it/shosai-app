    say:
      0:
        source: '^いま操作中: (.+)$'
        flags: ''
        replacement: '正在操作：$1'
      1:
        source: '^切断しました。3秒後に再接続します（(\\d+)\\/(\\d+)）。$'
        flags: ''
        replacement: '已断开。3秒后重新连接（$1/$2）…'
      2:
        source: '^セッションを開始できませんでした（(.+)）。$'
        flags: ''
        replacement: '会话未能开始（$1）。'
      3:
        source: '^間口 だいたい([\\d.]+)m ・ 奥行 だいたい([\\d.]+)m$'
        flags: ''
        replacement: '台口约$1米・进深约$2米'
      4:
        source: '^天井まで だいたい(.+?)(（天井高を超える見込み）)?$'
        flags: ''
        replacement: '(m, amount, over) => `到天花板约${amount}${over ? "（预计超过天花板高度）" : ""}`'
      5:
        source: '^辺 (\\d+) の観客 ・ 深さ だいたい([\\d.]+)m$'
        flags: ''
        replacement: '第$1条边的观众・深约$2米'
      6:
        source: '^角を移動中 ・ 間口 だいたい([\\d.]+)m ・ 奥行 だいたい([\\d.]+)m$'
        flags: ''
        replacement: '正在移动角・台口约$1米・进深约$2米'
      7:
        source: '^辺 だいたい([\\d.]+)m ・ 間口 だいたい([\\d.]+)m ・ 奥行 だいたい([\\d.]+)m$'
        flags: ''
        replacement: '边约$1米・台口约$2米・进深约$3米'
