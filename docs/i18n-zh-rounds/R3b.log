    "仕事": "任务",
    "アプリ": "应用",
    [/^(.+)を舞台セットから外しました。$/, "已把“$1”从装置列表移除。"],
    [/^(.+)を名簿から外しました。$/, "已把“$1”从名册移除。"],
    [/^(.+)を舞台へ出しました。$/, "已让“$1”登台。"],
