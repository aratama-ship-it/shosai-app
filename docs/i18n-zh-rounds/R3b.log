    [/^平面を上にしました。$/, "已把平面圖放到上面。"],

    // 名前・数入り（具体的な枠から先に）
    [/^せりの縁をまたぐものがあります: (.+)（上がると落ちます）$/,
      "有物件跨在升降台邊緣上：$1（升起時會跌落）"],
    [/^せりを置きました。錠を掛けました（せりの位置は動きません）。動かすには一覧の🔒を外します。$/,
      "已放置升降台並上鎖（其位置不會移動）。要移動請在清單中解開🔒。"],
    [/^(.+)を複製しました。前のシーンから少しずつ動かすときに使えます。$/, "已建立「$1」的副本。適合從上一場起一點點挪動。"],
    [/^(.+)として複製しました。元の版は書き出したファイルの中に残ります。$/, "已複製為「$1」。原版本仍保留在已匯出的檔案中。"],
    [/^(.+)を足しました。下のシーンを一段内側へ入れると、中身になります。$/, "已新增「$1」。把下方場景內移一層即可放入其中。"],
    [/^(.+)を名簿へ加え、このシーンの舞台へ出しました。$/, "已把「$1」加入名冊，並在本場登台。"],
    [/^(.+)を舞台セットへ加え、このシーンの舞台へ出しました。$/, "已把「$1」加入佈景裝置，並在本場登台。"],
    [/^形を(.+)にしました。寸法は基準値に戻しています。$/,
      "已把形狀改為$1。尺寸已恢復為基準值。"],
    [/^(.+)を(.+)に持たせました。$/, "已把「$1」交給$2。"],
    [/^(.+)を手放しました。$/, "已放開「$1」。"],
    [/^(.+)を(.+)へ加えてONにしました。$/, "已把「$1」加入為$2並開啟。"],
    [/^(.+)はこのシーンではOFFです。「OFF」を押すと点きます。$/, "「$1」在本場是關閉的。按「關」即可點亮。"],
    [/^(.+)はいま舞台裏です。「舞台裏」を押すと舞台へ出ます。$/, "「$1」現在在後台。按「後台」即可登台。"],
    [/^(.+)には錠が掛かっています。動かすには錠を外してください。$/, "「$1」已鎖定。要移動請先解鎖。"],
    [/^(.+)には錠が掛かっています。$/, "「$1」已鎖定。"],
    [/^(.+)に錠を掛けました。$/, "已鎖定「$1」。"],
    [/^(.+)の錠を外しました。$/, "已解鎖「$1」。"],
    [/^(.+)から見た絵に切り替えました。配置は変わりません。$/, "已切換到從$1看的畫面。位置沒有變化。"],
    [/^(.+)へ切り替えました。配置はそのまま残ります。$/, "已切換到$1。配置保持不變。"],
    [/^(.+)には背景の壁がありません。奥も客席です。$/, "$1沒有背景牆——上舞台側也是觀眾席。"],
    [/^(.+)の寸法に戻しました。$/, "已恢復為$1的預設尺寸。"],
    [/^規模を(.+)にしました。$/, "規模已設為$1。"],
    [/^姿勢を「(.+)」にしました。$/, "姿勢已設為「$1」。"],
    [/^(.+)として(\d+)点を残しました。$/, "已把$2件儲存為「$1」。"],
    [/^(.+)の(\d+)点を置き換えました。$/, "已用「$1」的$2件取代目前配置。"],
    [/^(.+)の(\d+)点を足しました。$/, "已加入「$1」的$2件。"],
    [/^(.+)を上書きしました。$/, "已覆寫「$1」。"],
    [/^(\d+)名（点）を動線の先へ動かしたシーンを作りました。$/, "已產生把$1個成員（件）移到走位線終點的場景。"],
    [/^(\d+)枚を書き出しました。$/, "已匯出$1張圖。"],
    [/^(.+)（(.+)）を読み込みました。$/, "已匯入「$1」（$2）。"],
    [/^(.+)を左の列へ移しました。$/, "已把「$1」移到左欄。"],
    [/^(.+)を右の列へ移しました。$/, "已把「$1」移到右欄。"],
    [/^(.+)を舞台から引っ込めました。$/, "已讓「$1」退到後台。"],
    [/^(.+)を舞台から下げました。$/, "已把「$1」移下舞台。"],
    [/^(.+)を舞台から外しました。$/, "已把「$1」從舞台移除。"],
    [/^(.+)を舞台セットから外しました。$/, "已把「$1」從裝置清單移除。"],
    [/^(.+)を名簿から外しました。$/, "已把「$1」從名冊移除。"],
    [/^(.+)を舞台へ出しました。$/, "已讓「$1」登台。"],
    [/^(.+)を舞台へ置きました。$/, "已把「$1」放上舞台。"],
    [/^(.+)を選びました。$/, "已選取「$1」。"],
    [/^(.+)を開きました。$/, "已開啟「$1」。"],
    [/^(.+)を足しました。$/, "已新增「$1」。"],
    [/^(.+)を消しました。$/, "已移除「$1」。"],
    [/^(.+)を削除しました。$/, "已刪除「$1」。"],
    [/^(.+)を複製しました。$/, "已建立「$1」的副本。"],
    [/^(.+)を吊物にしました。$/, "「$1」已改為懸吊。"],
    [/^(.+)を床置きに戻しました。$/, "「$1」已放回地面。"],
    [/^(.+)をフレーム（穴の空いた壁）にしました。$/, "「$1」已改為框（開洞的景片）。"],
    [/^(.+)を壁にしました。$/, "「$1」已改為整面景片。"],
    [/^(.+)をONにしました。$/, "已開啟「$1」。"],
    [/^(.+)をOFFにしました。$/, "已關閉「$1」。"],
    [/^(.+)には映す面がありません。奥も客席です。$/, "$1沒有可投影的面。上舞台側也是觀眾席。"],
    [/^(.+)を組みました（明かり(\d+)個）。個々の明かりはあとから自由に動かせます。$/, "已組好$1（共$2盞）。每盞燈之後都可自由移動。"],
    [/^(.+)（(.+)）を読み込み、ショー一覧へ保存しました。$/, "已讀取「$1」（$2）並儲存到演出清單。"],
    // 広い網は最後
    [/^(.+)を(.+)にしました。$/, "已把「$1」設為$2。"],
  ];

  /* 生成名（実装時に stage-sketch.js の sceneTitle / untitledShow を表引きへ） */
  const GENERATED = {
    sceneTitle: "場景 {n}",
    untitledShow: "未命名演出",
  };

  /* ネイティブ確認までピッチ・公開に使い切らない鍵 */
  const NEEDS_REVIEW = [
    "maps.setKind.cyrwheel",    // Cyr輪／大環——台湾サーカス界での通りを確認
    "maps.setKind.teeter",      // 蹺蹺板（韓式跳板）——現場の呼び方確認
    "maps.setKind.pole",        // 中國竿／爬竿——台湾での通り
    "maps.setKind.tissue",      // 綢吊 vs 空中絲帶——台湾での通り
    "maps.setKind.deck",        // 活動平台——「車台」が通じるかを含め確認
    "maps.lightKind.floor",     // 地面側光——台湾の現場語（rasant相当）確認
    "maps.pose.skate",          // 輪式溜冰鞋の据わり
    "text.プレゼン",             // 放映／簡報——どちらが自然か（現ドラフトは放映）
    "text.共有セッション",        // 連線共享／共享連線の語順と据わり
    "text.バミリ図（印刷）",      // 定位標記圖——現場ではmarkとも
    "text.このアプリについての各段落", // 開発者の言葉。トーンの本人確認
    "generated.untitledShow",   // 未命名演出で自然か
  ];

  window.SHOSAI_I18N_DRAFT_ZH_HANT = { text: TEXT, maps: MAPS, say: SAY, generated: GENERATED, needsReview: NEEDS_REVIEW };
})();

