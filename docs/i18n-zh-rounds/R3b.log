    say:
      0:
        source: '^いま操作中: (.+)$'
        flags: ''
        replacement: '正在操作：$1'
      1:
        source: '^切断しました。3秒後に再接続します（(\\d+)\\/(\\d+)）。$'
        flags: ''
        replacement: '已斷線。3秒後重新連線（$1/$2）…'
      2:
        source: '^セッションを開始できませんでした（(.+)）。$'
        flags: ''
        replacement: '共享連線未能開始（$1）。'
      3:
        source: '^間口 だいたい([\\d.]+)m ・ 奥行 だいたい([\\d.]+)m$'
        flags: ''
        replacement: '開口約$1米・深約$2米'
      4:
        source: '^天井まで だいたい(.+?)(（天井高を超える見込み）)?$'
        flags: ''
        replacement: '(m, amount, over) => `到天花板約${amount}${over ? "（預計超過天花板高度）" : ""}`'
      5:
        source: '^辺 (\\d+) の観客 ・ 深さ だいたい([\\d.]+)m$'
        flags: ''
        replacement: '第$1條邊的觀眾・深約$2米'
      6:
        source: '^角を移動中 ・ 間口 だいたい([\\d.]+)m ・ 奥行 だいたい([\\d.]+)m$'
        flags: ''
        replacement: '正在移動角・開口約$1米・深約$2米'
      7:
        source: '^辺 だいたい([\\d.]+)m ・ 間口 だいたい([\\d.]+)m ・ 奥行 だいたい([\\d.]+)m$'
        flags: ''
        replacement: '邊約$1米・開口約$2米・深約$3米'
      8:
        source: '^観客の帯の深さ だいたい([\\d.]+)m$'
        flags: ''
        replacement: '觀眾帶深約$1米'
      9:
        source: '^このファイルは大きすぎます（([\\d.]+)MB）。会場ライブラリは2MBまでです。$'
        flags: ''
        replacement: '檔案太大（$1MB）。場地庫上限為2MB。'
      10:
        source: '^会場ライブラリのJSONを読み込めませんでした。$'
        flags: ''
        replacement: '無法讀取場地庫的JSON。'
      11:
        source: '^会場ライブラリのファイルを読み込めませんでした。$'
        flags: ''
        replacement: '無法讀取場地庫檔案。'
      12:
        source: '^会場ライブラリの形式ではありません。$'
        flags: ''
        replacement: '這不是場地庫格式的檔案。'
      13:
        source: '^取り込める会場が(\\d+)件あります。$'
        flags: ''
        replacement: '可匯入的場地有$1個。'
      14:
        source: '^取り込めない会場が(\\d+)件あります。$'
        flags: ''
        replacement: '無法匯入的場地有$1個。'
      15:
        source: '^取り込めない会場が(\\d+)件ありました。取り込めるvenue-v2会場はありません。$'
        flags: ''
        replacement: '有$1個場地無法匯入。沒有可匯入的venue-v2場地。'
      16:
        source: '^全(\\d+)件のうち先頭200件を確認します。残り(\\d+)件は取り込みません。$'
        flags: ''
        replacement: '將確認全部$1個中的前200個。其餘$2個不匯入。'
