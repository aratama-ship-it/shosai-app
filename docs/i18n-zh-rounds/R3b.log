  <div class="stage-modal-body">
   <!-- 左に設定、右にショートカット一覧。二列にするため、左側は一枚にまとめる -->
   <div class="stage-prefs-main">
    <p class="stage-profile-hint">この端末だけの設定です。ショーのデータには入らず、書き出しや共有にも混ざりません。</p>
    <!-- 言語は歯車の中へ。上部は道具の列なので、めったに触らないものは置かない。
         その中では一番上に置く——読める言葉になっていないと、下の項目名が読めない。 -->
    <div class="stage-pref-row stage-pref-lang-row">
      <span class="stage-pref-lang-body">
        <span class="stage-pref-name">言語 / Language</span>
        <p class="stage-pref-hint">画面の文字を日本語と英語で切り替えます。</p>
      </span>
      <button type="button" class="stage-lang" id="stage-lang" aria-pressed="false"
              title="日本語 / English">EN</button>
    </div>
    <!-- 使い方まわりは5つある。全部並べると設定の主目的（機能のオン/オフ）が
         押し出されるので、畳んでおく。言語のすぐ下＝読める言葉になった直後に置く。 -->
    <details class="stage-pref-guide" id="stage-pref-guide">
      <summary class="stage-pref-guide-summary">
        <span class="stage-pref-name">使い方</span>
        <p class="stage-pref-hint">案内・検索・冊子・感想の送り先をまとめています。</p>
      </summary>
      <div class="stage-prefs-links" aria-label="案内とサポート">
     腿・ふくらはぎ・前腕のふくらみを持たせる。ここが無いと棒に見える。 */
  const LIMB_TAPER = {
    // 腿の付け根 → 腿の中 → 膝 → ふくらはぎ → 足首
    leg: [0.052, 0.054, 0.033, 0.036, 0.020],
    // 肩 → 上腕の中 → 肘 → 前腕の太い所 → 手首
    // ★肩の値を小さくするのは、丸が肩関節を中心に描かれ、肩の線より上へ肉がはみ出して
    //   尖った肩当てになるため。三角筋の張りは TORSO_RINGS の t=0 と上腕の中が持つ。
    arm: [0.010, 0.030, 0.026, 0.022, 0.0132],
  };
  // 節の間に挟む中間点の位置（0=手前の関節、1=先の関節）
  const LIMB_MIDS = { leg: [0.45, 0.35], arm: [0.5, 0.35] };
  const HAND_LEN = 0.062;      // 手首から指先まで
  const HAND_R = 0.019;
  const FOOT_R = 0.021;        // 足の甲の厚み
  const HEEL_BACK = 0.030;     // 踵がくるぶしより後ろへ出る量
  const TOOL_HINTS = {
    select: "演者や物を選び、舞台の上で動かします。",
    paint: "奥の背景面を指やマウスで塗ります。",
    erase: "背景に描いた線だけを消します。",
    arrow: "正面図または平面図をなぞると矢印になります。正面図では床の上か空中かを選べます。Alt（option）を押しながらクリックすると、近い矢印を1本消せます。",
    route: "平面図で演者や物、明かりを掴み、離した所が行き先になります。真ん中の丸を引くと動線が曲がります。",
    note: "何もない所を押すとメモを貼れます。貼ったメモは掴んで動かせます。",
    light: "照明だけを動かします。丸い印が灯体、明るい輪が当たる場所です。",
  };

  const els = {
    undo: document.getElementById("stage-undo"),
    redo: document.getElementById("stage-redo"),
    export: document.getElementById("stage-export"),
    lang: document.getElementById("stage-lang"),
    tour: document.getElementById("stage-tour"),
