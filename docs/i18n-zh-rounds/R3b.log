    [/^暗転で始まるシーンにしました。$/, "本场景已改为以暗场开始。"],
    [/^暗転をやめました。$/, "已取消暗场。"],
    [/^「(.+)」をスクリーンへ映しました。絵の上で掴んで動かせます。$/,
      "已把“$1”投映到屏幕上。可以在画面上按住拖动。"],
    [/^映す言葉を入れてください。$/, "请输入要投映的文字。"],
    [/^名簿から(\d+)人をキャストへ加えました（(.+)）。舞台へ出すには一覧の「舞台裏」を押してください。$/,
      "已从名册把$1人加入演员表（$2）。要让TA登台，请在列表中按“后台”。"],
    [/^背景の塗りは正面図で行います。正面を開いてください。$/, "背景在正视图中涂画。请打开正视图。"],
    [/^背景の塗りは正面図で行います。$/, "背景在正视图中涂画。"],
    [/^背景の塗りを消しました。$/, "已清除背景涂色。"],
    [/^背景に写真を貼りました。$/, "已把照片设为背景。"],
    [/^背景の写真を外しました。$/, "已移除背景照片。"],
    [/^この画像は大きすぎます。もう少し小さいものを選んでください。$/, "图片太大。请选择小一些的。"],
    [/^この画像は読み込めませんでした。$/, "无法读取这张图片。"],
    [/^背景の枠内から塗り始めてください。$/, "请从背景框内开始涂画。"],
    [/^舞台に装置がありません。$/, "舞台上没有装置。"],
    [/^舞台を空にしました。$/, "已清空舞台。"],
    [/^読み込めませんでした。書き出したJSONファイルを選んでください。$/, "无法导入。请选择从这里导出的JSON文件。"],
    [/^最後のシーンです。$/, "已是最后一场。"],
    [/^最初のシーンです。$/, "已是第一场。"],
    [/^演者名を出しました。$/, "已显示演员名。"],
    [/^演者名を隠しました。$/, "已隐藏演员名。"],
    [/^装置名を出しました。$/, "已显示装置名。"],
    [/^装置名を隠しました。$/, "已隐藏装置名。"],
    [/^照明名を出しました。$/, "已显示灯光名。"],
    [/^照明名を隠しました。$/, "已隐藏灯光名。"],
    [/^見る位置の図を出しました。$/, "已显示观看位置图。"],
    [/^見る位置の図を隠しました。$/, "已隐藏观看位置图。"],
    [/^アニメーションを入れました。$/, "已开启动画。"],
    [/^アニメーションを切りました。$/, "已关闭动画。"],
    [/^平面にも吊物を出します。$/, "平面图中也显示悬吊物。"],
    [/^正面の照明を点けました。$/, "已点亮正视图的灯光。"],
    [/^正面の照明を消しました。$/, "已熄灭正视图的灯光。"],
    [/^平面の照明を出しました。$/, "已在平面图中显示灯光。"],
    [/^平面の照明を隠しました。$/, "已在平面图中隐藏灯光。"],
    [/^動線を出しました。$/, "已显示走位线。"],
    [/^動線を隠しました。引いた線は消えていません。$/, "已隐藏走位线。画好的线并未删除。"],
    [/^演者の動線を出しました。$/, "已显示演员走位线。"],
    [/^演者の動線を隠しました。引いた線は消えていません。$/, "已隐藏演员走位线。画好的线并未删除。"],
    [/^照明の動線を出しました。$/, "已显示灯光走位线。"],
    [/^照明の動線を隠しました。引いた線は消えていません。$/, "已隐藏灯光走位线。画好的线并未删除。"],
    [/^装置の動線を出しました。$/, "已显示装置走位线。"],
    [/^装置の動線を隠しました。引いた線は消えていません。$/, "已隐藏装置走位线。画好的线并未删除。"],
    [/^組をばらしました。それぞれ普通の明かりとして動かせます。$/,
      "已拆开灯组。每盏灯都可作为普通的灯单独移动。"],
    [/^両手がふさがっています。$/, "两只手都占着。"],
    [/^(.+)（(\d+)灯）をONにしました。$/, "已开启$1（$2盏）。"],
    [/^(.+)（(\d+)灯）をOFFにしました。$/, "已关闭$1（$2盏）。"],
    [/^平面では吊物を隠します。$/, "平面图中隐藏悬吊物。"],
    [/^正面を開きました。$/, "已打开正视图。"],
    [/^正面を閉じました。$/, "已收起正视图。"],
    [/^平面を開きました。$/, "已打开平面图。"],
    [/^平面を閉じました。$/, "已收起平面图。"],
    [/^正面を上にしました。$/, "已把正视图放到上面。"],
    [/^平面を上にしました。$/, "已把平面图放到上面。"],

    // 名前・数入り（具体的な枠から先に）
    [/^せりの縁をまたぐものがあります: (.+)（上がると落ちます）$/,
      "有物件跨在升降台边缘上：$1（升起时会跌落）"],
    [/^せりを置きました。錠を掛けました（せりの位置は動きません）。動かすには一覧の🔒を外します。$/,
      "已放置升降台并上锁（其位置不会移动）。要移动请在列表中解开🔒。"],
    [/^(.+)を複製しました。前のシーンから少しずつ動かすときに使えます。$/, "已创建“$1”的副本。适合从上一场起一点点挪动。"],
    [/^(.+)として複製しました。元の版は書き出したファイルの中に残ります。$/, "已复制为“$1”。原版本仍保留在已导出的文件中。"],
    [/^(.+)を足しました。下のシーンを一段内側へ入れると、中身になります。$/, "已添加“$1”。把下方场景内移一级即可放入其中。"],
    [/^(.+)を名簿へ加え、このシーンの舞台へ出しました。$/, "已把“$1”加入名册，并让其在本场登台。"],
    [/^(.+)を舞台セットへ加え、このシーンの舞台へ出しました。$/, "已把“$1”加入布景装置，并在本场登台。"],
    [/^形を(.+)にしました。寸法は基準値に戻しています。$/,
      "已把形状改为$1。尺寸已恢复为基准值。"],
    [/^(.+)を(.+)に持たせました。$/, "已把“$1”交给$2。"],
    [/^(.+)を手放しました。$/, "已放开“$1”。"],
    [/^(.+)を(.+)へ加えてONにしました。$/, "已把“$1”添加为$2并开启。"],
    [/^(.+)はこのシーンではOFFです。「OFF」を押すと点きます。$/, "“$1”在本场是关闭的。按“关”即可点亮。"],
    [/^(.+)はいま舞台裏です。「舞台裏」を押すと舞台へ出ます。$/, "“$1”现在在后台。按“后台”即可登台。"],
    [/^(.+)には錠が掛かっています。動かすには錠を外してください。$/, "“$1”已锁定。要移动请先解锁。"],
    [/^(.+)には錠が掛かっています。$/, "“$1”已锁定。"],
    [/^(.+)に錠を掛けました。$/, "已锁定“$1”。"],
    [/^(.+)の錠を外しました。$/, "已解锁“$1”。"],
    [/^(.+)から見た絵に切り替えました。配置は変わりません。$/, "已切换到从$1看的画面。位置没有变化。"],
    [/^(.+)へ切り替えました。配置はそのまま残ります。$/, "已切换到$1。布局保持不变。"],
    [/^(.+)には背景の壁がありません。奥も客席です。$/, "$1没有背景墙——后区也是观众席。"],
    [/^(.+)の寸法に戻しました。$/, "已恢复为$1的预设尺寸。"],
    [/^規模を(.+)にしました。$/, "规模已设为$1。"],
    [/^姿勢を「(.+)」にしました。$/, "姿势已设为“$1”。"],
    [/^(.+)として(\d+)点を残しました。$/, "已把$2件保存为“$1”。"],
    [/^(.+)の(\d+)点を置き換えました。$/, "已用“$1”的$2件替换当前布局。"],
    [/^(.+)の(\d+)点を足しました。$/, "已添加“$1”的$2件。"],
    [/^(.+)を上書きしました。$/, "已覆盖“$1”。"],
    [/^(\d+)名（点）を動線の先へ動かしたシーンを作りました。$/, "已生成把$1个成员（件）移到走位线终点的场景。"],
    [/^(\d+)枚を書き出しました。$/, "已导出$1张图。"],
    [/^(.+)（(.+)）を読み込みました。$/, "已导入“$1”（$2）。"],
    [/^(.+)を左の列へ移しました。$/, "已把“$1”移到左栏。"],
    [/^(.+)を右の列へ移しました。$/, "已把“$1”移到右栏。"],
    [/^(.+)を舞台から引っ込めました。$/, "已让“$1”退到后台。"],
    [/^(.+)を舞台から下げました。$/, "已把“$1”撤下舞台。"],
    [/^(.+)を舞台から外しました。$/, "已把“$1”从舞台移除。"],
    [/^(.+)を舞台セットから外しました。$/, "已把“$1”从装置列表移除。"],
    [/^(.+)を名簿から外しました。$/, "已把“$1”从名册移除。"],
    [/^(.+)を舞台へ出しました。$/, "已让“$1”登台。"],
    [/^(.+)を舞台へ置きました。$/, "已把“$1”放上舞台。"],
    [/^(.+)を選びました。$/, "已选中“$1”。"],
    [/^(.+)を開きました。$/, "已打开“$1”。"],
    [/^(.+)を足しました。$/, "已添加“$1”。"],
    [/^(.+)を消しました。$/, "已移除“$1”。"],
    [/^(.+)を削除しました。$/, "已删除“$1”。"],
    [/^(.+)を複製しました。$/, "已创建“$1”的副本。"],
    [/^(.+)を吊物にしました。$/, "“$1”已改为悬吊。"],
    [/^(.+)を床置きに戻しました。$/, "“$1”已放回地面。"],
    [/^(.+)をフレーム（穴の空いた壁）にしました。$/, "“$1”已改为框（开洞的景片）。"],
    [/^(.+)を壁にしました。$/, "“$1”已改为整面景片。"],
    [/^(.+)をONにしました。$/, "已开启“$1”。"],
    [/^(.+)をOFFにしました。$/, "已关闭“$1”。"],
    [/^(.+)には映す面がありません。奥も客席です。$/, "$1没有可投映的面。后区也是观众席。"],
    [/^(.+)を組みました（明かり(\d+)個）。個々の明かりはあとから自由に動かせます。$/, "已布好$1（共$2盏）。每盏灯之后都可自由移动。"],
    [/^(.+)（(.+)）を読み込み、ショー一覧へ保存しました。$/, "已读取“$1”（$2）并保存到演出列表。"],
    // 広い網は最後
    [/^(.+)を(.+)にしました。$/, "已把“$1”设为$2。"],
  ];

  /* 生成名（実装時に stage-sketch.js の sceneTitle / untitledShow を表引きへ） */
  const GENERATED = {
    sceneTitle: "场景 {n}",
    untitledShow: "未命名演出",
  };

  /* ネイティブ確認までピッチ・公開に使い切らない鍵 */
  const NEEDS_REVIEW = [
    "maps.setKind.cyrwheel",   // Cyr轮／大环——中華圏で定訳未満（既存プロンプト側と同じ懸念）
    "maps.setKind.teeter",     // 跷板／弹板／跳板のどれが通るか
    "maps.setKind.block",      // 「平台・台箱」——箱馬相当の現場語が未確認
    "maps.setKind.cane",       // 手倒立杆——頂技の現場語要確認
    "text.ライトカーテン",       // 光幕の通用度
    "text.トップサス（1人分）",   // 定点顶光の据わり
    "text.バミリ図（印刷）",     // 定位标记图——現場の言い方確認
    "maps.pose.windmill",      // ブレイキン文脈での呼称（既存プロンプト側と同じ懸念）
    "text.このアプリについての各段落", // 開発者の言葉。トーンの本人確認
    "generated.untitledShow",  // 未命名演出で自然か
  ];

  window.SHOSAI_I18N_DRAFT_ZH_HANS = { text: TEXT, maps: MAPS, say: SAY, generated: GENERATED, needsReview: NEEDS_REVIEW };
})();

