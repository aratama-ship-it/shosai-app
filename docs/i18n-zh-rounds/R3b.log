+    const keys = [...source.slice(textStart, textEnd).matchAll(/^\s*"((?:\\.|[^"])*)"\s*:/gm)]
+      .map((match) => JSON.parse(`"${match[1]}"`));
+    assert.deepEqual(keys.filter((key, index) => keys.indexOf(key) !== index), []);
+  });
