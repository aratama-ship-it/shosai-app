  const GENERATED = {
    sceneTitle: "场景 {n}",
    untitledShow: "未命名演出",
  };

  /* ネイティブ確認までピッチ・公開に使い切らない鍵 */
  const NEEDS_REVIEW = [
    "maps.setKind.cyrwheel",   // Cyr轮／大环——中華圏で定訳未満（既存プロンプト側と同じ懸念）
    "maps.setKind.teeter",     // 跷板／弹板／跳板のどれが通るか
    "maps.setKind.block",      // 「平台・台箱」——箱馬相当の現場語が未確認
    "maps.setKind.cane",       // 手倒立杆——頂技の現場語要確認
    "text.ライトカーテン",       // 光幕の通用度
    "text.トップサス（1人分）",   // 定点顶光の据わり
