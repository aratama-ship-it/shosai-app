+    [/^(.+)を削除しました。$/, "已删除“$1”。"],
+    [/^(.+)を複製しました。$/, "已创建“$1”的副本。"],
+    [/^(.+)を吊物にしました。$/, "“$1”已改为悬吊。"],
+    [/^(.+)を床置きに戻しました。$/, "“$1”已放回地面。"],
+    [/^(.+)をフレーム（穴の空いた壁）にしました。$/, "“$1”已改为框（开洞的景片）。"],
+    [/^(.+)を壁にしました。$/, "“$1”已改为整面景片。"],
+    [/^(.+)をONにしました。$/, "已开启“$1”。"],
+    [/^(.+)をOFFにしました。$/, "已关闭“$1”。"],
+    [/^(.+)には映す面がありません。奥も客席です。$/, "$1没有可投映的面。后区也是观众席。"],
+    [/^(.+)を組みました（明かり(\d+)個）。個々の明かりはあとから自由に動かせます。$/, "已布好$1（共$2盏）。每盏灯之后都可自由移动。"],
+    [/^(.+)（(.+)）を読み込み、ショー一覧へ保存しました。$/, "已读取“$1”（$2）并保存到演出列表。"],
+    // 広い網は最後
+    [/^(.+)を(.+)にしました。$/, "已把“$1”设为$2。"],
+  ];
+
+  /* 生成名（実装時に stage-sketch.js の sceneTitle / untitledShow を表引きへ） */
+  const GENERATED = {
+    sceneTitle: "场景 {n}",
+    untitledShow: "未命名演出",
+  };
+
+  /* ネイティブ確認までピッチ・公開に使い切らない鍵 */
+  const NEEDS_REVIEW = [
+    "maps.setKind.cyrwheel",   // Cyr轮／大环——中華圏で定訳未満（既存プロンプト側と同じ懸念）
+    "maps.setKind.teeter",     // 跷板／弹板／跳板のどれが通るか
+    "maps.setKind.block",      // 「平台・台箱」——箱馬相当の現場語が未確認
+    "maps.setKind.cane",       // 手倒立杆——頂技の現場語要確認
+    "text.ライトカーテン",       // 光幕の通用度
+    "text.トップサス（1人分）",   // 定点顶光の据わり
+    "text.バミリ図（印刷）",     // 定位标记图——現場の言い方確認
+    "maps.pose.windmill",      // ブレイキン文脈での呼称（既存プロンプト側と同じ懸念）
+    "text.このアプリについての各段落", // 開発者の言葉。トーンの本人確認
+    "generated.untitledShow",  // 未命名演出で自然か
+  ];
+
+  window.SHOSAI_I18N_PACKS["zh-Hans"] = { text: TEXT, maps: MAPS, say: SAY, generated: GENERATED, needsReview: NEEDS_REVIEW };
+})();
