             正面図は舞台の枠までのまま。 */
          const b = planBounds();
          return {
            u: clamp((x - L.stage.x) / L.stage.w, b.uMin, b.uMax),
            v: clamp((y - L.stage.y) / L.stage.h, b.vMin, b.vMax),
