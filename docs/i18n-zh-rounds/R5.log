+        resolved,
+        "say",
+        (say) => translateStageSay(say, japanese),
+      );
+      if (resolved === "en" && english !== undefined) {
+        return translated === english ? translated : english;
+      }
+      return translated || japanese;
+    },
+    languageValue: (code, english, japanese) => stageLanguageValue(
+      code,
+      () => english,
+      () => japanese,
+    ),
+  });
