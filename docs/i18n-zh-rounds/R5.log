diff --git a//tmp/shosai-r5-browser-evidence.mjs b//tmp/shosai-r5-browser-evidence.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..3d0a719be3a05d5064e48e4b64a8832c59a8ed08
--- /dev/null
+++ b//tmp/shosai-r5-browser-evidence.mjs
@@ -0,0 +1,125 @@
+const origin = "http://127.0.0.1:18431";
+const pages = await (await fetch("http://127.0.0.1:18445/json/list")).json();
+const target = pages.find((item) => item.type === "page" && item.url === "about:blank")
+  || pages.find((item) => item.type === "page");
+if (!target) throw new Error("page target missing");
+const ws = new WebSocket(target.webSocketDebuggerUrl);
+await new Promise((resolve, reject) => { ws.onopen = resolve; ws.onerror = reject; });
+let id = 0;
+const pending = new Map();
+ws.onmessage = ({ data }) => {
+  const message = JSON.parse(data);
+  const waiter = pending.get(message.id);
+  if (!waiter) return;
+  pending.delete(message.id);
+  message.error ? waiter.reject(new Error(JSON.stringify(message.error))) : waiter.resolve(message.result);
+};
+const send = (method, params = {}) => new Promise((resolve, reject) => {
+  const callId = ++id;
+  pending.set(callId, { resolve, reject });
+  ws.send(JSON.stringify({ id: callId, method, params }));
+});
+const evaluate = async (expression) => (await send("Runtime.evaluate", {
+  expression,
+  returnByValue: true,
+  awaitPromise: true,
+})).result.value;
+const settle = async () => {
+  for (let attempt = 0; attempt < 200; attempt += 1) {
+    if (await evaluate("document.readyState") === "complete") break;
+    await new Promise((resolve) => setTimeout(resolve, 25));
+  }
+  await new Promise((resolve) => setTimeout(resolve, 500));
+};
+const navigateFresh = async (url) => {
+  await send("Page.navigate", { url });
+  await settle();
+  await evaluate("localStorage.clear(); true");
+  await send("Page.reload", { ignoreCache: true });
+  await settle();
+  await evaluate("document.getElementById('stage-tour-close')?.click(); true");
+};
+const collectKana = `(() => {
+  const roots = [document.querySelector('#view-stage'), ...[...document.querySelectorAll('.stage-modal')].filter((node) => !node.hidden)];
+  const rows = [];
+  const seen = new Set();
+  for (const root of roots) {
+    if (!root) continue;
+    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
+    for (let node = walker.nextNode(); node; node = walker.nextNode()) {
+      const parent = node.parentElement;
+      if (!parent || parent.closest('[data-no-i18n], input, textarea, [contenteditable="true"]')) continue;
+      if (!parent.getClientRects().length || getComputedStyle(parent).visibility === 'hidden') continue;
+      const matches = node.data.match(/[\\p{Script=Hiragana}\\p{Script=Katakana}]+/gu) || [];
+      for (const match of matches) {
+        const row = { match, text: parent.textContent.trim(), element: parent.tagName.toLowerCase(), id: parent.id || '' };
+        const key = JSON.stringify(row);
+        if (!seen.has(key)) rows.push(row);
+        seen.add(key);
+      }
+    }
+  }
+  return rows;
+})()`;
+
+await send("Page.enable");
+await send("Runtime.enable");
+await send("Network.enable");
+await send("Network.setCacheDisabled", { cacheDisabled: true });
+await send("Network.setBypassServiceWorker", { bypass: true });
+await send("Emulation.setDeviceMetricsOverride", { width: 1440, height: 1000, deviceScaleFactor: 1, mobile: false });
+
+const kanaResults = {};
+for (const code of ["zh-Hans", "zh-Hant"]) {
+  await navigateFresh(`${origin}/stage.html?lang=${code}#stage`);
+  for (const name of ["cast", "light", "scenes"]) {
+    await evaluate(`(() => { const panel = document.querySelector('[data-panel="${name}"]'); if (panel?.classList.contains('is-collapsed')) panel.querySelector('[data-panel-head]')?.click(); return true; })()`);
+  }
+  const states = { main: await evaluate(collectKana) };
+  for (const [state, openId, closeId] of [
+    ["scenes", "stage-scene-grid-open", "stage-scene-grid-close"],
+    ["export", "stage-export", "stage-export-close"],
+    ["settings", "stage-prefs-btn", "stage-prefs-close"],
+  ]) {
+    await evaluate(`document.getElementById(${JSON.stringify(openId)})?.click(); true`);
+    await new Promise((resolve) => setTimeout(resolve, 120));
+    states[state] = await evaluate(collectKana);
+    await evaluate(`document.getElementById(${JSON.stringify(closeId)})?.click(); true`);
+  }
+  const rows = [];
+  const seen = new Set();
+  for (const [state, values] of Object.entries(states)) {
+    for (const row of values) {
+      const key = JSON.stringify(row);
+      if (!seen.has(key)) rows.push({ state, ...row });
+      seen.add(key);
+    }
+  }
+  kanaResults[code] = { lang: await evaluate("document.documentElement.lang"), count: rows.length, rows };
+}
+
+await navigateFresh(`${origin}/stage.html?lang=zh-Hant&sample#stage`);
+await new Promise((resolve) => setTimeout(resolve, 300));
+const sample = JSON.parse(await evaluate(`JSON.stringify((() => {
+  const project = JSON.parse(window.SHOSAI_STAGE_SESSION_BRIDGE.exportDocumentString()).project;
+  const source = window.SHOSAI_STAGE_SHOW_LIBRARY.samples.find((item) => item.id === 'sample-eight-circus-v1');
+  const actualCast = project.cast.map((item) => item.name);
+  const expectedCast = source.cast.map((item) => item.nameEn || item.name);
+  const actualSets = project.sets.map((item) => item.name);
+  const expectedSets = [...source.sets, ...source.lights].map((item) => item.nameEn || item.name);
+  const actualScenes = project.scenes.map((item) => item.title);
+  const expectedScenes = source.scenes.map((item) => item.titleEn || item.title);
+  return {
+    lang: document.documentElement.lang,
+    title: project.title,
+    expectedTitle: source.titleEn || source.title,
+    cast: actualCast,
+    scenes: actualScenes,
+    castMatchesEnglish: JSON.stringify(actualCast) === JSON.stringify(expectedCast),
+    setsMatchEnglish: JSON.stringify(actualSets) === JSON.stringify(expectedSets),
+    scenesMatchEnglish: JSON.stringify(actualScenes) === JSON.stringify(expectedScenes),
+  };
+})())`));
+
+console.log(JSON.stringify({ kanaResults, sample }, null, 2));
+ws.close();
