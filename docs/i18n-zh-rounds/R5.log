+      if (!re.test(message)) continue;
+      re.lastIndex = 0;
+      return message.replace(re, translatedValue);
+    }
+    return null;
+  }
+
+  function stageTextForLanguage(code, japanese) {
+    return stagePackValueForLanguage(code, "text", (text) => text[japanese]) || japanese;
