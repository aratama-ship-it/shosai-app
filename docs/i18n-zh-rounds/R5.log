             （実際に、手足が数珠つなぎの黒い丸に見えていた）。 */
          target.moveTo(a.x + nx * ra, a.y + ny * ra);
          target.lineTo(a.x - nx * ra, a.y - ny * ra);
          target.lineTo(b.x - nx * rb, b.y - ny * rb);
          target.lineTo(b.x + nx * rb, b.y + ny * rb);
