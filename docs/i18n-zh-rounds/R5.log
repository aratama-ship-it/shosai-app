          let doc; try { doc = JSON.parse(text); } catch (_) { return false; }
          if (!doc || doc.kind !== "shosai-stage-sketch" || !doc.project) return false;
          const { project } = prepareProjectImportDocument(doc);
          const continuePlayback = Boolean(
