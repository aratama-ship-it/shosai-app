docs/i18n-zh-rounds/R1.log:14715:(async()=>{const pages=await (await fetch('http://127.0.0.1:18432/json/list')).json();const p=pages.find(x=>x.type==='page'&&x.url.includes('stage.html?lang=en'));const ws=new WebSocket(p.webSocketDebuggerUrl);await new Promise((r,j)=>{ws.onopen=r;ws.onerror=j});let id=1;const wait=new Map(),events=[];ws.onmessage=e=>{const m=JSON.parse(e.data);if(m.id&&wait.has(m.id)){const w=wait.get(m.id);wait.delete(m.id);m.error?w.j(Error(JSON.stringify(m.error))):w.r(m.result)}else events.push(m)};const send=(method,params={})=>new Promise((r,j)=>{const n=id++;wait.set(n,{r,j});ws.send(JSON.stringify({id:n,method,params}))});await send('Page.enable');await send('Network.enable');await send('Network.setCacheDisabled',{cacheDisabled:true});await send('Network.setBypassServiceWorker',{bypass:true});await send('Runtime.evaluate',{expression:'localStorage.clear()'});await send('Page.reload',{ignoreCache:true});const deadline=Date.now()+10000;while("'!events.some(e=>e.method==='"'Page.loadEventFired')&&Date.now()<deadline)await new Promise(r=>setTimeout(r,50));await new Promise(r=>setTimeout(r,500));const result=await send('Runtime.evaluate',{expression:'document.body.innerText',returnByByValue:true,returnByValue:true});const value=result.result.value,before=fs.readFileSync('/tmp/shosai-b3-before-innerText.txt','utf8');fs.writeFileSync('/tmp/shosai-b3-after-innerText.txt',value);console.log('before_bytes='+Buffer.byteLength(before),'after_bytes='+Buffer.byteLength(value));console.log('before_sha256='+crypto.createHash('sha256').update(before).digest('hex'));console.log('after_sha256='+crypto.createHash('sha256').update(value).digest('hex'));console.log('equal='+(before===value));if(before"'!==value){const a=before.split('"'\\n'),b=value.split('\\n');for(let i=0;i<Math.max(a.length,b.length);i++)if(a[i]"'!==b[i])console.log(`line ${i+1}'"\\n- "'${a[i]??'"''}\\n+ "'${b[i]??'"''}"'`);process.exitCode=1;}ws.close()})().catch(e=>{console.error(e);process.exit(1)})
