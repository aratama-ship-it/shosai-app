diff --git a/i18n-prep/NEEDS_REVIEW.md b/i18n-prep/NEEDS_REVIEW.md
index d3858a9838658176e84e4f344f63ae74a223fb61..30836cd8addd429594fca2ae9f5dea6817a0c523
