+    const entry = performance.getEntriesByType('navigation')[0];
+    return { duration: entry.duration, domContentLoaded: entry.domContentLoadedEventEnd, loadEventEnd: entry.loadEventEnd };
+  })()`);
+  const resources = await evaluate(`performance.getEntriesByType('resource').map((entry) => ({ name: entry.name, duration: entry.duration, transferSize: entry.transferSize, encodedBodySize: entry.encodedBodySize }))`);
+  return {
+    navigation,
+    transferSize: resources.reduce((sum, entry) => sum + entry.transferSize, 0),
+    zhResources: resources.filter((entry) => /stage-i18n\.zh-Han[st]\.js/.test(entry.name)),
+  };
+}
+
+const loadRuns = { baseline: [], current: [] };
+for (let run = 1; run <= 7; run += 1) {
+  loadRuns.baseline.push(await measuredLoad("index_backup_2026-09-09-before-zh.html", run));
+  loadRuns.current.push(await measuredLoad("index.html", run));
+}
+
+console.log(JSON.stringify({ languageResults, loadRuns }, null, 2));
+socket.close();
