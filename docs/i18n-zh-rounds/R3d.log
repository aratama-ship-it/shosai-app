@@ -0,0 +1,108 @@
+import { writeFile } from "node:fs/promises";
+
+const out = "/Users/arata/Library/Mobile Documents/com~apple~CloudDocs/claude code files/show-creative-ideas/shosai-app/docs/i18n-zh-2026-09";
+const pages = await (await fetch("http://127.0.0.1:18444/json/list")).json();
+const target = pages.find((item) => item.type === "page");
+if (!target) throw new Error("page target missing");
+const ws = new WebSocket(target.webSocketDebuggerUrl);
+await new Promise((resolve, reject) => { ws.onopen = resolve; ws.onerror = reject; });
+let id = 0;
+const pending = new Map();
+ws.onmessage = (event) => {
+  const message = JSON.parse(event.data);
+  if (!message.id || !pending.has(message.id)) return;
+  const waiter = pending.get(message.id);
+  pending.delete(message.id);
+  message.error ? waiter.reject(new Error(JSON.stringify(message.error))) : waiter.resolve(message.result);
+};
+const send = (method, params = {}) => new Promise((resolve, reject) => {
+  const current = ++id;
+  pending.set(current, { resolve, reject });
+  ws.send(JSON.stringify({ id: current, method, params }));
+});
+const evaluate = async (expression) => (await send("Runtime.evaluate", {
+  expression,
+  returnByValue: true,
+  awaitPromise: true,
+})).result.value;
+const settle = async () => {
+  for (let attempt = 0; attempt < 200; attempt += 1) {
+    if (await evaluate("document.readyState") === "complete") break;
+    await new Promise((resolve) => setTimeout(resolve, 25));
+  }
+  await new Promise((resolve) => setTimeout(resolve, 400));
+};
+const shot = async (name) => {
+  const png = await send("Page.captureScreenshot", { format: "png", fromSurface: true });
+  await writeFile(`${out}/${name}`, Buffer.from(png.data, "base64"));
+};
+const collect = `(() => {
+  const roots = [document.querySelector('#view-stage'), ...[...document.querySelectorAll('.stage-modal')].filter((node) => !node.hidden)];
+  const rows = [];
+  const seen = new Set();
+  for (const root of roots) {
+    if (!root) continue;
+    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
+    for (let node = walker.nextNode(); node; node = walker.nextNode()) {
+      const parent = node.parentElement;
+      if (!parent || parent.closest('[data-no-i18n], input, textarea, [contenteditable="true"]')) continue;
+      if (!parent.getClientRects().length || getComputedStyle(parent).visibility === 'hidden') continue;
+      const matches = node.data.match(/[\u3040-\u30ff]+/g) || [];
+      for (const match of matches) {
+        const row = { match, text: parent.textContent.trim(), element: parent.tagName.toLowerCase(), id: parent.id || '', className: String(parent.className || '') };
+        const key = JSON.stringify(row);
+        if (!seen.has(key)) rows.push(row);
+        seen.add(key);
+      }
+    }
+  }
+  return rows;
+})()`;
+
+await send("Page.enable");
+await send("Runtime.enable");
+await send("Network.enable");
+await send("Network.setCacheDisabled", { cacheDisabled: true });
+await send("Network.setBypassServiceWorker", { bypass: true });
+await send("Emulation.setDeviceMetricsOverride", { width: 1440, height: 1000, deviceScaleFactor: 1, mobile: false });
+
+const result = {};
+for (const code of ["zh-Hans", "zh-Hant"]) {
+  await send("Page.navigate", { url: `http://127.0.0.1:18431/index.html?lang=${code}#stage` });
+  await settle();
+  await evaluate("document.getElementById('stage-tour-close')?.click(); true");
+  for (const name of ["cast", "light", "scenes"]) {
+    await evaluate(`(() => { const panel = document.querySelector('[data-panel="${name}"]'); if (panel?.classList.contains('is-collapsed')) panel.querySelector('[data-panel-head]')?.click(); return true; })()`);
+  }
+  const states = { main: await evaluate(collect) };
+  await shot(`${code}-front.png`);
+  for (const [name, open, close] of [
+    ["scenes", "stage-scene-grid-open", "stage-scene-grid-close"],
+    ["export", "stage-export", "stage-export-close"],
+    ["settings", "stage-prefs-btn", "stage-prefs-close"],
+  ]) {
+    await evaluate(`document.getElementById('${open}')?.click(); true`);
+    await new Promise((resolve) => setTimeout(resolve, 120));
+    states[name] = await evaluate(collect);
+    if (name === "settings") await shot(`${code}-settings.png`);
+    await evaluate(`document.getElementById('${close}')?.click(); true`);
+    await new Promise((resolve) => setTimeout(resolve, 80));
+  }
+  const unique = [];
+  const seen = new Set();
+  for (const [state, rows] of Object.entries(states)) {
+    for (const row of rows) {
+      const key = JSON.stringify(row);
+      if (!seen.has(key)) unique.push({ state, ...row });
+      seen.add(key);
+    }
+  }
+  result[code] = {
+    lang: await evaluate("document.documentElement.lang"),
+    selectOptions: await evaluate("[...document.querySelectorAll('#stage-lang option')].map((option) => option.textContent)"),
+    fonts: await evaluate("(() => { const s=getComputedStyle(document.documentElement); return {sans:s.getPropertyValue('--sans').trim(),serif:s.getPropertyValue('--serif').trim()}; })()"),
+    kana: unique,
+  };
+}
+console.log(JSON.stringify(result, null, 2));
+ws.close();
