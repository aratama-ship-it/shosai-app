diff --git a//tmp/shosai-r3d-browser-check.mjs b//tmp/shosai-r3d-browser-check.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..1820b8de3cae4c912a9df8b7a5729f6d66f093fd
--- /dev/null
+++ b//tmp/shosai-r3d-browser-check.mjs
@@ -0,0 +1,193 @@
+import { createHash } from "node:crypto";
+import { mkdir, writeFile } from "node:fs/promises";
+
+const cdpPort = 18444;
+const appOrigin = "http://127.0.0.1:18431";
+const outputDir = "/Users/arata/Library/Mobile Documents/com~apple~CloudDocs/claude code files/show-creative-ideas/shosai-app/docs/i18n-zh-2026-09";
+const pages = await (await fetch(`http://127.0.0.1:${cdpPort}/json/list`)).json();
+const pageTarget = pages.find((entry) => entry.type === "page");
+if (!pageTarget) throw new Error("Chrome page target not found");
+
+const socket = new WebSocket(pageTarget.webSocketDebuggerUrl);
+await new Promise((resolve, reject) => {
+  socket.onopen = resolve;
+  socket.onerror = reject;
+});
+
+let commandId = 0;
+const pending = new Map();
+const events = [];
+socket.onmessage = (event) => {
+  const message = JSON.parse(event.data);
+  if (message.id && pending.has(message.id)) {
+    const waiter = pending.get(message.id);
+    pending.delete(message.id);
+    if (message.error) waiter.reject(new Error(JSON.stringify(message.error)));
+    else waiter.resolve(message.result);
+    return;
+  }
+  events.push(message);
+};
+
+function send(method, params = {}) {
+  return new Promise((resolve, reject) => {
+    const id = ++commandId;
+    pending.set(id, { resolve, reject });
+    socket.send(JSON.stringify({ id, method, params }));
+  });
+}
+
+async function evaluate(expression) {
+  const result = await send("Runtime.evaluate", {
+    expression,
+    awaitPromise: true,
+    returnByValue: true,
+  });
+  if (result.exceptionDetails) throw new Error(JSON.stringify(result.exceptionDetails));
+  return result.result.value;
+}
+
+async function waitForComplete() {
+  for (let attempt = 0; attempt < 200; attempt += 1) {
+    if (await evaluate("document.readyState") === "complete") break;
+    await new Promise((resolve) => setTimeout(resolve, 25));
+  }
+  await new Promise((resolve) => setTimeout(resolve, 350));
+}
+
+async function navigate(url) {
+  events.length = 0;
+  await send("Page.navigate", { url });
+  await waitForComplete();
+}
+
+async function screenshot(name) {
+  const result = await send("Page.captureScreenshot", {
+    format: "png",
+    fromSurface: true,
+    captureBeyondViewport: false,
+  });
+  await writeFile(`${outputDir}/${name}`, Buffer.from(result.data, "base64"));
+}
+
+const kanaCollector = `(() => {
+  const rows = [];
+  const seen = new Set();
+  const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
+  for (let node = walker.nextNode(); node; node = walker.nextNode()) {
+    const parent = node.parentElement;
+    if (!parent || parent.closest('[data-no-i18n], input, textarea, [contenteditable="true"]')) continue;
+    if (!parent.getClientRects().length || getComputedStyle(parent).visibility === 'hidden') continue;
+    const matches = node.data.match(/[\u3040-\u30ff]+/g) || [];
+    for (const text of matches) {
+      const key = parent.tagName + '#' + (parent.id || '') + '.' + parent.className + ':' + text;
+      if (seen.has(key)) continue;
+      seen.add(key);
+      rows.push({ text, element: parent.tagName.toLowerCase(), id: parent.id || '', className: String(parent.className || '') });
+    }
+  }
+  return rows;
+})()`;
+
+await mkdir(outputDir, { recursive: true });
+await send("Page.enable");
+await send("Runtime.enable");
+await send("Network.enable");
+await send("Network.setCacheDisabled", { cacheDisabled: true });
+await send("Network.setBypassServiceWorker", { bypass: true });
+await send("Emulation.setDeviceMetricsOverride", {
+  width: 1440,
+  height: 1000,
+  deviceScaleFactor: 1,
+  mobile: false,
+});
+
+const languageResults = {};
+for (const code of ["en", "ja", "zh-Hans", "zh-Hant"]) {
+  await navigate(`${appOrigin}/index.html?lang=${code}#stage`);
+  await evaluate("localStorage.clear(); true");
+  await send("Page.reload", { ignoreCache: true });
+  await waitForComplete();
+  const base = await evaluate(`(() => {
+    for (const name of ['cast', 'light', 'scenes']) {
+      const panel = document.querySelector('[data-panel="' + name + '"]');
+      if (panel && panel.classList.contains('is-collapsed')) panel.querySelector('[data-panel-head]')?.click();
+    }
+    return {
+      lang: document.documentElement.lang,
+      body: document.body.innerText,
+      stageVisible: !document.querySelector('#view-stage').hidden,
+      selectValue: document.querySelector('#stage-lang')?.value,
+      selectedOptions: [...document.querySelectorAll('#stage-lang option')].map((option) => option.textContent),
+      venueNote: {
+        hidden: document.querySelector('#stage-venue-note')?.hidden,
+        text: document.querySelector('#stage-venue-note')?.textContent,
+      },
+      panelState: ['cast', 'light', 'scenes'].map((name) => {
+        const panel = document.querySelector('[data-panel="' + name + '"]');
+        return { name, hidden: panel?.hidden, collapsed: panel?.classList.contains('is-collapsed') };
+      }),
+    };
+  })()`);
+  const states = {};
+  states.main = await evaluate(kanaCollector);
+
+  if (code.startsWith("zh-")) {
+    await screenshot(`${code}-front.png`);
+  }
+
+  for (const [state, openId, closeId] of [
+    ["scenes", "stage-scene-grid-open", "stage-scene-grid-close"],
+    ["export", "stage-export", "stage-export-close"],
+    ["settings", "stage-prefs-btn", "stage-prefs-close"],
+  ]) {
+    await evaluate(`document.getElementById(${JSON.stringify(openId)})?.click(); true`);
+    await new Promise((resolve) => setTimeout(resolve, 120));
+    states[state] = await evaluate(kanaCollector);
+    if (code.startsWith("zh-") && state === "settings") {
+      await screenshot(`${code}-settings.png`);
+    }
+    await evaluate(`document.getElementById(${JSON.stringify(closeId)})?.click(); true`);
+    await new Promise((resolve) => setTimeout(resolve, 80));
+  }
+
+  const allKana = [];
+  const seenKana = new Set();
+  for (const [state, rows] of Object.entries(states)) {
+    for (const row of rows) {
+      const key = JSON.stringify(row);
+      if (!seenKana.has(key)) allKana.push({ state, ...row });
+      seenKana.add(key);
+    }
+  }
+  languageResults[code] = {
+    ...base,
+    bytes: Buffer.byteLength(base.body),
+    sha256: createHash("sha256").update(base.body).digest("hex"),
+    kana: allKana,
+  };
+}
+
+async function measuredLoad(path, run) {
+  events.length = 0;
+  await navigate(`${appOrigin}/${path}?measure=${run}#stage`);
+  const navigation = await evaluate(`(() => {
+    const entry = performance.getEntriesByType('navigation')[0];
+    return { duration: entry.duration, domContentLoaded: entry.domContentLoadedEventEnd, loadEventEnd: entry.loadEventEnd };
+  })()`);
+  const resources = await evaluate(`performance.getEntriesByType('resource').map((entry) => ({ name: entry.name, duration: entry.duration, transferSize: entry.transferSize, encodedBodySize: entry.encodedBodySize }))`);
+  return {
+    navigation,
+    transferSize: resources.reduce((sum, entry) => sum + entry.transferSize, 0),
+    zhResources: resources.filter((entry) => /stage-i18n\.zh-Han[st]\.js/.test(entry.name)),
+  };
+}
+
+const loadRuns = { baseline: [], current: [] };
+for (let run = 1; run <= 7; run += 1) {
+  loadRuns.baseline.push(await measuredLoad("index_backup_2026-09-09-before-zh.html", run));
+  loadRuns.current.push(await measuredLoad("index.html", run));
+}
+
+console.log(JSON.stringify({ languageResults, loadRuns }, null, 2));
+socket.close();
diff --git a//tmp/shosai-r3d-final-browser-evidence.mjs b//tmp/shosai-r3d-final-browser-evidence.mjs
