  function autoName(base) {
    const head = String(base).split(/[・/]/)[0].trim() || base;
    const used = new Set();
    (state.project.cast || []).forEach((c) => used.add(c.name));
    (state.project.sets || []).forEach((s) => used.add(s.name));
