        {
          "kind": "dialogue",
          "speaker": "ジュリエット",
          "speakerRoleId": "JULIET",
          "text": "ロミオ、あと少しだけ。それで、本当におやすみ。\nあなたの愛が誠実で、\n結婚するつもりがあるのなら、\n明日、私がそちらへ送る人に伝えて。\nいつ、どこで式を挙げるのか。\n私の持つものすべてを、あなたに預けます。\nどこへでも、あなたについていく。",
          "delivery": "onstage",
          "provenance": {
            "kind": "existing_japanese_excerpt",
            "sourceSampleId": "RJ-SAMPLE-03",
            "sourceLines": [
              1,
              2,
              3,
              4,
              5,
              6,
              7
            ],
            "rawLines": [
              "ジュリエット　ロミオ、あと少しだけ。それで、本当におやすみ。",
              "　あなたの愛が誠実で、",
              "　結婚するつもりがあるのなら、",
              "　明日、私がそちらへ送る人に伝えて。",
              "　いつ、どこで式を挙げるのか。",
              "　私の持つものすべてを、あなたに預けます。",
              "　どこへでも、あなたについていく。"
            ]
          },
          "id": "RJ-COND-02-A-L02"
