+  required(project, "venueSize", "$.project");
+  if (!(venueSizes[project.venue] || []).includes(project.venueSize)) add("$.project.venueSize", `${project.venue} で使える規模は ${(venueSizes[project.venue] || []).join("/") || "(会場不正)"} のみ`, "changes-figure");
