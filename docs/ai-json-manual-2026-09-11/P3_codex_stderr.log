+<section><h2>JSON点検</h2><label class="field">JSONファイルを選ぶ<input id="json-file" type="file" accept=".json,application/json"></label><label class="field">またはJSONを貼り付ける<textarea id="json-input" placeholder='{ "kind": "shosai-stage-sketch", ... }'></textarea></label><button id="check-json">点検する</button><div id="syntax-error" class="result contract hidden" role="alert"></div><div id="check-results" class="results" aria-live="polite"></div><button id="copy-fix" class="hidden">AIに貼る修正依頼文をコピー</button><textarea id="fix-fallback" class="copy-source hidden" aria-label="手動コピー用の修正依頼文"></textarea></section>
+<section class="footnote">外部送信なし・ブラウザ内で完結します。既知の非対応: 既存ショー修正、Mac版AI指示、動線。読み込み成功は意図どおりの保証ではありません。全場面を見て判断してください。</section></main><script src="ai-json-check.browser.js"></script><script>const C=window.ShodaiAiJsonCheck,$=id=>document.getElementById(id);let lastErrors=[];const copy=async(text,fallback)=>{try{await navigator.clipboard.writeText(text);return true}catch(_){fallback.value=text;fallback.classList.remove('hidden');fallback.focus();fallback.select();return false}};$('copy-manual').onclick=()=>copy(${JSON.stringify(manual)},$('manual-fallback'));$('json-file').onchange=async e=>{const f=e.target.files[0];if(f)$('json-input').value=await f.text()};$('check-json').onclick=()=>{const syntax=$('syntax-error'),results=$('check-results'),fix=$('copy-fix');syntax.classList.add('hidden');results.replaceChildren();fix.classList.add('hidden');lastErrors=[];let doc;try{doc=JSON.parse($('json-input').value)}catch(error){const text=$('json-input').value,at=Math.max(0,text.length-1),before=text.slice(0,at),line=before.split('\\n').length,column=at-(before.lastIndexOf('\\n')+1)+1;syntax.textContent='JSON構文エラー: '+error.message+'（行 '+line+'、列 '+column+'）';syntax.classList.remove('hidden');return}lastErrors=C.validate(doc,C.enums).errors;const groups=[['changes-figure','図が変わる'],['contract','規約違反']];if(!lastErrors.length){const d=document.createElement('div');d.className='result ok';d.textContent='点検OK。舞台スケッチの「読み込む」で開けます（読み込み成功＝意図どおりではありません。全場面を見て判断）';results.append(d);return}for(const [kind,label] of groups){const items=lastErrors.filter(x=>x.severity===kind);if(!items.length)continue;const d=document.createElement('div');d.className='result '+(kind==='changes-figure'?'figure':'contract');const h=document.createElement('h3');h.textContent=label+'（'+items.length+'件）';const ul=document.createElement('ul');items.forEach(x=>{const li=document.createElement('li');li.textContent=x.path+': '+x.message;ul.append(li)});d.append(h,ul);results.append(d)}fix.classList.remove('hidden')};$('copy-fix').onclick=()=>copy(C.buildFixRequest(lastErrors),$('fix-fallback'));</script></body></html>`;
