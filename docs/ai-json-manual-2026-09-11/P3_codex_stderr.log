+    const pieces = list(scene?.pieces, `${at}.pieces`); if (pieces.length > 80) add(`${at}.pieces`, "上限80超過"); const local = new Set();
+    pieces.forEach((piece, j) => { const pieceAt = `${at}.pieces[${j}]`; keys(piece, sets.piece, pieceAt); ["id", "type", "u", "v", "color"].forEach((key) => required(piece, key, pieceAt)); ident(piece?.id, `${pieceAt}.id`); if (local.has(piece?.id)) add(`${pieceAt}.id`, "同一場面で重複"); local.add(piece?.id); pieceIds.push(piece?.id); if (!enumList("PIECE_TYPES").includes(piece?.type)) add(`${pieceAt}.type`, "stage-sketch.js の PIECE_TYPES にない", "changes-figure"); number(piece?.u, `${pieceAt}.u`, 0, 1); number(piece?.v, `${pieceAt}.v`, 0, 1); if (!colorRE.test(piece?.color || "")) add(`${pieceAt}.color`, "#rrggbb が必要", "changes-figure"); if ("facing" in (piece || {})) number(piece.facing, `${pieceAt}.facing`, 0, 359); if ("size" in (piece || {})) number(piece.size, `${pieceAt}.size`, 55, 180);
