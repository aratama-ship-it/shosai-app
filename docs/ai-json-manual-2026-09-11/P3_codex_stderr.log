+  const duplicate = (values, at) => { const seen = new Set(); values.forEach((value, i) => { if (seen.has(value)) add(`${at}[${i}]`, `ID 重複 ${value}`); seen.add(value); }); };
+  const enumList = (name) => Array.isArray(enums?.[name]) ? enums[name] : [];
