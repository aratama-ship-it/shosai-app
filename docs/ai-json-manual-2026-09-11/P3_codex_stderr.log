+/* Browser/Node shared validator for the AI JSON contract.  It deliberately has
+ * no file, DOM, or process access: callers provide the extracted enums. */
+export function buildFixRequest(errors) {
+  const lines = (errors || []).map((error) => `- ${error.path}: ${error.message}`);
+  return `検査器の結果です。修正版の完全JSONを返してください。説明文やコードフェンスは付けず、JSONだけを返してください。\n\n${lines.join("\n")}`;
+}
+
+export function validate(doc, enums) {
+  const errors = [];
+  const add = (path, message, severity = "contract") => errors.push({ path, message, severity });
+  const sets = Object.fromEntries(Object.entries({
+    root: ["kind", "version", "venues", "project"], project: ["title", "venue", "venueSize", "cast", "sets", "scenes"],
+    cast: ["id", "name", "color", "heightCm", "note"], set: ["id", "kind", "name", "color", "note", "lightKind"],
+    section: ["kind", "depth", "id", "title"], scene: ["kind", "depth", "id", "title", "note", "background", "beat", "lightingIntent", "pieces"],
+    beat: ["role", "energy"], intent: ["objective", "audienceFocus", "mood"],
+    piece: ["id", "type", "castId", "setId", "u", "v", "color", "facing", "pose", "size"],
+  }).map(([key, value]) => [key, new Set(value)]));
+  const idRE = /^[a-zA-Z0-9][a-zA-Z0-9._-]{0,95}$/;
+  const colorRE = /^#[0-9a-f]{6}$/;
+  const object = (value) => value && typeof value === "object" && !Array.isArray(value);
+  const keys = (value, allowed, at) => {
+    if (!object(value)) { add(at, "object が必要"); return false; }
+    Object.keys(value).forEach((key) => { if (!allowed.has(key)) add(`${at}.${key}`, "未知キー"); });
+    return true;
+  };
+  const required = (value, key, at) => {
+    if (!object(value)) { add(at, "object が必要"); return; }
+    if (!(key in value)) add(`${at}.${key}`, "必須");
+    else if (value[key] === null) add(`${at}.${key}`, "null は不可");
+  };
+  const string = (value, at, min = 1, max = Infinity) => {
+    if (typeof value !== "string" || value.length < min || value.length > max) add(at, `${min}〜${max === Infinity ? "" : max}字の文字列が必要`);
+  };
+  const number = (value, at, min, max, integer = false) => {
+    if (typeof value !== "number" || !Number.isFinite(value) || (integer && !Number.isInteger(value)) || value < min || value > max) add(at, `${min}〜${max}の${integer ? "整数" : "数値"}が必要（文字列は不可）`);
+  };
+  const ident = (value, at) => { if (typeof value !== "string" || !idRE.test(value)) add(at, "ASCII ID が必要"); };
+  const list = (value, at) => { if (!Array.isArray(value)) { add(at, "配列が必要"); return []; } return value; };
+  const duplicate = (values, at) => { const seen = new Set(); values.forEach((value, i) => { if (seen.has(value)) add(`${at}[${i}]`, `ID 重複 ${value}`); seen.add(value); }); };
+  const enumList = (name) => Array.isArray(enums?.[name]) ? enums[name] : [];
+  const venueSizes = enums?.VENUE_SIZES && typeof enums.VENUE_SIZES === "object" ? enums.VENUE_SIZES : {};
+  const venues = Object.keys(venueSizes);
+
+  keys(doc, sets.root, "$ ".trim());
+  if (!object(doc)) return { errors };
+  if (doc.kind !== "shosai-stage-sketch") add("$.kind", "shosai-stage-sketch が必要");
+  if (doc.version !== 4) add("$.version", "数値 4 が必要");
+  if (!Array.isArray(doc.venues) || doc.venues.length) add("$.venues", "空配列が必要");
+  const project = doc.project;
+  keys(project, sets.project, "$.project");
+  if (!object(project)) return { errors };
+  required(project, "title", "$.project"); string(project.title, "$.project.title", 1, 60);
+  required(project, "venue", "$.project");
+  if (!venues.includes(project.venue)) add("$.project.venue", "許可会場ではない", "changes-figure");
+  required(project, "venueSize", "$.project");
+  if (!(venueSizes[project.venue] || []).includes(project.venueSize)) add("$.project.venueSize", `${project.venue} で使える規模は ${(venueSizes[project.venue] || []).join("/") || "(会場不正)"} のみ`, "changes-figure");
+  ["cast", "sets", "scenes"].forEach((key) => required(project, key, "$.project"));
+  const cast = list(project.cast, "$.project.cast"), stageSets = list(project.sets, "$.project.sets"), scenes = list(project.scenes, "$.project.scenes");
+  const castIds = [], setIds = [], sceneIds = [], pieceIds = [];
+  cast.forEach((item, i) => { const at = `$.project.cast[${i}]`; keys(item, sets.cast, at); ["id", "name", "color"].forEach((key) => required(item, key, at)); ident(item?.id, `${at}.id`); castIds.push(item?.id); string(item?.name, `${at}.name`, 1, 24); if (!colorRE.test(item?.color || "")) add(`${at}.color`, "#rrggbb が必要", "changes-figure"); if ("heightCm" in (item || {})) number(item.heightCm, `${at}.heightCm`, 120, 210, true); if ("note" in (item || {})) string(item.note, `${at}.note`, 0, 200); });
+  duplicate(castIds, "$.project.cast");
+  stageSets.forEach((item, i) => { const at = `$.project.sets[${i}]`; keys(item, sets.set, at); ["id", "kind", "name", "color"].forEach((key) => required(item, key, at)); ident(item?.id, `${at}.id`); setIds.push(item?.id); if (!enumList("SET_KINDS").includes(item?.kind)) add(`${at}.kind`, "stage-sketch.js の SET_KINDS にない", "changes-figure"); string(item?.name, `${at}.name`, 1, 24); if (!colorRE.test(item?.color || "")) add(`${at}.color`, "#rrggbb が必要", "changes-figure"); if (item?.kind === "light" && item.lightKind !== "hang") add(`${at}.lightKind`, "light は hang 固定"); if (item?.kind !== "light" && "lightKind" in (item || {})) add(`${at}.lightKind`, "light 以外には不可"); });
+  duplicate(setIds, "$.project.sets");
+  let sceneCount = 0;
+  scenes.forEach((scene, i) => {
+    const at = `$.project.scenes[${i}]`, section = scene?.kind === "section";
+    keys(scene, section ? sets.section : sets.scene, at);
+    if (section) { ["kind", "depth", "id", "title"].forEach((key) => required(scene, key, at)); if (scene?.depth !== 0) add(`${at}.depth`, "section は 0"); ident(scene?.id, `${at}.id`); sceneIds.push(scene?.id); string(scene?.title, `${at}.title`, 1, 60); return; }
+    sceneCount++; ["kind", "depth", "id", "title", "note", "pieces"].forEach((key) => required(scene, key, at)); if (scene?.kind !== "scene") add(`${at}.kind`, "scene/section のみ"); number(scene?.depth, `${at}.depth`, 0, 1, true); ident(scene?.id, `${at}.id`); sceneIds.push(scene?.id); string(scene?.title, `${at}.title", 1, 60); string(scene?.note, `${at}.note`, 0, 2000);
+    if ("beat" in (scene || {})) { keys(scene.beat, sets.beat, `${at}.beat`); ["role", "energy"].forEach((key) => required(scene.beat, key, `${at}.beat`)); string(scene.beat?.role, `${at}.beat.role`, 1, 80); number(scene.beat?.energy, `${at}.beat.energy`, 1, 5, true); }
+    if ("lightingIntent" in (scene || {})) { keys(scene.lightingIntent, sets.intent, `${at}.lightingIntent`); ["objective", "audienceFocus", "mood"].forEach((key) => { required(scene.lightingIntent, key, `${at}.lightingIntent`); string(scene.lightingIntent?.[key], `${at}.lightingIntent.${key}`, 1, 200); }); }
+    const pieces = list(scene?.pieces, `${at}.pieces`); if (pieces.length > 80) add(`${at}.pieces`, "上限80超過"); const local = new Set();
+    pieces.forEach((piece, j) => { const pieceAt = `${at}.pieces[${j}]`; keys(piece, sets.piece, pieceAt); ["id", "type", "u", "v", "color"].forEach((key) => required(piece, key, pieceAt)); ident(piece?.id, `${pieceAt}.id`); if (local.has(piece?.id)) add(`${pieceAt}.id`, "同一場面で重複"); local.add(piece?.id); pieceIds.push(piece?.id); if (!enumList("PIECE_TYPES").includes(piece?.type)) add(`${pieceAt}.type`, "stage-sketch.js の PIECE_TYPES にない", "changes-figure"); number(piece?.u, `${pieceAt}.u`, 0, 1); number(piece?.v, `${pieceAt}.v`, 0, 1); if (!colorRE.test(piece?.color || "")) add(`${pieceAt}.color`, "#rrggbb が必要", "changes-figure"); if ("facing" in (piece || {})) number(piece.facing, `${pieceAt}.facing`, 0, 359); if ("size" in (piece || {})) number(piece.size, `${pieceAt}.size`, 55, 180);
+      if (piece?.type === "performer") { required(piece, "castId", pieceAt); if (!castIds.includes(piece?.castId)) add(`${pieceAt}.castId`, "参照先なし", "changes-figure"); if ("setId" in (piece || {})) add(`${pieceAt}.setId`, "performer には不可"); if ("pose" in (piece || {}) && !enumList("POSES").includes(piece.pose)) add(`${pieceAt}.pose`, "POSES にない", "changes-figure"); }
+      else { required(piece, "setId", pieceAt); const target = stageSets.find((set) => set?.id === piece?.setId); if (!target) add(`${pieceAt}.setId`, "参照先なし", "changes-figure"); else if (target.kind !== piece.type) add(pieceAt, "piece.type と set.kind が不一致", "changes-figure"); if ("castId" in (piece || {})) add(`${pieceAt}.castId`, "performer 以外には不可"); }
+    });
+    if (pieces.some((piece) => ["trapeze", "tissue", "cyrwheel", "pole"].includes(piece?.type)) && !String(scene?.note || "").includes("安全未確認")) add(`${at}.note`, "高リスク装置には「安全未確認」が必要");
+  });
+  if (scenes.length > 60) add("$.project.scenes", "scene+section 上限60超過"); if (!sceneCount) add("$.project.scenes", "kind:scene が1件以上必要"); duplicate(sceneIds, "$.project.scenes"); duplicate(pieceIds, "$.project.scenes pieces");
+  return { errors };
+}

