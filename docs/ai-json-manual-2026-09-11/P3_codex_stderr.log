+  const object = (value) => value && typeof value === "object" && !Array.isArray(value);
+  const keys = (value, allowed, at) => {
+    if (!object(value)) { add(at, "object が必要"); return false; }
+    Object.keys(value).forEach((key) => { if (!allowed.has(key)) add(`${at}.${key}`, "未知キー"); });
+    return true;
+  };
+  const required = (value, key, at) => {
+    if (!object(value)) { add(at, "object が必要"); return; }
+    if (!(key in value)) add(`${at}.${key}`, "必須");
+    else if (value[key] === null) add(`${at}.${key}`, "null は不可");
+  };
+  const string = (value, at, min = 1, max = Infinity) => {
+    if (typeof value !== "string" || value.length < min || value.length > max) add(at, `${min}〜${max === Infinity ? "" : max}字の文字列が必要`);
+  };
+  const number = (value, at, min, max, integer = false) => {
+    if (typeof value !== "number" || !Number.isFinite(value) || (integer && !Number.isInteger(value)) || value < min || value > max) add(at, `${min}〜${max}の${integer ? "整数" : "数値"}が必要（文字列は不可）`);
+  };
+  const ident = (value, at) => { if (typeof value !== "string" || !idRE.test(value)) add(at, "ASCII ID が必要"); };
