+#!/usr/bin/env node
+/* file:// acceptance test for the generated, self-contained public guide. */
+import { mkdir, readFile, writeFile } from "node:fs/promises";
+import path from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
+const out = path.join(root, "docs/ai-json-manual-2026-09-11/qa-p3");
+const pwPath = process.env.STUDY_PLAYWRIGHT || "/Users/arata/.npm/_npx/9833c18b2d85bc59/node_modules/playwright/index.js";
+const loaded = await import(pathToFileURL(pwPath));
+const { chromium } = loaded.default || loaded;
+const pageUrl = pathToFileURL(path.join(root, "public/ai-json/index.html")).href;
+const read = (name) => readFile(path.join(root, name), "utf8");
+const manual = await read("docs/ai-json-manual/AI_MANUAL_ja.md");
+const good = await read("docs/ai-json-manual/samples/sample-minimal.json");
+const chatgpt = await read("docs/ai-json-manual-2026-09-11/p2-runs/chatgpt-1-1.json");
+const gemini = await read("docs/ai-json-manual-2026-09-11/p2-runs/gemini-1-1.json");
+const results = []; let failures = 0;
+const record = (name, ok, detail = "") => { results.push({ name, ok, detail }); if (!ok) failures++; console.log(`${ok ? "OK" : "NG"} ${name}${detail ? ` — ${detail}` : ""}`); };
+await mkdir(out, { recursive: true });
+let browser;
+try {
+  browser = await chromium.launch({ headless: true, channel: "chrome" });
+  async function runViewport(width, suffix) {
+    const context = await browser.newContext({ viewport: { width, height: 900 } }); const page = await context.newPage(); const errors = [];
+    page.on("pageerror", (error) => errors.push(error.message)); await page.goto(pageUrl); await page.waitForFunction(() => Boolean(window.ShodaiAiJsonCheck));
+    await page.screenshot({ path: path.join(out, `initial-${suffix}.png`), fullPage: true });
+    if (width > 500) {
+      await page.locator("#copy-manual").click();
+      record("本文コピー対象は正本と一致", await page.locator("#manual-fallback").inputValue() === manual);
+      for (const [name, source, expected] of [["chatgpt", chatgpt, 6], ["gemini", gemini, 39]]) {
+        await page.locator("#json-input").fill(source); await page.locator("#check-json").click();
+        const figure = await page.locator(".result.figure li").count();
+        record(`${name} の図が変わる分類`, figure === expected, `${figure}/${expected}`);
+        if (name === "chatgpt") { const expectedText = await page.evaluate(() => window.ShodaiAiJsonCheck.buildFixRequest(window.ShodaiAiJsonCheck.validate(JSON.parse(document.querySelector("#json-input").value), window.ShodaiAiJsonCheck.enums).errors)); await page.locator("#copy-fix").click(); record("修正依頼文は共通関数と一致", await page.locator("#fix-fallback").inputValue() === expectedText); await page.screenshot({ path: path.join(out, `ng-${suffix}.png`), fullPage: true }); }
+      }
+      await page.locator("#json-input").fill(good); await page.locator("#check-json").click(); record("見本は点検OK", (await page.locator("#check-results").innerText()).startsWith("点検OK")); await page.screenshot({ path: path.join(out, `ok-${suffix}.png`), fullPage: true });
+      await page.locator("#json-input").fill('{\n  "bad":'); await page.locator("#check-json").click(); const syntax = await page.locator("#syntax-error").innerText(); record("構文エラーは行・列を表示", /line|行/.test(syntax) && /column|列/.test(syntax), syntax);
+    } else {
+      await page.locator("#json-input").fill(chatgpt); await page.locator("#check-json").click(); await page.screenshot({ path: path.join(out, `ng-${suffix}.png`), fullPage: true }); await page.locator("#json-input").fill(good); await page.locator("#check-json").click(); await page.screenshot({ path: path.join(out, `ok-${suffix}.png`), fullPage: true });
+    }
+    record(`${suffix} ページエラーなし`, errors.length === 0, errors.join(" / ")); await context.close();
+  }
+  await runViewport(1280, "pc"); await runViewport(390, "390");
+} catch (error) { record("ブラウザ検証の実行", false, error.message); }
+finally { if (browser) await browser.close(); }
+await writeFile(path.join(out, "browser-check-results.json"), JSON.stringify(results, null, 2));
+console.log(failures ? `NG ${failures}件` : "OK: すべて合格"); process.exitCode = failures ? 1 : 0;
