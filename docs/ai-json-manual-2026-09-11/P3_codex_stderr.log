+/* Browser/Node shared validator for the AI JSON contract.  It deliberately has
+ * no file, DOM, or process access: callers provide the extracted enums. */
+export function buildFixRequest(errors) {
+  const lines = (errors || []).map((error) => `- ${error.path}: ${error.message}`);
+  return `検査器の結果です。修正版の完全JSONを返してください。説明文やコードフェンスは付けず、JSONだけを返してください。\n\n${lines.join("\n")}`;
+}
+
+export function validate(doc, enums) {
+  const errors = [];
+  const add = (path, message, severity = "contract") => errors.push({ path, message, severity });
+  const sets = Object.fromEntries(Object.entries({
