+    sceneCount++; ["kind", "depth", "id", "title", "note", "pieces"].forEach((key) => required(scene, key, at)); if (scene?.kind !== "scene") add(`${at}.kind`, "scene/section のみ"); number(scene?.depth, `${at}.depth`, 0, 1, true); ident(scene?.id, `${at}.id`); sceneIds.push(scene?.id); string(scene?.title, `${at}.title`, 1, 60); string(scene?.note, `${at}.note`, 0, 2000);
