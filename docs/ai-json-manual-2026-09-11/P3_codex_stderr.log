+    cast: ["id", "name", "color", "heightCm", "note"], set: ["id", "kind", "name", "color", "note", "lightKind"],
+    section: ["kind", "depth", "id", "title"], scene: ["kind", "depth", "id", "title", "note", "background", "beat", "lightingIntent", "pieces"],
+    beat: ["role", "energy"], intent: ["objective", "audienceFocus", "mood"],
