index 0000000000000000000000000000000000000000..b86c32e7d684ee8c037075655f808eb223eb5247
--- /dev/null
+++ b/tools/build-ai-json-page.mjs
@@ -0,0 +1,44 @@
+#!/usr/bin/env node
+/* Generates the self-contained AI JSON guide.  Source values are extracted on
+ * every build so a changed app cannot silently ship a stale browser checker. */
+import { cpSync, mkdirSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
+const read = (name) => readFileSync(path.join(root, name), "utf8");
+const stage = read("stage-sketch.js"), venuesSource = read("stage-venues.js");
+function block(source, start, end, label) { const a = source.indexOf(start), b = source.indexOf(end, a); if (a < 0 || b < 0) throw new Error(`${label} の抽出位置がありません`); return source.slice(a, b + end.length); }
+function objectKeys(start, end, name) { return Object.keys(new Function(`${block(stage, start, end, name)}; return ${name};`)()); }
+const POSES = new Function(`${block(stage, "const BASE_JOINTS = {", "\n  })();", "POSES")}\nreturn POSES;`)().map((pose) => pose.id);
+const PIECE_TYPES = objectKeys("const PIECE_TYPES = {", "\n  };", "PIECE_TYPES");
+const SET_KINDS = objectKeys("const SET_KINDS = {", "\n  };", "SET_KINDS");
+const LIGHT_KINDS = objectKeys("const LIGHT_KINDS = {", "\n  };", "LIGHT_KINDS");
+const VENUE_SIZES = (() => { const body = venuesSource.slice(venuesSource.indexOf("const VENUES_V2")); if (!body) throw new Error("VENUES_V2 の抽出位置がありません"); const re = /\{\s*id: "([a-z-]+)",[\s\S]*?sizes: \[([\s\S]*?)\n\s*\]/g; const result = {}; let match; while ((match = re.exec(body))) { if (result[match[1]]) continue; const sizes = [...match[2].matchAll(/id: "([a-z]+)"/g)].map((item) => item[1]); if (sizes.length) result[match[1]] = sizes; } return result; })();
+for (const venue of ["proscenium", "thrust", "arena", "blackbox"]) if (!VENUE_SIZES[venue]?.length) throw new Error(`会場 ${venue} を抽出できません`);
+if (POSES.length !== 46 || !PIECE_TYPES.length || !SET_KINDS.length || !LIGHT_KINDS.length) throw new Error("enum の抽出結果が契約の最低条件を満たしません");
+const version = (read("stage.html").match(/class="stage-app-version">([^<]+)</) || [])[1];
+if (!version) throw new Error("stage.html の .stage-app-version を抽出できません");
+const manual = read("docs/ai-json-manual/AI_MANUAL_ja.md");
+const manualVersion = (manual.match(/^# .* (v[^\s]+)/m) || [])[1];
+if (!manualVersion) throw new Error("AI_MANUAL_ja.md の版を抽出できません");
+const out = path.join(root, "public", "ai-json");
+rmSync(out, { recursive: true, force: true }); mkdirSync(path.join(out, "samples"), { recursive: true });
+cpSync(path.join(root, "docs/ai-json-manual/samples/sample-minimal.json"), path.join(out, "samples/sample-minimal.json"));
+cpSync(path.join(root, "docs/ai-json-manual/samples/sample-standard.json"), path.join(out, "samples/sample-standard.json"));
+writeFileSync(path.join(out, "AI_MANUAL_ja.md"), manual);
+const core = read("tools/ai-json-check-core.mjs").replace(/export function /g, "function ");
+writeFileSync(path.join(out, "ai-json-check.browser.js"), `/* Generated by tools/build-ai-json-page.mjs; no network or external dependencies. */\n(() => {\n${core}\nwindow.ShodaiAiJsonCheck = { validate, buildFixRequest, enums: ${JSON.stringify({ POSES, PIECE_TYPES, SET_KINDS, LIGHT_KINDS, VENUE_SIZES })}, appVersion: ${JSON.stringify(version)}, manualVersion: ${JSON.stringify(manualVersion)} };\n})();\n`);
+const esc = (value) => value.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/\"/g, "&quot;");
+const html = `<!doctype html>
+<html lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>AIにショーの下書きを作らせる | 舞台スケッチ</title>
