const venuesSrc = readFileSync(path.join(root, 'stage-venues.js'), 'utf8');
const VENUE_SIZES = (() => { const body = venuesSrc.slice(venuesSrc.indexOf('const VENUES_V2')); const re = /\{\s*id: "([a-z-]+)",[\s\S]*?sizes: \[([\s\S]*?)\n\s*\]/g; const table = {}; let m; while ((m = re.exec(body))) { if (table[m[1]]) continue; const ids = [...m[2].matchAll(/id: "([a-z]+)"/g)].map(x => x[1]); if (ids.length) table[m[1]] = ids; } return table; })();
const venues = ['proscenium','thrust','arena','blackbox'].filter(id => VENUE_SIZES[id]);
if (venues.length < 4) throw new Error('stage-venues.js から会場プリセットを抽出できません: ' + JSON.stringify(VENUE_SIZES));
const allowed = {
 root:new Set(['kind','version','venues','project']), project:new Set(['title','venue','venueSize','cast','sets','scenes']),
 cast:new Set(['id','name','color','heightCm','note']), set:new Set(['id','kind','name','color','note','lightKind']),
 section:new Set(['kind','depth','id','title']), scene:new Set(['kind','depth','id','title','note','background','beat','lightingIntent','pieces']),
