+  {"kind":"scene","depth":1,"id":"scene-8","title":"残る輪","note":"四人が別々の方向を向く。観客には一度作った輪郭だけが残る変化が見える。","beat":{"role":"終景","energy":1},"lightingIntent":{"objective":"静かな終わりを残す","audienceFocus":"四人の間隔","mood":"余白"},"pieces":[{"id":"p-red-8","type":"performer","castId":"cast-red","u":0.2,"v":0.75,"color":"#b43b4a","pose":"stand"},{"id":"p-blue-8","type":"performer","castId":"cast-blue","u":0.8,"v":0.75,"color":"#315b8a","pose":"sit"},{"id":"p-gold-8","type":"performer","castId":"cast-gold","u":0.35,"v":0.25,"color":"#b88922","pose":"stand"},{"id":"p-green-8","type":"performer","castId":"cast-green","u":0.65,"v":0.25,"color":"#39745a","pose":"kneel"}]}
