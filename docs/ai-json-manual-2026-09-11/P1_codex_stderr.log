+ for(const k of ['cast','sets','scenes']) req(p,k,'$.project',out); const cast=array(p.cast,'$.project.cast',out)?p.cast:[]; const sets=array(p.sets,'$.project.sets',out)?p.sets:[]; const scenes=array(p.scenes,'$.project.scenes',out)?p.scenes:[];
+ const castIds=[],setIds=[],sceneIds=[],pieceIds=[];
+ cast.forEach((x,i)=>{const a=`$.project.cast[${i}]`;checkKeys(x,allowed.cast,a,out);for(const k of ['id','name','color'])req(x,k,a,out);id(x.id,`${a}.id`,out);castIds.push(x.id);str(x.name,`${a}.name`,out,1,24);if(!colorRE.test(x.color||''))out.push(`${a}.color: #rrggbb が必要`);if('heightCm'in x)num(x.heightCm,`${a}.heightCm`,out,120,210,true);if('note'in x)str(x.note,`${a}.note`,out,0,200);}); duplicates(castIds,'$.project.cast',out);
+ sets.forEach((x,i)=>{const a=`$.project.sets[${i}]`;checkKeys(x,allowed.set,a,out);for(const k of ['id','kind','name','color'])req(x,k,a,out);id(x.id,`${a}.id`,out);setIds.push(x.id);if(!SET_KINDS.includes(x.kind))out.push(`${a}.kind: stage-sketch.js の SET_KINDS にない`);str(x.name,`${a}.name`,out,1,24);if(!colorRE.test(x.color||''))out.push(`${a}.color: #rrggbb が必要`);if(x.kind==='light'&&x.lightKind!=='hang')out.push(`${a}.lightKind: light は hang 固定`);if(x.kind!=='light'&&'lightKind'in x)out.push(`${a}.lightKind: light 以外には不可`);}); duplicates(setIds,'$.project.sets',out);
+ let scenesCount=0; scenes.forEach((x,i)=>{const a=`$.project.scenes[${i}]`; const section=x&&x.kind==='section';checkKeys(x,section?allowed.section:allowed.scene,a,out);if(section){for(const k of ['kind','depth','id','title'])req(x,k,a,out);if(x.depth!==0)out.push(`${a}.depth: section は 0`);id(x.id,`${a}.id`,out);sceneIds.push(x.id);str(x.title,`${a}.title`,out,1,60);return;} scenesCount++;for(const k of ['kind','depth','id','title','note','pieces'])req(x,k,a,out);if(x?.kind!=='scene')out.push(`${a}.kind: scene/section のみ`);num(x?.depth,`${a}.depth`,out,0,1,true);id(x?.id,`${a}.id`,out);sceneIds.push(x?.id);str(x?.title,`${a}.title`,out,1,60);str(x?.note,`${a}.note`,out,0,2000); if('beat'in x){checkKeys(x.beat,allowed.beat,`${a}.beat`,out);req(x.beat,'role',`${a}.beat`,out);req(x.beat,'energy',`${a}.beat`,out);str(x.beat?.role,`${a}.beat.role`,out,1,80);num(x.beat?.energy,`${a}.beat.energy`,out,1,5,true);} if('lightingIntent'in x){checkKeys(x.lightingIntent,allowed.intent,`${a}.lightingIntent`,out);for(const k of ['objective','audienceFocus','mood']){req(x.lightingIntent,k,`${a}.lightingIntent`,out);str(x.lightingIntent?.[k],`${a}.lightingIntent.${k}`,out,1,200)}} const pieces=array(x?.pieces,`${a}.pieces`,out)?x.pieces:[];if(pieces.length>80)out.push(`${a}.pieces: 上限80超過`);const local=new Set; pieces.forEach((q,j)=>{const b=`${a}.pieces[${j}]`;checkKeys(q,allowed.piece,b,out);for(const k of ['id','type','u','v','color'])req(q,k,b,out);id(q?.id,`${b}.id`,out);if(local.has(q?.id))out.push(`${b}.id: 同一場面で重複`);local.add(q?.id);pieceIds.push(q?.id);if(!PIECE_TYPES.includes(q?.type))out.push(`${b}.type: stage-sketch.js の PIECE_TYPES にない`);num(q?.u,`${b}.u`,out,0,1);num(q?.v,`${b}.v`,out,0,1);if(!colorRE.test(q?.color||''))out.push(`${b}.color: #rrggbb が必要`);if('facing'in q)num(q.facing,`${b}.facing`,out,0,359);if('size'in q)num(q.size,`${b}.size`,out,55,180);if(q?.type==='performer'){req(q,'castId',b,out);if(!castIds.includes(q?.castId))out.push(`${b}.castId: 参照先なし`);if('setId'in q)out.push(`${b}.setId: performer には不可`);if('pose'in q&&!POSES.includes(q.pose))out.push(`${b}.pose: POSES にない`);}else{req(q,'setId',b,out);const st=sets.find(t=>t.id===q?.setId);if(!st)out.push(`${b}.setId: 参照先なし`);else if(st.kind!==q.type)out.push(`${b}: piece.type と set.kind が不一致`);if('castId'in q)out.push(`${b}.castId: performer 以外には不可`);}}); if(pieces.some(q=>['trapeze','tissue','cyrwheel','pole'].includes(q.type))&&!String(x.note||'').includes('安全未確認'))out.push(`${a}.note: 高リスク装置には「安全未確認」が必要`);});
+ if(scenes.length>60)out.push('$.project.scenes: scene+section 上限60超過'); if(!scenesCount)out.push('$.project.scenes: kind:scene が1件以上必要'); duplicates(sceneIds,'$.project.scenes',out); duplicates(pieceIds,'$.project.scenes pieces',out); return out;
+}
+const args=process.argv.slice(2), json=args.includes('--json'), files=args.filter(x=>x!=='--json'); if(!files.length){console.error('使い方: node tools/ai-json-check.mjs [--json] file.json...');process.exit(2)}
