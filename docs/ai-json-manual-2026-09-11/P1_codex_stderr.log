index 0000000000000000000000000000000000000000..7831ee36318c6835cc18fbd78529d95299e42b0d
--- /dev/null
+++ b/tools/ai-json-browser-check.mjs
@@ -0,0 +1,11 @@
+#!/usr/bin/env node
+/* P1 browser round-trip check: preview server, import-as-new, snapshots, every scene front/plan screenshots. */
+import assert from 'node:assert/strict'; import { spawn } from 'node:child_process'; import { mkdir, readFile } from 'node:fs/promises'; import path from 'node:path'; import { fileURLToPath, pathToFileURL } from 'node:url';
+const root=path.resolve(path.dirname(fileURLToPath(import.meta.url)),'..'); const out=path.join(root,'docs/ai-json-manual-2026-09-11/qa'); await mkdir(out,{recursive:true});
+const pw=process.env.STUDY_PLAYWRIGHT||'/Users/arata/.npm/_npx/9833c18b2d85bc59/node_modules/playwright/index.js'; const {chromium}=await import(pathToFileURL(pw));
+const server=spawn(process.execPath,['tools/study-preview.mjs'],{cwd:root,env:{...process.env,STUDY_MINIFLARE:process.env.STUDY_MINIFLARE||'/Users/arata/.npm/_npx/32026684e21afda6/node_modules/miniflare/dist/src/index.js'}});
+async function wait(){for(let i=0;i<40;i++){try{const r=await fetch('http://127.0.0.1:8796/stage.html');if(r.ok)return}catch{}await new Promise(r=>setTimeout(r,250))}throw new Error('study-preview を起動できません')}
+function semantic(d){const p=d.project;return {scenes:p.scenes.map(s=>({kind:s.kind,depth:s.depth,title:s.title,note:s.note,beat:s.beat?.energy,lightingIntent:s.lightingIntent,pieces:(s.pieces||[]).map(x=>({type:x.type,castId:x.castId,setId:x.setId,color:x.color,pose:x.pose,u:x.u,v:x.v}))})),cast:p.cast.map(x=>x.id)}}
+try { await wait(); const browser=await chromium.launch({headless:true,channel:'chrome'}); const ctx=await browser.newContext({viewport:{width:1440,height:1000},httpCredentials:{username:'study-owner',password:'local-study-owner'}}); await ctx.setExtraHTTPHeaders({Authorization:`Basic ${Buffer.from('study-owner:local-study-owner').toString('base64')}`}); const page=await ctx.newPage(); await page.goto('http://127.0.0.1:8796/stage.html?lang=ja'); await page.waitForFunction(()=>window.SHOSAI_STAGE_STUDY_OWNER);
+for(const name of ['sample-minimal','sample-standard']) { const file=path.join(root,'docs/ai-json-manual/samples',name+'.json'); const before=JSON.parse(await readFile(file,'utf8')); await page.locator('#stage-import-json').setInputFiles(file); await page.locator('#stage-import-modal').waitFor({state:'visible'}); await page.locator('#stage-import-as-new').click(); await page.waitForTimeout(250); const snap=await page.evaluate(()=>window.SHOSAI_STAGE_STUDY_OWNER.snapshot()); assert.deepEqual(semantic(snap),semantic(before)); for(const s of snap.project.scenes.filter(x=>x.kind==='scene')) { await page.evaluate(id=>{const x=window.SHOSAI_STAGE_STUDY_OWNER.snapshot().project.scenes.find(y=>y.id===id); document.querySelector('[data-scene-id="'+CSS.escape(id)+'"]')?.click()},s.id); await page.screenshot({path:path.join(out,`${name}-${s.id}-front.png`)}); await page.locator('#stage-view-plan').click(); await page.screenshot({path:path.join(out,`${name}-${s.id}-plan.png`)}); await page.locator('#stage-view-front').click(); } }
+await ctx.close();await browser.close(); console.log('OK: browser import and semantic snapshots'); } finally {server.kill('SIGTERM')}
