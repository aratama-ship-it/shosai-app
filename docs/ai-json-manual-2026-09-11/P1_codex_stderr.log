diff --git a/tools/ai-json-check.mjs b/tools/ai-json-check.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..adba9779b09150fa48858f0df43692ee13d85b29
--- /dev/null
+++ b/tools/ai-json-check.mjs
@@ -0,0 +1,47 @@
+#!/usr/bin/env node
+/** AI作成マニュアル用の厳格な raw JSON 検査器。現行 stage-sketch.js の列挙値を都度読む。 */
+import { readFileSync } from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const stage = readFileSync(path.join(root, 'stage-sketch.js'), 'utf8');
+function block(a, b) { const s = stage.indexOf(a), e = stage.indexOf(b, s); if (s < 0 || e < 0) throw new Error(`stage-sketch.js の抽出位置がありません: ${a}`); return stage.slice(s, e + b.length); }
+function objectKeys(a, b) { const name = a.split(' ')[1]; return Object.keys(new Function(`${block(a,b)}; return ${name};`)()); }
+const POSES = new Function(`${block('const BASE_JOINTS = {', '\n  })();')}\nreturn POSES;`)().map(x => x.id);
+const PIECE_TYPES = objectKeys('const PIECE_TYPES = {', '\n  };');
+const SET_KINDS = objectKeys('const SET_KINDS = {', '\n  };');
+const LIGHT_KINDS = objectKeys('const LIGHT_KINDS = {', '\n  };');
+const venues = ['proscenium','thrust','arena','endstage','blackbox'];
+const allowed = {
+ root:new Set(['kind','version','venues','project']), project:new Set(['title','venue','venueSize','cast','sets','scenes']),
+ cast:new Set(['id','name','color','heightCm','note']), set:new Set(['id','kind','name','color','note','lightKind']),
+ section:new Set(['kind','depth','id','title']), scene:new Set(['kind','depth','id','title','note','background','beat','lightingIntent','pieces']),
+ beat:new Set(['role','energy']), intent:new Set(['objective','audienceFocus','mood']),
+ piece:new Set(['id','type','castId','setId','u','v','color','facing','pose','size'])
+};
+const idRE=/^[a-zA-Z0-9][a-zA-Z0-9._-]{0,95}$/; const colorRE=/^#[0-9a-f]{6}$/;
+function checkKeys(o, set, at, out) { if (!o || typeof o !== 'object' || Array.isArray(o)) { out.push(`${at}: object が必要`); return; } for(const k of Object.keys(o)) if(!set.has(k)) out.push(`${at}.${k}: 未知キー`); }
+function req(o,k,at,out) { if (!o || typeof o !== 'object' || Array.isArray(o)) { out.push(`${at}: object が必要`); return; } if (!(k in o)) out.push(`${at}.${k}: 必須`); else if (o[k] === null) out.push(`${at}.${k}: null は不可`); }
+function str(v,at,out,min=1,max=Infinity) { if(typeof v!=='string'||v.length<min||v.length>max) out.push(`${at}: ${min}〜${max===Infinity?'':max}字の文字列が必要`); }
+function num(v,at,out,min,max,int=false) { if(typeof v!=='number'||!Number.isFinite(v)||(int&&!Number.isInteger(v))||v<min||v>max) out.push(`${at}: ${min}〜${max}の${int?'整数':'数値'}が必要（文字列は不可）`); }
+function id(v,at,out) { if(typeof v!=='string'||!idRE.test(v)) out.push(`${at}: ASCII ID が必要`); }
+function array(v,at,out) { if(!Array.isArray(v)) {out.push(`${at}: 配列が必要`);return false;} return true; }
+function duplicates(values, at, out) { const s=new Set; values.forEach((v,i)=>{if(s.has(v))out.push(`${at}[${i}]: ID 重複 ${v}`);s.add(v)}); }
+function validate(doc) {
+ const out=[]; checkKeys(doc,allowed.root,'$',out);
+ if(!doc||typeof doc!=='object'||Array.isArray(doc)) return out;
+ if(doc.kind!=='shosai-stage-sketch') out.push('$.kind: shosai-stage-sketch が必要');
+ if(doc.version!==4) out.push('$.version: 数値 4 が必要');
+ if(!Array.isArray(doc.venues)||doc.venues.length) out.push('$.venues: 空配列が必要');
+ const p=doc.project; checkKeys(p,allowed.project,'$.project',out); if(!p||typeof p!=='object'||Array.isArray(p)) return out;
+ req(p,'title','$.project',out); str(p.title,'$.project.title',out,1,60); req(p,'venue','$.project',out); if(!venues.includes(p.venue))out.push('$.project.venue: 許可会場ではない'); req(p,'venueSize','$.project',out); if(!['small','mid','large'].includes(p.venueSize))out.push('$.project.venueSize: small/mid/large が必要');
+ for(const k of ['cast','sets','scenes']) req(p,k,'$.project',out); const cast=array(p.cast,'$.project.cast',out)?p.cast:[]; const sets=array(p.sets,'$.project.sets',out)?p.sets:[]; const scenes=array(p.scenes,'$.project.scenes',out)?p.scenes:[];
+ const castIds=[],setIds=[],sceneIds=[],pieceIds=[];
+ cast.forEach((x,i)=>{const a=`$.project.cast[${i}]`;checkKeys(x,allowed.cast,a,out);for(const k of ['id','name','color'])req(x,k,a,out);id(x.id,`${a}.id`,out);castIds.push(x.id);str(x.name,`${a}.name`,out,1,24);if(!colorRE.test(x.color||''))out.push(`${a}.color: #rrggbb が必要`);if('heightCm'in x)num(x.heightCm,`${a}.heightCm`,out,120,210,true);if('note'in x)str(x.note,`${a}.note`,out,0,200);}); duplicates(castIds,'$.project.cast',out);
+ sets.forEach((x,i)=>{const a=`$.project.sets[${i}]`;checkKeys(x,allowed.set,a,out);for(const k of ['id','kind','name','color'])req(x,k,a,out);id(x.id,`${a}.id`,out);setIds.push(x.id);if(!SET_KINDS.includes(x.kind))out.push(`${a}.kind: stage-sketch.js の SET_KINDS にない`);str(x.name,`${a}.name`,out,1,24);if(!colorRE.test(x.color||''))out.push(`${a}.color: #rrggbb が必要`);if(x.kind==='light'&&x.lightKind!=='hang')out.push(`${a}.lightKind: light は hang 固定`);if(x.kind!=='light'&&'lightKind'in x)out.push(`${a}.lightKind: light 以外には不可`);}); duplicates(setIds,'$.project.sets',out);
