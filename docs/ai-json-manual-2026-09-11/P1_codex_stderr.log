  /* 表示はcm。内部はmのまま。
   * 家具や人の寸法は「1.6m」より「160cm」のほうが体に入る。
   * 劇場の間口は m のままにする（そちらは m で語る寸法なので）。 */
  const cmText = (m) => `${Math.round(m * 100)}cm`;
