  ];
  /* 寸法つまみの仕様。項目は種類ごとに違うので、画面はここから組み立てる。
   * HTMLへ固定で並べると、種類を足すたびに二箇所直すことになる。 */
  const DIM_META = {
    w: { label: "幅", min: 0.2, max: 12, step: 0.01 },
