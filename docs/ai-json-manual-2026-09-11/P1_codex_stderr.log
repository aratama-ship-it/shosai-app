+  {"kind":"scene","depth":1,"id":"scene-3","title":"視線の交差","note":"キンとミドリが机を挟む。観客には視線だけが中央を通る規則が見える。最後にレンが輪へ戻る。","beat":{"role":"展開","energy":3},"lightingIntent":{"objective":"二人の対角を残す","audienceFocus":"交差する視線","mood":"緊張"},"pieces":[{"id":"p-table-3","type":"table","setId":"set-table","u":0.5,"v":0.48,"color":"#80553b"},{"id":"p-gold-3","type":"performer","castId":"cast-gold","u":0.28,"v":0.34,"color":"#b88922","pose":"stand"},{"id":"p-green-3","type":"performer","castId":"cast-green","u":0.72,"v":0.68,"color":"#39745a","pose":"stand"}]},
+  {"kind":"scene","depth":1,"id":"scene-4","title":"中央の空白","note":"四人が外周で止まる。観客には誰も中央へ入らない規則が明確になる。最後に明かりだけが中央へ落ちる。","beat":{"role":"ため","energy":2},"lightingIntent":{"objective":"空白を見せる","audienceFocus":"中央の床","mood":"停止"},"pieces":[{"id":"p-light-b-4","type":"light","setId":"set-light-b","u":0.5,"v":0.48,"color":"#d8e8ff"},{"id":"p-red-4","type":"performer","castId":"cast-red","u":0.15,"v":0.78,"color":"#b43b4a","pose":"stand"},{"id":"p-blue-4","type":"performer","castId":"cast-blue","u":0.85,"v":0.78,"color":"#315b8a","pose":"sit"}]},
+  {"kind":"section","depth":0,"id":"section-2","title":"越える"},
+  {"kind":"scene","depth":1,"id":"scene-5","title":"上を見上げる","note":"トラピーズは検討用の図であり、安全未確認。四人が床から上を見上げる。観客には上方を共有する変化が見える。","beat":{"role":"転換","energy":4},"lightingIntent":{"objective":"上方の余白を示す","audienceFocus":"四人の視線","mood":"高揚"},"pieces":[{"id":"p-trapeze-5","type":"trapeze","setId":"set-trapeze","u":0.5,"v":0.28,"color":"#8c8c92"},{"id":"p-red-5","type":"performer","castId":"cast-red","u":0.27,"v":0.7,"color":"#b43b4a","pose":"stand"},{"id":"p-blue-5","type":"performer","castId":"cast-blue","u":0.73,"v":0.7,"color":"#315b8a","pose":"stand"}]},
