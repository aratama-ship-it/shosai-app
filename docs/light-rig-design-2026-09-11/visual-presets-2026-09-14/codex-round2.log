71:  function borderPieces() {
#!/usr/bin/env node
// WCAG 2.x コントラスト比の計算（design-webスキル用）
// 使い方: node contrast.mjs "#文字色" "#背景色" [ "#文字色2" "#背景色2" ... ]
// 判定: AA本文=4.5:1以上 / AA大きな文字・UI部品=3:1以上（WCAG 2.x）

function relLum(hex) {
  let h = hex.replace(/^#/, "");
  if (h.length === 3) h = h.split("").map((c) => c + c).join("");
  if (!/^[0-9a-fA-F]{6}$/.test(h)) {
    console.error(`不正な色指定: ${hex}（#RGB か #RRGGBB で指定）`);
    process.exit(1);
  }
  const [r, g, b] = [0, 2, 4]
    .map((i) => parseInt(h.slice(i, i + 2), 16) / 255)
    .map((v) => (v <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4));
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
}

const args = process.argv.slice(2);
if (args.length < 2 || args.length % 2 !== 0) {
  console.error('使い方: node contrast.mjs "#文字色" "#背景色" [ペアを追加可]');
  process.exit(1);
}

for (let i = 0; i < args.length; i += 2) {
  const [fg, bg] = [args[i], args[i + 1]];
  const [l1, l2] = [relLum(fg), relLum(bg)];
  const ratio = (Math.max(l1, l2) + 0.05) / (Math.min(l1, l2) + 0.05);
  const r = Math.round(ratio * 100) / 100;
  const aaBody = ratio >= 4.5 ? "OK" : "NG";
  const aaLarge = ratio >= 3 ? "OK" : "NG";
  console.log(`${fg} on ${bg}: ${r}:1  AA本文(4.5): ${aaBody}  AA大文字/UI(3.0): ${aaLarge}`);
}

