- cue: `lights[fixtureId]{on,color,surface:"floor"|"back",path:{kind:"still",a}|{kind:"line",a,b,start}|{kind:"circle",c,r,dir,start},speed,groupId}`、`groups[{id,members,relation:"together"|"mirror"|"sequential",delayMs,compose:"fan"|"cross"}]`。
