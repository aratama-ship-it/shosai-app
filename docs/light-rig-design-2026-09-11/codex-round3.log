  const makeFrontProjector = (dims, box) => {
    const sx = box.w / dims.W, sz = box.h / dims.H;
    return (p) => ({ X: box.x + (p.x + dims.W / 2) * sx, Y: box.y + box.h - p.z * sz });
  };

