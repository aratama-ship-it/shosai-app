      r.innerHTML = `<span class="no">${idx !== undefined ? idx + 1 + "." : ""}${label(f.id)}</span><span class="nm">${f.name || "名前なし"}<small>${E.describeMount(f, state.rig).replace(/（高さ約\dm）/, "")}</small></span><span class="st ${st}">${state.mode === "move" ? STATE_LABEL[st] : ""}</span>`;
      r.onclick = (ev) => { if (ev.shiftKey) { isSel(f.id) ? state.sel.delete(f.id) : state.sel.add(f.id); } else state.sel = new Set([f.id]); if (f.mount.type === "truss") state.selTruss = f.mount.trussId; renderAll(); }; return r; };
    if (state.mode === "move") c.groups.forEach((g, gi) => { const h = document.createElement("div"); h.className = "grp"; h.innerHTML = `<span>組${gi + 1}　${groupName(g)}</span><small>${g.members.length}灯</small>`; h.onclick = () => { state.sel = new Set(g.members); renderAll(); }; host.append(h); g.members.forEach((m, i) => { const f = fixtureById(m); if (f) host.append(row(f, g.relation === "sequential" ? i : undefined)); }); });
    const rest = state.rig.fixtures.filter((f) => state.mode !== "move" || !grouped.has(f.id));
    if (rest.length && state.mode === "move" && c.groups.length) { const h = document.createElement("div"); h.className = "grp"; h.innerHTML = "<span>組なし</span>"; host.append(h); }
    rest.forEach((f) => host.append(row(f)));
    if (!state.rig.fixtures.length) host.innerHTML = '<p class="hint" style="padding:6px">灯体はまだありません。</p>';
    $("sel-count").textContent = state.sel.size > 1 ? `${state.sel.size}灯を選択中` : "";
    $("dup").disabled = !(state.mode === "place" && state.sel.size); $("del").disabled = !(state.mode === "place" && state.sel.size); $("spread").disabled = !(state.mode === "place" && canSpread());
    $("spread").title = canSpread() ? "" : "同じトラスの3灯以上を選ぶと使えます";
  }

  /* ---------- 右: 設定欄 ---------- */
  const seg = (opts, cur, onPick, cls) => { const s = document.createElement("div"); s.className = "seg " + (cls || ""); opts.forEach(([v, t, dis]) => { const b = document.createElement("button"); b.type = "button"; b.textContent = t; b.setAttribute("aria-pressed", String(v === cur)); b.disabled = Boolean(dis); b.onclick = () => onPick(v); s.append(b); }); return s; };
  const field = (lab, node, wide) => { const f = document.createElement("div"); f.className = "field" + (wide ? " wide" : ""); const l = document.createElement("span"); l.textContent = lab; f.append(l, node); return f; };
  const btn = (t, fn, cls) => { const b = document.createElement("button"); b.type = "button"; b.className = "btn " + (cls || ""); b.textContent = t; b.onclick = fn; return b; };
  const el = (tag, cls, html) => { const e = document.createElement(tag); if (cls) e.className = cls; if (html !== undefined) e.innerHTML = html; return e; };
  const range = (min, max, step, val, fmt, onInput, onChange) => { const w = el("div"); const i = document.createElement("input"); i.type = "range"; i.min = min; i.max = max; i.step = step; i.value = val; const v = el("span", "val", fmt(val)); i.oninput = () => { v.textContent = fmt(Number(i.value)); onInput(Number(i.value)); }; i.onchange = () => onChange && onChange(Number(i.value)); w.append(i, v); return w; };

  function renderInspector() {
    const host = $("insp"); host.innerHTML = "";
    const ids = [...state.sel];
    if (state.mode === "place") {
      host.append(el("p", "kicker", "配置（ショー共通）"), el("p", "hint", "配置はすべてのシーンで共通です。"));
      const tools = el("div", "seg col");
      [["truss", "トラスを足す"], ["fixture", "灯体を足す（トラスに）", !state.selTruss], ["floor", "灯体を床に置く"], ["side", "灯体を横に置く（上手／下手）"]].forEach(([k, t, dis]) => { const b = document.createElement("button"); b.type = "button"; b.textContent = state.tool === k ? "配置を終える（Esc）" : t; b.setAttribute("aria-pressed", String(state.tool === k)); b.disabled = Boolean(dis); b.onclick = () => { state.tool = state.tool === k ? null : k; renderAll(); }; tools.append(b); });
      host.append(tools);
      if (!state.selTruss) host.append(el("p", "note", "トラスを選ぶと「灯体を足す（トラスに）」が使えます。"));
      if (!state.selTruss) host.append(el("p", "note", "トラスを選ぶと「灯体を足す（トラスに）」が使えます。"));
      if (state.tool === "side") host.append(el("p", "note", "下の側面図（下手を見る／上手を見る）をクリックすると、その奥行きと高さにスタンド灯を置けます。平面図の舞台の外側をクリックしても置けます。"));
      const t = E.trussById(state.rig, state.selTruss);
      if (t && !ids.length) {
        host.append(el("p", "kicker", `トラス（奥から${E.trussRow(state.rig, t.id)}列目）`));
        const name = document.createElement("input"); name.type = "text"; name.value = t.label; name.placeholder = "名前（任意）"; name.onchange = () => { t.label = name.value.slice(0, 16); commit(); }; host.append(field("名前", name));
        host.append(field("奥行き", range(0, 1, 0.01, t.v, (v) => `${(v * state.dims.D).toFixed(1)}m（奥から）`, (v) => { t.v = v; draw(); }, () => commit())));
        host.append(field("高さ", range(2, state.dims.H, 0.1, t.h, (v) => `約${v.toFixed(1)}m${t.tentative ? "（仮の高さ）" : ""}`, (v) => { t.h = v; t.tentative = false; draw(); }, () => commit())));
        host.append(btn("このトラスに灯体を足す", () => { state.tool = "fixture"; renderAll(); }, "primary"));
        host.append(btn("トラスを削除", () => { const n = state.rig.fixtures.filter((f) => f.mount.trussId === t.id).length; const go = () => { state.rig.fixtures = state.rig.fixtures.filter((f) => f.mount.trussId !== t.id); state.rig.trusses = state.rig.trusses.filter((x) => x.id !== t.id); state.selTruss = null; state.sel.clear(); commit("トラスを削除しました"); }; n ? dialog(`<p>このトラスには${n}灯が付いています。灯体ごと削除しますか？</p>`, [["やめる", null, "quiet"], ["灯体ごと削除", go, "primary"]]) : go(); }, "quiet"));
      }
      if (ids.length === 1) {
        const f = fixtureById(ids[0]); const m = f.mount;
        host.append(el("p", "kicker", `${label(f.id)}　${E.describeMount(f, state.rig)}`));
        const name = document.createElement("input"); name.type = "text"; name.value = f.name; name.placeholder = "例: 中央ムービング"; name.onchange = () => { f.name = name.value.slice(0, 20); commit(); }; host.append(field("名前", name));
        if (m.type === "truss") { const sel = document.createElement("select"); state.rig.trusses.forEach((tt) => { const o = document.createElement("option"); o.value = tt.id; o.textContent = `奥から${E.trussRow(state.rig, tt.id)}列目${tt.label ? "・" + tt.label : ""}`; o.selected = tt.id === m.trussId; sel.append(o); }); sel.onchange = () => { m.trussId = sel.value; state.selTruss = sel.value; commit(); }; host.append(field("取り付けるトラス", sel));
          host.append(field("横位置", range(0, 1, 0.01, m.u, (v) => (v < 0.4 ? "下手寄り" : v > 0.6 ? "上手寄り" : "中央"), (v) => { m.u = v; draw(); }, () => commit())));
          const tt = E.trussById(state.rig, m.trussId); host.append(field("高さ", el("span", "val", `約${tt ? tt.h.toFixed(1) : "?"}m（トラスから継承）`))); }
        if (m.type === "floor") { host.append(field("横位置", range(0, 1, 0.01, m.u, (v) => (v < 0.4 ? "下手寄り" : v > 0.6 ? "上手寄り" : "中央"), (v) => { m.u = v; draw(); }, () => commit()))); host.append(field("奥行き", range(0, 1, 0.01, m.v, (v) => (v < 0.4 ? "奥" : v > 0.6 ? "手前" : "中ほど"), (v) => { m.v = v; draw(); }, () => commit()))); host.append(field("高さ", el("span", "val", "床置き"))); }
        if (m.type === "side") { host.append(field("取り付け", seg([["shimote", "下手側"], ["kamite", "上手側"]], m.side, (v) => { m.side = v; commit(); }))); host.append(field("奥行き", range(0, 1, 0.01, m.v, (v) => (v < 0.4 ? "奥寄り" : v > 0.6 ? "手前寄り" : "中ほど"), (v) => { m.v = v; draw(); }, () => commit()))); host.append(field("高さ", range(0.3, state.dims.H, 0.1, m.h, (v) => `約${v.toFixed(1)}m`, (v) => { m.h = v; draw(); }, () => commit()))); }
        const acts = el("div", "seg"); acts.append(btn("複製", duplicateSelected, "small"), btn("削除", removeSelected, "small quiet")); host.append(acts);
      } else if (ids.length > 1) {
        host.append(el("p", "kicker", `${ids.length}灯を選択中`));
        const acts = el("div", "seg"); acts.append(btn("複製", duplicateSelected, "small"), btn("削除", removeSelected, "small quiet")); host.append(acts);
        const sp = btn("等間隔に並べる", spreadSelected, "small"); sp.disabled = !canSpread(); host.append(sp); if (!canSpread()) host.append(el("p", "note", "同じトラスの3灯以上を選ぶと使えます。"));
      }
      host.append(el("p", "note", "動きは「動き（このシーン）」で設定します。"));
      return;
    }
    // ---- 動きモード ----
    host.append(el("p", "kicker", `動き（シーン「${scene().name}」）`), el("p", "hint", "現在のシーンだけの点灯と動きを設定します。"));
    if (!ids.length) { host.append(el("p", "note", "灯体を選んでください（一覧・平面図・正面図のどこからでも）。Shiftで複数選ぶと組にできます。")); return; }
    if (ids.length === 1) {
      const fid = ids[0]; const f = fixtureById(fid); const l = lightOf(fid);
      host.append(el("p", "kicker", `${label(fid)}　${f.name || ""}`));
      const g = groupOf(fid);
      if (g) { const gi = cue().groups.indexOf(g); const box = el("div", "box", `<p class="hint">組${gi + 1}「${groupName(g)}」の一員です。個別に直すと「調整済み」になります。</p>`); box.append(btn("組から外す", () => ungroup(fid), "small quiet")); host.append(box); }
      if (!l || l.on === null || l.on === undefined) { host.append(el("p", "note", "このシーンでは未設定です。")); const s = el("div", "seg"); s.append(btn("点灯を設定", () => { ensureOn(fid); commit(); }, "primary"), btn("消灯を設定", () => { setLight(fid, { on: false }); commit(); }, "quiet")); host.append(s); return; }
      if (l.on === false) { host.append(el("p", "note", "このシーンでは消灯です。")); const s = el("div", "seg"); s.append(btn("点灯にする", () => { ensureOn(fid); commit(); }), btn("設定を外す", () => { delete cue().lights[fid]; commit(); }, "quiet")); host.append(s); return; }
      const sw = el("div", "swatches"); COLORS.forEach((c) => { const b = document.createElement("button"); b.type = "button"; b.style.background = c; b.setAttribute("aria-pressed", String(l.color === c)); b.onclick = () => { setLight(fid, { color: c }); commit(); }; sw.append(b); }); host.append(field("光の色", sw));
      host.append(field("当てる場所", seg([["floor", "床"], ["back", "奥の壁"]], l.surface, (v) => { setLight(fid, { surface: v }); commit(); })));
      const p = l.path || { kind: "still" };
      host.append(field("動き", seg([["still", "止める"], ["line", "往復"], ["circle", "円"]], p.kind, (v) => { setKind(fid, v); commit(); })));
      if (p.kind === "line") { host.append(field("始め方", seg([["a", "A → B"], ["b", "B → A"]], p.start || "a", (v) => { p.start = v; commit(); }))); host.append(el("p", "note", `動く範囲は図のA・Bをドラッグ。${l.surface === "back" ? "奥の壁は正面図で。" : "床は平面図で。"}`)); }
      if (p.kind === "circle") { host.append(field("回る向き", seg([["cw", "時計回り"], ["ccw", "反時計回り"]], p.dir, (v) => { p.dir = v; commit(); }))); host.append(field("半径", range(0.3, state.dims.W / 2, 0.1, p.r, (v) => `約${v.toFixed(1)}m`, (v) => { p.r = v; draw(); }, () => commit()))); host.append(field("始める位置", range(0, 1, 0.05, p.start || 0, (v) => `${Math.round(v * 360)}°`, (v) => { p.start = v; draw(); }, () => commit()))); }
      if (p.kind === "still") host.append(el("p", "note", "当てる先は図のハンドルをドラッグ。"));
      if (p.kind !== "still") host.append(field(p.kind === "circle" ? "1周の時間" : "1往復の時間", seg([["slow", "ゆっくり 4秒"], ["normal", "普通 2秒"], ["fast", "速い 1秒"]], l.speed, (v) => { setLight(fid, { speed: v }); commit(); })));
      const s = el("div", "seg"); s.append(btn("消灯にする", () => { setLight(fid, { on: false }); commit(); }, "small quiet"), btn("設定を外す", () => { delete cue().lights[fid]; commit(); }, "small quiet")); host.append(s);
      return;
    }
    // 複数
    host.append(el("p", "kicker", `${ids.length}灯を選択中`));
    const gs = [...new Set(ids.map((id) => groupOf(id)).filter(Boolean))];
    const same = gs.length === 1 && gs[0].members.length === ids.length && ids.every((id) => gs[0].members.includes(id));
    if (same) { const g = gs[0]; const gi = cue().groups.indexOf(g); host.append(el("p", "hint", `組${gi + 1}「${groupName(g)}」を編集中`));
      host.append(field("組の動き", seg([["together", "一緒に動く"], ["mirror", "鏡のように動く"], ["sequential", "順番に動く"], ["fan", "扇に開く・閉じる"], ["cross", "交差して入れ替わる"]], g.compose || g.relation, (v) => makeGroup(g.members, v), "col"), true));
      if (g.relation === "sequential") host.append(field("ずらす時間", range(100, 1500, 50, g.delayMs, (v) => `${(v / 1000).toFixed(2)}秒ずつ`, (v) => { g.delayMs = v; draw(); }, () => commit())));
      host.append(el("p", "note", "順番に動くときは、一覧の並び（1・2・3…）が実際の順番です。"));
      const ol = el("div", "seg col"); g.members.forEach((m, i) => { const b = document.createElement("button"); b.type = "button"; b.textContent = `${i + 1}. ${label(m)} ${fixtureById(m).name || ""}${i > 0 ? "　▲ 前へ" : ""}`; b.onclick = () => { if (i > 0) { [g.members[i - 1], g.members[i]] = [g.members[i], g.members[i - 1]]; commit(); } }; ol.append(b); }); host.append(field("この組の灯体", ol, true));
      host.append(btn("組を解散する", () => { cue().groups = cue().groups.filter((x) => x !== g); g.members.forEach((m) => setLight(m, { groupId: null })); commit("組を解散しました"); }, "small quiet"));
    } else {
      host.append(el("p", "hint", "選んだ灯体で組の動きをつくる"));
      host.append(field("組の動き", seg([["together", "一緒に動く"], ["mirror", "鏡のように動く"], ["sequential", "順番に動く"], ["fan", "扇に開く・閉じる"], ["cross", "交差して入れ替わる"]], null, (v) => makeGroup(ids, v), "col"), true));
      host.append(el("p", "note", "未設定の灯は「点灯」にしてから組にします。一灯ずつの調整は組にした後もできます。"));
    }
  }

  /* ---------- 全体 ---------- */
  function renderAll() {
    $("mode-place").setAttribute("aria-pressed", String(state.mode === "place")); $("mode-move").setAttribute("aria-pressed", String(state.mode === "move"));
    $("scene-name").textContent = `シーン ${state.sceneIndex + 1}「${scene().name}」`;
    $("transport").style.visibility = state.mode === "move" ? "visible" : "hidden";
    $("empty").hidden = Boolean(state.rig.trusses.length || state.rig.fixtures.length);
    $("dirty").textContent = state.dirty ? "未適用の変更あり" : ""; $("dirty").classList.toggle("ok", !state.dirty);
    $("undo").disabled = !state.history.length; $("redo").disabled = !state.future.length;
    // 断面図の向き: 横の灯体を選んだらその側、奥壁を編集中は正面。手動で選んだ向きは次の選択変更まで保つ
    const selFix = [...state.sel].map(fixtureById).filter(Boolean);
    const sideSel = selFix.find((f) => f.mount.type === "side");
    const back = state.mode === "move" && [...state.sel].some((id) => (lightOf(id) || {}).surface === "back");
    const selKey = [...state.sel].sort().join(",") + "|" + state.tool;
    if (selKey !== state.lastSelKey) { state.lastSelKey = selKey; state.viewPinned = false; }
    if (!state.viewPinned) { if (sideSel) state.view = sideSel.mount.side; else if (back) state.view = "front"; else if (state.tool === "side" && state.view === "front") state.view = "shimote"; else if (state.tool !== "side" && !sideSel) state.view = "front"; }
    document.querySelectorAll(".viewtabs button").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.view === state.view)));
    const big = (back && state.view === "front") || state.view !== "front";
    front.classList.toggle("big", big); front.height = big ? 480 : 300; plan.style.height = big ? "292px" : "382px";
    $("legend-l").textContent = state.view === "front" ? "平面図（上が奥・下が客席）／正面図（客席から）" : `平面図（上が奥・下が客席）／${state.view === "shimote" ? "下手" : "上手"}を見た側面図（横軸＝奥行き・縦軸＝高さ）`;
    $("legend-r").textContent = state.mode === "move" ? "実線＝いまの光　破線＝動く範囲　●A/B＝ドラッグ" : "■トラス灯　●床置き　◆横（スタンド・ブーム）";
    renderList(); renderInspector(); renderTransport(); draw();
  }

  /* ---------- ヘッダ・空状態・書き出し ---------- */
  $("mode-place").onclick = () => { state.mode = "place"; stop(); renderAll(); };
  $("mode-move").onclick = () => { state.mode = "move"; state.tool = null; renderAll(); };
  $("scene-prev").onclick = () => { state.sceneIndex = (state.sceneIndex + state.scenes.length - 1) % state.scenes.length; home(); renderAll(); };
  $("scene-next").onclick = () => { state.sceneIndex = (state.sceneIndex + 1) % state.scenes.length; home(); renderAll(); };
  $("t-home").onclick = home; $("t-play").onclick = play; $("t-stop").onclick = () => stop();
  $("undo").onclick = undo; $("redo").onclick = redo;
  $("sel-all").onclick = () => { state.sel = new Set(state.rig.fixtures.map((f) => f.id)); renderAll(); };
  $("sel-none").onclick = () => { state.sel.clear(); renderAll(); };
  $("dup").onclick = duplicateSelected; $("del").onclick = removeSelected; $("spread").onclick = spreadSelected;
  $("empty-truss").onclick = () => { state.tool = "truss"; $("empty").hidden = true; renderAll(); $("empty").hidden = true; };
  $("empty-preset").onclick = () => dialog("<p>奥トラス1本（高さ約6m）に、ムービング4灯を等間隔に置きます。</p><p class='note'>置いたあとで位置と灯数を変えられます。</p>", [["やめる", null, "quiet"], ["置く", () => { const t = E.newTruss(uid("t"), 0.15, 6, "奥トラス"); state.rig.trusses.push(t); [0.2, 0.4, 0.6, 0.8].forEach((u) => state.rig.fixtures.push(E.newFixture(uid("f"), state.nextNo++, { type: "truss", trussId: t.id, u }, ""))); state.selTruss = t.id; state.sel.clear(); commit("奥トラス1本＋ムービング4灯を置きました"); }, "primary"]]);
  $("apply").onclick = () => { state.dirty = false; state.history.length = 0; state.future.length = 0; renderAll(); $("dirty").textContent = "ショーへ適用しました"; setTimeout(() => renderAll(), 2500); toast("ショーへ適用しました（試作なので画面は残ります）"); };
  $("close").onclick = () => { if (state.dirty) dialog("<p>変更がまだ適用されていません。</p>", [["編集に戻る", null, "quiet"], ["破棄して閉じる", () => toast("破棄しました（試作なので画面は残ります）"), "quiet"], ["適用して閉じる", () => $("apply").onclick(), "primary"]]); else toast("閉じました（試作なので画面は残ります）"); };

  // 書き出し: 平面図を4秒録画（順0で検証した方式）＋3コマPNG＋灯ごとの説明
  let exportCancel = false;
  $("band-cancel").onclick = () => { exportCancel = true; };
  $("export").onclick = async () => {
    if (state.exporting) return; const lit = state.rig.fixtures.filter((f) => (lightOf(f.id) || {}).on === true); if (!lit.length) { toast("点灯している灯がありません。動きモードで点灯を設定してください。"); return; }
    state.exporting = true; exportCancel = false; stop(); state.mode = "move"; renderAll();
    const band = $("band"), bar = $("band-bar"); band.hidden = false; $("band-text").textContent = "動画を書き出しています　この画面を開いたままにしてください。";
    const base = `light-rig-${scene().name}`;
    try {
      const mime = ["video/mp4;codecs=avc1", "video/mp4", "video/webm;codecs=vp9", "video/webm"].find((t) => typeof MediaRecorder !== "undefined" && MediaRecorder.isTypeSupported(t));
      if (mime) {
        const stream = plan.captureStream(0); const track = stream.getVideoTracks()[0]; const rec = new MediaRecorder(stream, { mimeType: mime, videoBitsPerSecond: 5e6 }); const chunks = [];
        rec.ondataavailable = (e) => { if (e.data.size) chunks.push(e.data); }; const done = new Promise((r) => { rec.onstop = r; rec.onerror = r; });
        const DUR = 4000; let t = 0; rec.start(250);
        await new Promise((r) => { const timer = setInterval(() => { if (exportCancel || t > DUR) { clearInterval(timer); rec.stop(); r(); return; } state.play.t = t; draw(); track.requestFrame && track.requestFrame(); bar.style.width = `${Math.min(100, t / DUR * 100)}%`; t += 33; }, 33); });
        await done;
        if (!exportCancel && chunks.length) download(new Blob(chunks, { type: mime.split(";")[0] }), `${base}.${mime.startsWith("video/mp4") ? "mp4" : "webm"}`);
      }
      if (!exportCancel) {
