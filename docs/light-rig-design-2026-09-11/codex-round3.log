    if (path.kind === "line") return { kind: "line", a: surfacePoint(light.surface, path.a, dims), b: surfacePoint(light.surface, path.b, dims) };
    if (path.kind === "circle") return { kind: "circle", c: surfacePoint(light.surface, path.c, dims), r: clamp(finite(path.r, 1.5), 0.2, 20), surface: light.surface };
