<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>試作: 照明を組む — 舞台スケッチ（判断用・製品ではない）</title>
<style>
  :root{
    --desk:#191512;--desk-2:#201b16;--desk-3:#282119;--line-dark:#382f25;
    --milk:#efe7d6;--milk-dim:rgba(240,231,214,.55);--brass:#9c823f;--rust:#a84b26;--rust-ink:#df6433;
    --recess:rgba(13,12,11,.3);--sans:"Hiragino Kaku Gothic ProN","Hiragino Sans","Yu Gothic",sans-serif;--serif:"Hiragino Mincho ProN","Yu Mincho",serif;
  }
  *{box-sizing:border-box}
  [hidden]{display:none !important}
  html,body{margin:0;background:#0d0b09;color:var(--milk);font-family:var(--sans);font-size:12px;line-height:1.5}
  body{min-height:100vh;display:grid;place-items:center;padding:20px}
  .proto-note{position:fixed;left:14px;top:10px;font-size:10px;color:var(--milk-dim);letter-spacing:.06em}
  /* ---- モーダル外枠（本体 .stage-modal の語彙） ---- */
  .modal{width:min(1180px,calc(100vw - 40px));height:min(840px,calc(100vh - 40px));background:var(--desk-2);border:1px solid var(--line-dark);box-shadow:0 24px 60px rgba(0,0,0,.5);display:grid;grid-template-rows:60px minmax(0,1fr);overflow:hidden}
  .head{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:16px;padding:0 16px;border-bottom:1px solid var(--line-dark)}
  .head h1{margin:0;font:500 15px/1 var(--serif);letter-spacing:.08em;color:var(--milk)}
  .modes{display:inline-flex;justify-self:center}
  .modes button{min-height:34px;padding:6px 16px;border:1px solid var(--line-dark);background:var(--recess);color:var(--milk-dim);font-size:12px;cursor:pointer}
  .modes button+button{margin-left:-1px}
  .modes button[aria-pressed="true"]{color:var(--milk);border-color:var(--brass);background:rgba(156,130,63,.22)}
  .head-right{display:flex;align-items:center;gap:10px}
  .dirty{font-size:10.5px;color:var(--rust-ink);letter-spacing:.06em;min-width:9em;text-align:right}
  .dirty.ok{color:var(--brass)}
  .btn{min-height:34px;padding:6px 14px;border:1px solid var(--line-dark);background:none;color:var(--milk);font-size:12px;cursor:pointer;letter-spacing:.06em;border-radius:1px}
  .btn:hover{border-color:var(--brass)}
  .btn.primary{border-color:var(--brass);background:rgba(156,130,63,.18)}
  .btn.quiet{color:var(--milk-dim)}
  .btn:disabled{opacity:.35;cursor:default}
  .btn.small{min-height:28px;padding:3px 9px;font-size:10.5px}
  .x{min-width:26px;min-height:24px;border:1px solid var(--line-dark);background:none;color:var(--milk-dim);font-size:11px;cursor:pointer}
  /* ---- 本文3列 ---- */
  .body{display:grid;grid-template-columns:196px minmax(0,636px) 292px;gap:12px;padding:12px 16px 14px;min-height:0}
  .col{min-height:0;display:flex;flex-direction:column;gap:8px}
  .box{border:1px solid var(--line-dark);background:rgba(25,21,18,.45);padding:10px}
  .kicker{color:var(--brass);font-size:9px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;margin:0 0 6px}
  .hint{color:var(--milk-dim);font-size:10px;line-height:1.6;margin:0}
  /* 左: 一覧 */
  .list{flex:1;min-height:0;overflow:auto;display:flex;flex-direction:column;gap:2px;padding:6px}
  .row{display:grid;grid-template-columns:28px 1fr auto;gap:6px;align-items:center;min-height:36px;padding:2px 6px;border:1px solid transparent;cursor:pointer;color:var(--milk-dim)}
  .row:hover{border-color:var(--line-dark)}
  .row.sel{border-color:var(--brass);background:rgba(156,130,63,.16);color:var(--milk)}
  .row .no{font:600 11px/1 var(--sans);color:var(--milk);background:var(--desk-3);padding:5px 0;text-align:center;border:1px solid var(--line-dark)}
  .row.sel .no{background:var(--brass);color:#1a1409;border-color:var(--brass)}
  .row .nm{font-size:11px;line-height:1.25;overflow:hidden}
  .row .nm small{display:block;font-size:9px;color:var(--milk-dim)}
  .row .st{font-size:9px;letter-spacing:.04em;white-space:nowrap}
  .row .st.unset{color:var(--milk-dim)} .row .st.off{color:#8b98a1} .row .st.on{color:var(--milk)} .row .st.move{color:var(--rust-ink)}
  .grp{margin:6px 0 2px;padding:3px 6px;font-size:10px;color:var(--brass);border-bottom:1px solid var(--line-dark);display:flex;justify-content:space-between;align-items:center}
  .grp small{color:var(--milk-dim);font-size:9px}
  .list-actions{display:grid;grid-template-columns:1fr 1fr;gap:4px}
  .list-actions .btn{min-height:30px;padding:3px 6px;font-size:10.5px}
  /* 中央 */
  .scenebar{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:8px;min-height:32px}
  .scenebar .name{text-align:center;font-family:var(--serif);font-size:12px;color:var(--milk)}
  .transport{display:flex;align-items:center;gap:6px;justify-content:center;min-height:32px}
  .transport .t{font-variant-numeric:tabular-nums;color:var(--brass);min-width:5em;text-align:right}
  .transport .playing{color:var(--milk);background:rgba(168,75,38,.28);border:1px solid var(--rust);padding:2px 8px;font-size:10.5px}
  .canvases{position:relative;flex:1;min-height:0;display:flex;flex-direction:column;gap:6px}
  canvas{display:block;width:100%;background:#0d0e10;border:1px solid var(--line-dark);cursor:crosshair;touch-action:none}
  #plan{height:382px} #front{height:150px} #front.big{height:240px}
  .viewtabs{display:inline-flex}
  .viewtabs button{min-height:26px;padding:2px 10px;border:1px solid var(--line-dark);background:var(--recess);color:var(--milk-dim);font-size:10px;cursor:pointer}
  .viewtabs button+button{margin-left:-1px}
  .viewtabs button[aria-pressed="true"]{color:var(--milk);border-color:var(--brass);background:rgba(156,130,63,.22)}
