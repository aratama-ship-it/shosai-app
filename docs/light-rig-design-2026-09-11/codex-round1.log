  const ORIGIN_Y = 0.12;
  const TARGET_Y = 0.84;
  const CIRCLE_CENTER_Y = 0.58;

  /* 各灯の出どころ(x0,y0)と、いまの一瞬の光の先(x1,y1)を正規化座標(0..1)で返す。
