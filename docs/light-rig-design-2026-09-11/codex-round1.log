    return venues.reduce((maximum, venue) => {
      const match = venue && typeof venue.id === "string" ? venue.id.match(/^custom-room-(\d+)$/) : null;
      return match ? Math.max(maximum, Number(match[1])) : maximum;
    }, 0) + 1;
