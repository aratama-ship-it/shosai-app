      const slot = `${piece.heldBy}:${piece.holdMode === "face" ? "face" : piece.holdSide === "L" ? "L" : "R"}`;
      if (!holder || holder.type !== "performer" || !isHoldable(piece, project) || occupied.has(slot)) {
