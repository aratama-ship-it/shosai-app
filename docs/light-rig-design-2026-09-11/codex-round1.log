      const track = stream.getVideoTracks && stream.getVideoTracks()[0];
      let rec;
      try { rec = new MediaRecorder(stream, { mimeType: mime, videoBitsPerSecond: 4_000_000 }); }
      catch (_) { resolve(null); return; }
