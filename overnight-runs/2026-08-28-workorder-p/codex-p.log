      if (prop === "measureText") return (text) => ({ width: String(text).length * 8 });
      if (prop === "getImageData") return () => ({ data: new Uint8ClampedArray(4) });
      if (!(prop in target)) target[prop] = noop;
      return target[prop];
    },
