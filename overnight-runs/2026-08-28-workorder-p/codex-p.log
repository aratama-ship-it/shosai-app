  /* 演者・舞台セット・光は「出るもの」一枚にまとめた（cast）。
   * 登録・出し入れ・寸法の仕組みが同じものを三つに割ると、目が三度行き来する。 */
  const PANELS = ["project", "music", "cast", "machinery", "rigs", "light", "background", "study", "scenes", "inspector", "save", "ask"];

  function defaultLayout() {
    return {
