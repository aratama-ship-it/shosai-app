    for (let i = rows.indexOf(scene) - 1; i >= 0; i -= 1) {
      const p = (rows[i].pieces || []).find((q) => q.castId === member.id);
      if (!p) continue;   // このシーンにも居ない。さらに前を見る
      if (p.route && !onStageArea(p.route.u, p.route.v)) return { u: p.route.u, v: p.route.v };
