  html.stage-phone-viewer .stage-board-frame {
    width: 100%;
  }
}

@media (orientation: landscape) {
  html.stage-phone-viewer .stage-board-column {
    grid-template-columns: minmax(0, 1fr) 64px;
    /* 音楽帯を取り除いたぶん、図が縦いっぱいを使う（2026-08-24） */
    grid-template-rows: minmax(0, 1fr);
  }

  /* 横向きは縦の余白が図に要る。題は縦向きだけの贅沢（2026-08-26 本人判断）。 */
  html.stage-phone-viewer .stage-phone-title { display: none; }

  /* メモ欄も縦向きだけ（本人指示が「縦画面の場合は」）。 */
  html.stage-phone-viewer .stage-phone-memo { display: none; }

  /* ★横向きだけは、情報・ショーのパネルを今までどおり図の上へ重ねる。
     横向きには押し下げる余白が無く、流し込むと図が画面の下へ出てしまうため。
     右の64pxは道具のレールなので、その分を避けて置く。 */
  html.stage-phone-viewer .stage-phone-info,
  html.stage-phone-viewer .stage-phone-source,
  html.stage-phone-viewer .stage-phone-settings {
    position: fixed;
    grid-row: auto;
    top: calc(max(0px, env(safe-area-inset-top)) + 8px);
    left: max(8px, env(safe-area-inset-left));
    right: calc(64px + max(8px, env(safe-area-inset-right)));
    border: 1px solid var(--line-dark);
    box-shadow: 0 12px 28px rgba(0,0,0,0.55);
  }
  html.stage-phone-viewer .stage-phone-info { z-index: 30; }
  html.stage-phone-viewer .stage-phone-source { z-index: 31; }
  html.stage-phone-viewer .stage-phone-settings { z-index: 32; }

  /* 保存の警告も、レールを避けた位置へ（縦向きの82pxは題＋道具の分）。 */
  html.stage-phone-viewer .stage-phone-save-notice {
    top: calc(max(0px, env(safe-area-inset-top)) + 8px);
    right: calc(64px + max(8px, env(safe-area-inset-right)));
  }

  /* 横向きは一段組みなので、縦向きで付けた段の指定を戻す（暗黙の段が生まれるのを防ぐ）。 */
  html.stage-phone-viewer .stage-canvas-stack { grid-row: 1; }

  html.stage-phone-viewer .stage-phone-toolbar {
    grid-column: 2;
    grid-row: 1 / -1;
    display: flex;
    flex-direction: column;
    width: 64px;
    height: 100%;
    border-bottom: 0;
    border-left: 1px solid var(--line-dark);
  }

  html.stage-phone-viewer .stage-phone-actions,
  html.stage-phone-viewer .stage-phone-scene-bar {
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  html.stage-phone-viewer .stage-phone-actions { flex: 4 1 0; }
  html.stage-phone-viewer .stage-phone-scene-bar { flex: 2 1 0; }

  html.stage-phone-viewer .stage-phone-toolbar .stage-phone-button {
    flex: 1 1 44px;
    width: 100%;
    min-height: 44px;
    border-left: 0;
    border-bottom: 1px solid rgba(240,231,214,0.1);
  }

  html.stage-phone-viewer .stage-phone-scene-current {
    position: fixed;
    z-index: 4;
    top: max(0px, env(safe-area-inset-top));
    right: calc(max(0px, env(safe-area-inset-right)) + 64px);
    left: max(0px, env(safe-area-inset-left));
    height: 32px;
    padding: 8px 42px 0;
    background: linear-gradient(rgba(13,12,11,0.72), transparent);
    pointer-events: auto;
  }

  html.stage-phone-viewer .stage-canvas-stack {
    grid-column: 1;
    grid-row: 1;
    grid-template-rows: minmax(0, 1fr);
    place-items: center;
    justify-items: end;
    align-content: center;
    padding: 0;
  }

  html.stage-phone-viewer .stage-board-frame {
    /* 横向きでは図が縦いっぱいを使う。以前は下の音楽帯44px＋罫線2pxを引いていたが、
       楽曲をPC専用にして帯ごと取り除いたので、その分も図の取り分になった。 */
    width: min(100%, calc(100dvh * 16 / 9));
