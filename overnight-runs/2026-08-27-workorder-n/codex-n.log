    const y = roundM(depth + (depth * mark.ratio));
    return [{
      type: "furniture",
      polygon: centeredSquare(width / 2, y, Math.min(2, width / 4)),
      heightM: 1.2,
      label: mark.label,
      movable: true,
      ratio: mark.ratio,
      note: mark.note,
