+  assert.match(style,
+    /#stage-canvas,[\s\S]*?#stage-plan-canvas \{[\s\S]*?aspect-ratio: 16 \/ 9;/);
+});
+
+test("付箋の描画と当たり判定は同じ縦座標換算を使う", () => {
