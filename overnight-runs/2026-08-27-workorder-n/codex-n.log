html.stage-phone-viewer .stage-phone-memo-input {
  min-width: 0;
  padding: 4px 6px;
  border: 1px solid var(--line-dark);
  background: #1a1612;
  color: var(--milk);
  font-family: var(--sans);
  /* ★16px未満にしないこと。iOSは入力欄へ寄るとき画面ごと拡大する（2026-08-24 に対応済みの罠）。 */
