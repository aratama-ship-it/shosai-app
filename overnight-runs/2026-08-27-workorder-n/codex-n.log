}

html.stage-phone-viewer .stage-canvas-bar .stage-seat-list,
html.stage-phone-viewer .stage-canvas-bar .stage-canvas-tools { display: none; }

html.stage-phone-viewer .stage-canvas-bar .stage-canvas-caption {
