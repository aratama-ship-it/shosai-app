  min-height: 0;
}

html.stage-phone-viewer .stage-canvas-wrap { width: 100%; aspect-ratio: 16 / 9; }

html.stage-phone-viewer #stage-canvas,
html.stage-phone-viewer #stage-plan-canvas {
  width: 100%;
