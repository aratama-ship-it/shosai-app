+  assert.match(layout, /const floorY = seat\.floorY \* k;/);
+  const afterFloorConversion = layout.slice(layout.indexOf("const floorY ="));
+  assert.doesNotMatch(afterFloorConversion.replace("seat.floorY * k", ""), /seat\.floorY/);
