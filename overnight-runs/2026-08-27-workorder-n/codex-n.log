.stage-board-frame {
  position: relative;
  border: 1px solid rgba(156,130,63,0.7);
  background: #0d0c0b;
  box-shadow: 0 12px 34px rgba(0,0,0,0.28);
  /* グリッドの列に入るので、canvas の固有幅で押し広げられないようにする */
  min-width: 0;
}

#stage-canvas,
#stage-plan-canvas {
  display: block;
  width: 100%;
  height: auto;
  aspect-ratio: 16 / 9;
  touch-action: none;
  user-select: none;
}

/* 形は触っているものを当てて決める（cursorFor）。ここでは既定だけ置く */
#stage-canvas[data-tool="select"],
#stage-plan-canvas[data-tool="select"] { cursor: default; }
#stage-canvas[data-dragging="true"],
#stage-plan-canvas[data-dragging="true"] { cursor: grabbing; }
#stage-canvas[data-tool="paint"] { cursor: crosshair; }
#stage-canvas[data-tool="erase"] { cursor: cell; }

.stage-depth-label {

  html.stage-pwa-tablet .stage-tablet-view-buttons {
    display: none;
  }

  html.stage-pwa-tablet .stage-canvas-stack {
    grid-template-rows: auto auto;
    place-items: stretch;
    align-content: start;
    gap: 4px;
    padding: 4px;
  }

  html.stage-pwa-tablet .stage-board-frame {
    width: 100%;
    max-height: none;
  }
}

/* ===== スマホ: JSONを読み込んで見るための簡易ワークスペース ===== */
html.stage-phone-viewer,
html.stage-phone-viewer body {
  width: 100%;
  height: 100%;
  overflow: hidden;
  overscroll-behavior: none;
  touch-action: manipulation;
}

html.stage-phone-viewer body {
  position: fixed;
  inset: 0;
  padding: 0;
  background: #0d0c0b;
}

html.stage-phone-viewer .spine,
html.stage-phone-viewer .topnav,
html.stage-phone-viewer .stage-sketch-head,
html.stage-phone-viewer .stage-toolbox,
html.stage-phone-viewer .stage-inspector,
html.stage-phone-viewer .stage-scenes,
html.stage-phone-viewer .stage-center-bar,
html.stage-phone-viewer .stage-canvas-help,
html.stage-phone-viewer .stage-boundary-note,
/* 光の意図は書く側の道具。スマホは「読み込んで見る」ための画面なので、
   シーン一覧や道具箱と同じように隠す。
   ★出したままだと、要約の行がシーン送り（前へ／次へ）の上に重なって、
     場面を送れなくなる（作り手用の帯を前提に組んであるため）。 */
html.stage-phone-viewer .stage-light-intent,
html.stage-phone-viewer .stage-light-intent-compare,
html.stage-phone-viewer .stage-zoom-fab {
  display: none !important;
}

/* スマホも専用の送りを使う。PC帯が残るとcanvasが暗黙の3行目へ押し出される。 */
html.stage-phone-viewer .stage-scene-bar { display: none !important; }

html.stage-phone-viewer #view-stage {
  display: block !important;
  width: 100%;
  height: 100dvh;
  min-height: 0;
  padding: 0 !important;
  overflow: hidden;
}

html.stage-phone-viewer .stage-sketch {
  width: 100%;
  max-width: none;
  height: 100%;
  margin: 0;
  padding: max(0px, env(safe-area-inset-top))
    max(0px, env(safe-area-inset-right))
    max(0px, env(safe-area-inset-bottom))
    max(0px, env(safe-area-inset-left));
  overflow: hidden;
}

html.stage-phone-viewer .stage-sketch-grid {
  display: block;
  width: 100%;
  height: 100%;
  min-width: 0;
  min-height: 0;
  overflow: hidden;
}

html.stage-phone-viewer .stage-board-column {
  position: relative;
  display: grid;
  /* 題・道具の帯・情報・ショー・設定・図。以前は下に音楽帯44pxがあったが、楽曲はPC専用と決めて
     取り除いたので、その分を図へ返している（2026-08-24 本人判断）。
     題の30pxは縦向きで足した分（2026-08-26 本人指摘。横向きでは題を消して二段に戻す）。
     ★行を明示しないと canvas が暗黙の行へ押し出される。段を増減したらここも直すこと。 */
  /* 7段目は図の下のメモ欄（縦向きのみ・2026-08-26 本人指示）。
     図が minmax(0,1fr) なので、上のパネルが開いても縮むのは図のほうで、
     メモ欄は下に残る。★段を増減したら各要素の grid-row と一緒に直すこと。 */
  grid-template-rows: 30px 48px auto auto auto minmax(0, 1fr) auto;
  width: 100%;
  height: 100%;
  min-width: 0;
  min-height: 0;
  padding: 0;
  overflow: hidden;
}

/* 図は必ず6段目。情報・ショー・設定が hidden で消えても、自動配置で段が繰り上がらないようにする。
   ★段を増減したら .stage-board-column の grid-template-rows と一緒に直すこと。 */
html.stage-phone-viewer .stage-canvas-stack { grid-row: 6; }

/* 図の下のメモ欄。道具の帯と同じ地色で、画面の下端の塊として置く。 */
html.stage-phone-viewer .stage-phone-memo {
  grid-row: 7;
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  align-items: start;
