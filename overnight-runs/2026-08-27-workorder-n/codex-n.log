+  /* 縦向きのスマホは絵の枠を4:3にする（stage-sketch.js の applyCanvasSize と対）。
+     ★片方だけ直すと絵が歪む。両方そろえること。 */
+  html.stage-phone-viewer .stage-canvas-wrap,
+  html.stage-phone-viewer #stage-canvas,
