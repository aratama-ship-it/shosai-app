     `新しい幅 ${result.stage.w} は旧幅 ${oldWidth} の1.1倍以上`);
 });
 
+test("12m×9m frontはH=960で袖と96pxの客席帯を保ち、H=720の結果を変えない", () => {
+  const desktop = fit("front");
+  assert.deepEqual(desktop, {
+    stage: { x: 256, y: 24, w: 768, h: 576 },
+    pxPerM: 64,
