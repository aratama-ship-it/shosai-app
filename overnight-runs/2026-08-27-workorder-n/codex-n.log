test("スマホ閲覧機の固定文言・aria-label・placeholderはtxを通す", () => {
  const start = source.indexOf("function initPhoneViewerWorkspace()");
  const end = source.indexOf("/* ---------- iPad PWA専用ワークスペース", start);
