+  assertNear(phonePortrait.stage.h, 652.2352941176471, "front H=960: 舞台奥行き");
+  assertNear(phonePortrait.pxPerM, 72.47058823529412, "front H=960: pxPerM");
+  assertWingsFit(phonePortrait, "front", "front H=960");
