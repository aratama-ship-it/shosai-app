+  assert.match(body, /arrowDraft\.view === wantView/);
+  assert.doesNotMatch(body, /target === ctx && !L\.plan && arrowDraft/);
+});
+
+test("arrowAtは同じ図の矢印だけを添字を保ったまま調べる", () => {
