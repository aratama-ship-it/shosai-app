test("setLangはスマホ閲覧機の文言をその場で貼り直す", () => {
  assert.match(source, /function setLang\(next\) \{[\s\S]*?applyLang\(\);\s*applyPhoneViewerLang\(\);/);
  assert.match(source, /langJa\.addEventListener\("click", \(\) => setLang\("ja"\)\)/);
