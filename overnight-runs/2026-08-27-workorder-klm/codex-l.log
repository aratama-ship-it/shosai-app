+  assert.ok(result.stage.w >= oldWidth * 1.1,
+    `新しい幅 ${result.stage.w} は旧幅 ${oldWidth} の1.1倍以上`);
+});
+
+test("極端な会場寸法でも各形式の必要物が画面に収まる", () => {
