html.stage-phone-viewer .stage-light-intent-compare,
html.stage-phone-viewer .stage-zoom-fab {
  display: none !important;
}

/* スマホも専用の送りを使う。PC帯が残るとcanvasが暗黙の3行目へ押し出される。 */
html.stage-phone-viewer .stage-scene-bar { display: none !important; }

html.stage-phone-viewer #view-stage {
  display: block !important;
  width: 100%;
  height: 100dvh;
  min-height: 0;
  padding: 0 !important;
  overflow: hidden;
}

html.stage-phone-viewer .stage-sketch {
  width: 100%;
  max-width: none;
  height: 100%;
  margin: 0;
  padding: max(0px, env(safe-area-inset-top))
    max(0px, env(safe-area-inset-right))
    max(0px, env(safe-area-inset-bottom))
    max(0px, env(safe-area-inset-left));
  overflow: hidden;
}

html.stage-phone-viewer .stage-sketch-grid {
  display: block;
  width: 100%;
  height: 100%;
  min-width: 0;
  min-height: 0;
  overflow: hidden;
}

html.stage-phone-viewer .stage-board-column {
  position: relative;
  display: grid;
  /* 題・道具の帯・図の三段。以前は下に音楽帯44pxがあったが、楽曲はPC専用と決めて
     取り除いたので、その分を図へ返している（2026-08-24 本人判断）。
     題の30pxは縦向きで足した分（2026-08-26 本人指摘。横向きでは題を消して二段に戻す）。
     ★行を明示しないと canvas が暗黙の行へ押し出される。段を増減したらここも直すこと。 */
  grid-template-rows: 30px 48px auto auto minmax(0, 1fr);
  width: 100%;
  height: 100%;
  min-width: 0;
  min-height: 0;
  padding: 0;
  overflow: hidden;
}

/* 図は必ず5段目。情報・ショーが hidden で消えても、自動配置で段が繰り上がらないようにする。
   ★段を増減したら .stage-board-column の grid-template-rows と一緒に直すこと。 */
html.stage-phone-viewer .stage-canvas-stack { grid-row: 5; }

/* 上部の題。デスクトップのヘッダーと同じ語彙（セリフの題＋小さなサンセリフの版＋錆色のβ版）を、
   30pxの帯に収まる寸法へ落としたもの。道具の帯と同じ地色で、両者で一つの上部の塊に見せる。 */
html.stage-phone-viewer .stage-phone-title {
  grid-row: 1;
  z-index: 12;
  display: flex;
  align-items: baseline;
  gap: 7px;
  min-width: 0;
  padding: 0 12px;
  background: #15120f;
}

html.stage-phone-viewer .stage-phone-title-name {
  color: var(--milk);
