  html.stage-pwa-tablet .stage-sketch-grid.is-tablet-drawer-open
    .stage-canvas-bar .stage-canvas-tools::-webkit-scrollbar-track {
    background: transparent;
  }

  html.stage-pwa-tablet .stage-sketch-grid.is-tablet-drawer-open
    .stage-canvas-bar .stage-canvas-tools::-webkit-scrollbar-thumb {
    border-radius: 999px;
    background: rgba(211, 172, 89, 0.42);
  }

  html.stage-pwa-tablet .stage-tablet-view-buttons {
    display: none;
  }

  html.stage-pwa-tablet .stage-canvas-stack {
    grid-template-rows: auto auto;
    place-items: stretch;
    align-content: start;
    gap: 4px;
    padding: 4px;
  }

  html.stage-pwa-tablet .stage-board-frame {
    width: 100%;
    max-height: none;
  }
}

