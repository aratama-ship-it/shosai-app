        }
        target.restore();
    
        
        const step = L.size.width > 14 ? 2 : 1;
        target.save();
        target.strokeStyle = "rgba(239,231,214,0.07)";
        target.lineWidth = 1;
        for (let m = step; m < L.size.width; m += step) {
          const x = s.x + (m / L.size.width) * s.w;
          target.beginPath();
          target.moveTo(x, s.y);
          target.lineTo(x, s.y + s.h);
