                id: nextId(), type: "performer", castId: ghost.member.id,
                u: ghost.u, v: ghost.v, size: 100,
                color: ghost.member.color || state.pieceColor, name: "",
              }, 0);
              sc().pieces.push(piece);
              renderCast();
              renderScenes();
