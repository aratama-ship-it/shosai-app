          checkpoint();
          item.framed = e.target.checked;
          render();
          persistSoon();
          announce(`${item.name}を${item.framed ? "フレーム（穴の空いた壁）" : "壁"}にしました。`);
        });
      }
      if (els.setInfoWires) {
        els.setInfoWires.addEventListener("change", (e) => {
          const item = currentSetItem();
          if (!item) return;
