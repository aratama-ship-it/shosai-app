            const H = size.height || 8;
            const targets = [0.08, 0.22, 0.36, 0.5, 0.64, 0.78, 0.92];
            return targets.map((targetU, i) => {
              const u = 0.44 + i * 0.02;
              return {
                name: `扇${i + 1}`, color: "#dce6f2", dia: 0.9, kind: "floor",
                u, v: 0.10,
