        if (tool === "arrow" && view === "front") {
          if (event.altKey) {
            const index = arrowAt(point, L, view);
            if (index >= 0) {
              checkpoint();
              sc().arrows.splice(index, 1);
              render();
              persistSoon();
              announce("矢印を1本消しました。");
            }
            return;
          }
          arrowDraft = {
            plane: arrowPlanePref(),
            depth: arrowDepthPref(),
            heads: arrowHeadsPref(),
