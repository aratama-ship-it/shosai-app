+  grid-template-columns: 268px minmax(420px, 1fr);
+  grid-template-areas: "tools board";
+}
+
+body.stage-session-guest #stage-col-left > #stage-session-panel {
+  margin: 0;
+  padding: 10px 0 14px;
+  border-top: 1px solid var(--line-dark);
+}
+
 /* ゲストはシーンを切り替えられない（ホストに追従）。一覧は現在地の表示用に残す */
 body.stage-session-guest #stage-scene-list {
