+      visible.push(row);
+      if (row && row.kind === "section" && collapsedSections
+          && typeof collapsedSections.has === "function" && collapsedSections.has(row.id)) {
+        hiddenBelowDepth = depth;
+      }
+    });
+    return visible;
+  }
+
