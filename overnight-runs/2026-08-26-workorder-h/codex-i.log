        }
        target.restore();
    
        
        label(target, `${tx("間口")} ${L.size.width}m`, s.x + s.w / 2, s.y - 22);
        label(target, `${tx("奥行")} ${L.size.depth}m`, s.x - 46, s.y + s.h / 2);
    
        
        if (v.audience === "none") {
