      if (els.setInfoClose) els.setInfoClose.addEventListener("click", closeSetInfo);
      if (els.setInfoBackdrop) els.setInfoBackdrop.addEventListener("click", closeSetInfo);
      if (els.setInfoName) {
        els.setInfoName.addEventListener("input", (e) => {
