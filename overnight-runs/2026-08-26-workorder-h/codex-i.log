            const straight = piece.route.bu === (piece.u + piece.route.u) / 2
              && piece.route.bv === (piece.v + piece.route.v) / 2;
            piece.route.u = next.u;
            piece.route.v = next.v;
            if (straight || pointerAction.fresh !== false) {
