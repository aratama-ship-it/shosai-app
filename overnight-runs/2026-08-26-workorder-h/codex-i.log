+    { id: "scene-a", kind: "scene", depth: 1 },
+    { id: "section-b", kind: "section", depth: 1 },
+    { id: "scene-b", kind: "scene", depth: 2 },
+    { id: "scene-c", kind: "scene", depth: 0 },
+  ];
