  assert.ok(!/makePhoneButton\("読込"/.test(source), "「読込」へ戻っていないこと");
  assert.match(source, /scenePrev\.addEventListener\("click", \(\) => stepScene\(-1\)\)/);
  assert.match(source, /sceneNext\.addEventListener\("click", \(\) => stepScene\(1\)\)/);
