    34	function createElement(tagName = "div") {
    35	  const listeners = new Map();
    36	  const element = {
    37	    tagName: tagName.toUpperCase(),
    38	    className: "",
    39	    classList: createClassList(),
    40	    style: { setProperty: noop },
    41	    dataset: {},
    42	    children: [],
    43	    parentElement: null,
    44	    parentNode: null,
    45	    value: "",
    46	    textContent: "",
    47	    hidden: false,
    48	    disabled: false,
    49	    open: false,
    50	    addEventListener(type, callback) {
    51	      if (!listeners.has(type)) listeners.set(type, []);
    52	      listeners.get(type).push(callback);
    53	    },
    54	    async dispatch(type, event = {}) {
    55	      for (const callback of listeners.get(type) || []) await callback(event);
    56	    },
    57	    append(...children) {
    58	      children.forEach((child) => {
    59	        if (child.parentNode && typeof child.parentNode.removeChild === "function") {
    60	          child.parentNode.removeChild(child);
    61	        }
    62	        child.parentNode = this;
    63	        child.parentElement = this;
    64	        this.children.push(child);
    65	      });
    66	    },
    67	    insertBefore(child, reference) {
    68	      if (child.parentNode && typeof child.parentNode.removeChild === "function") {
    69	        child.parentNode.removeChild(child);
    70	      }
    71	      const index = reference == null ? -1 : this.children.indexOf(reference);
    72	      child.parentNode = this;
    73	      child.parentElement = this;
    74	      if (index < 0) this.children.push(child);
    75	      else this.children.splice(index, 0, child);
    76	      return child;
    77	    },
    78	    removeChild(child) {
    79	      const index = this.children.indexOf(child);
    80	      if (index < 0) return child;
    81	      this.children.splice(index, 1);
    82	      child.parentNode = null;
    83	      child.parentElement = null;
    84	      return child;
    85	    },
    86	    replaceChildren(...children) {
    87	      this.children.slice().forEach((child) => this.removeChild(child));
    88	      this.append(...children);
    89	    },
    90	    setAttribute: noop,
    91	    remove() {
    92	      if (this.parentNode && typeof this.parentNode.removeChild === "function") {
    93	        this.parentNode.removeChild(this);
    94	      }
    95	    },
    96	    focus: noop,
    97	    select: noop,
    98	    setSelectionRange: noop,
    99	    querySelector: () => null,
   100	    getBoundingClientRect: () => ({ left: 0, top: 0, width: 1200, height: 800 }),
   101	    get firstChild() { return this.children[0] || null; },
   102	    get nextSibling() {
   103	      if (!this.parentNode) return null;
   104	      const index = this.parentNode.children.indexOf(this);
   105	      return index >= 0 ? this.parentNode.children[index + 1] || null : null;
   106	    },
   107	    get childElementCount() { return this.children.length; },
   108	  };
   109	  return element;
   110	}
