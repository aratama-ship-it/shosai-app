+    target: { closest: () => ({}) },
+    preventDefault() { hostPrevented = true; },
+    stopImmediatePropagation: noop,
+  });
+  assert.equal(hostPrevented, false, "ゲストクラスが無い通常画面は遮断しない");
+});
