+    const target = event.target;
+    if (!target || typeof target.closest !== "function" ||
+        !target.closest(GUEST_ROSTER_CONTROL_SELECTOR)) return;
+    event.preventDefault();
+    event.stopImmediatePropagation();
+  }
+
