   518	/* GUEST_ACCOUNTS は、未設定か空文字列のときだけ「この入口を使わない」と扱う。
   519	   設定済みなら全件を検証し、部分的に正しい名簿へ縮めず、どこか一つでも不正なら
   520	   設定全体を止める。label と未知の項目は将来用なので認証判定には使わない。 */
   521	function parseGuestAccounts(value, siteUser, legacyGuestUser) {
   522	  if (value === undefined || value === "") {
   523	    return { accounts: [], misconfigured: false };
   524	  }
   525	  if (typeof value !== "string") {
   526	    return { accounts: [], misconfigured: true };
   527	  }
   528	
   529	  let entries = null;
   530	  try {
   531	    entries = JSON.parse(value);
   532	  } catch (_) {
   533	    return { accounts: [], misconfigured: true };
   534	  }
   535	  if (!Array.isArray(entries) || entries.length === 0) {
   536	    return { accounts: [], misconfigured: true };
   537	  }
   538	
   539	  const accounts = [];
   540	  const seenUsers = new Set();
   541	  for (const entry of entries) {
   542	    if (!entry || typeof entry !== "object" || Array.isArray(entry)) {
   543	      return { accounts: [], misconfigured: true };
   544	    }
   545	    const { user, pass } = entry;
   546	    if (typeof user !== "string" || user.length === 0
   547	        || typeof pass !== "string" || pass.length === 0) {
   548	      return { accounts: [], misconfigured: true };
   549	    }
   550	    if (seenUsers.has(user) || user === siteUser || user === legacyGuestUser) {
   551	      return { accounts: [], misconfigured: true };
   552	    }
   553	    seenUsers.add(user);
   554	    accounts.push([user, pass]);
   555	  }
   556	  return { accounts, misconfigured: false };
   557	}
