html.stage-phone-viewer .stage-sketch {
  width: 100%;
  max-width: none;
  height: 100%;
  margin: 0;
  padding: max(0px, env(safe-area-inset-top))
    max(0px, env(safe-area-inset-right))
    max(0px, env(safe-area-inset-bottom))
    max(0px, env(safe-area-inset-left));
  overflow: hidden;
}

html.stage-phone-viewer .stage-sketch-grid {
  display: block;
  width: 100%;
  height: 100%;
  min-width: 0;
  min-height: 0;
  overflow: hidden;
}

html.stage-phone-viewer .stage-board-column {
  position: relative;
  display: grid;
  /* 題・道具の帯・情報・ショー・設定・図。以前は下に音楽帯44pxがあったが、楽曲はPC専用と決めて
     取り除いたので、その分を図へ返している（2026-08-24 本人判断）。
     題の30pxは縦向きで足した分（2026-08-26 本人指摘。横向きでは題を消して二段に戻す）。
     ★行を明示しないと canvas が暗黙の行へ押し出される。段を増減したらここも直すこと。 */
  /* 7段目は図の下のメモ欄（縦向きのみ・2026-08-26 本人指示）。
     図が minmax(0,1fr) なので、上のパネルが開いても縮むのは図のほうで、
     メモ欄は下に残る。★段を増減したら各要素の grid-row と一緒に直すこと。 */
  grid-template-rows: 30px 48px auto auto auto minmax(0, 1fr) auto;
  width: 100%;
  height: 100%;
  min-width: 0;
  min-height: 0;
  padding: 0;
  overflow: hidden;
}

/* 図は必ず6段目。情報・ショー・設定が hidden で消えても、自動配置で段が繰り上がらないようにする。
   ★段を増減したら .stage-board-column の grid-template-rows と一緒に直すこと。 */
html.stage-phone-viewer .stage-canvas-stack { grid-row: 6; }

/* 図の下のメモ欄。道具の帯と同じ地色で、画面の下端の塊として置く。 */
html.stage-phone-viewer .stage-phone-memo {
  grid-row: 7;
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  align-items: start;
  gap: 8px;
  padding: 7px 10px;
  border-top: 1px solid var(--line-dark);
  background: #15120f;
}

html.stage-phone-viewer .stage-phone-memo-label {
  padding-top: 3px;
  color: var(--brass);
  font-family: var(--sans);
  font-size: 10px;
  letter-spacing: 0.14em;
}

html.stage-phone-viewer .stage-phone-memo-input {
  min-width: 0;
  padding: 4px 6px;
  border: 1px solid var(--line-dark);
  background: #1a1612;
  color: var(--milk);
  font-family: var(--sans);
  /* ★16px未満にしないこと。iOSは入力欄へ寄るとき画面ごと拡大する（2026-08-24 に対応済みの罠）。 */
  font-size: 16px;
  line-height: 1.4;
  resize: none;
}

/* 上部の題。デスクトップのヘッダーと同じ語彙（セリフの題＋小さなサンセリフの版＋錆色のβ版）を、
   30pxの帯に収まる寸法へ落としたもの。道具の帯と同じ地色で、両者で一つの上部の塊に見せる。 */
html.stage-phone-viewer .stage-phone-title {
  grid-row: 1;
  z-index: 12;
  display: flex;
  align-items: baseline;
  gap: 7px;
  min-width: 0;
  padding: 0 12px;
  background: #15120f;
  -webkit-overflow-scrolling: touch;
}

html.stage-phone-viewer .stage-phone-scene-list-rows {
  display: grid;
  gap: 2px;
}

html.stage-phone-viewer .stage-phone-scene-list-row {
  width: 100%;
  min-height: 44px;
  padding: 8px 12px 8px calc(12px + var(--phone-scene-indent, 0px));
  border: 0;
  border-bottom: 1px solid rgba(240,231,214,0.1);
  background: transparent;
  color: var(--milk-dim);
  font: 13px/1.4 var(--sans);
  letter-spacing: 0.03em;
  text-align: left;
}

html.stage-phone-viewer .stage-phone-scene-list-row.is-section {
  color: var(--brass);
  font-weight: 600;
}

html.stage-phone-viewer .stage-phone-scene-list-row.is-current {
  background: rgba(168,75,38,0.28);
  color: var(--paper);
}

html.stage-phone-viewer .stage-canvas-stack {
  display: grid;
  grid-template-rows: auto auto;
  place-items: stretch;
  align-content: start;
  min-width: 0;
  min-height: 0;
  height: 100%;
  gap: 3px;
  padding: 3px;
  overflow: hidden;
}

html.stage-phone-viewer .stage-board-frame {
  display: flex;
  flex-direction: column;
  min-width: 0;
  min-height: 0;
  max-width: 100%;
  max-height: none;
  margin: 0;
  box-shadow: none;
}

html.stage-phone-viewer .stage-board-frame.is-closed { display: none; }

html.stage-phone-viewer .stage-canvas-bar {
  position: absolute;
  z-index: 3;
  top: 0;
  right: 0;
  left: 0;
  min-height: 30px;
  padding: 6px 8px;
  border-bottom: 0;
  background: linear-gradient(rgba(13,12,11,0.78), transparent);
  pointer-events: none;
}

html.stage-phone-viewer .stage-canvas-bar .stage-seat-list,
html.stage-phone-viewer .stage-canvas-bar .stage-canvas-tools { display: none; }

html.stage-phone-viewer .stage-canvas-bar .stage-canvas-caption {
  margin: 0;
  font-size: 9px;
}

html.stage-phone-viewer .stage-canvas-inner,
html.stage-phone-viewer .stage-canvas-wrap {
  min-width: 0;
  min-height: 0;
}

html.stage-phone-viewer .stage-canvas-wrap { width: 100%; aspect-ratio: 16 / 9; }

html.stage-phone-viewer #stage-canvas,
html.stage-phone-viewer #stage-plan-canvas {
  width: 100%;
  height: auto;
  aspect-ratio: 16 / 9;
}

/* スマホの付箋入力は、指とキーボードで隠れにくい下端のシートにする。 */
html.stage-phone-viewer .stage-note-editor {
  position: fixed;
  z-index: 90;
  top: auto !important;
  right: max(8px, env(safe-area-inset-right));
  bottom: max(8px, env(safe-area-inset-bottom));
  left: max(8px, env(safe-area-inset-left)) !important;
  width: auto !important;
  min-width: 0;
}

html.stage-phone-viewer .stage-note-editor textarea { min-height: 72px; resize: none; }
html.stage-phone-viewer .stage-note-editor-bar .btn-quiet { min-height: 44px; min-width: 64px; }

@media (orientation: portrait) {
  /* 縦向きのスマホは絵の枠を4:3にする（stage-sketch.js の applyCanvasSize と対）。
     ★片方だけ直すと絵が歪む。両方そろえること。 */
  html.stage-phone-viewer .stage-canvas-wrap,
  html.stage-phone-viewer #stage-canvas,
  html.stage-phone-viewer #stage-plan-canvas { aspect-ratio: 4 / 3; }

  html.stage-phone-viewer .stage-board-frame {
    width: 100%;
  }
}

@media (orientation: landscape) {
  html.stage-phone-viewer .stage-board-column {
    grid-template-columns: minmax(0, 1fr) 64px;
    /* 音楽帯を取り除いたぶん、図が縦いっぱいを使う（2026-08-24） */
    grid-template-rows: minmax(0, 1fr);
  }

  /* 横向きは縦の余白が図に要る。題は縦向きだけの贅沢（2026-08-26 本人判断）。 */
  html.stage-phone-viewer .stage-phone-title { display: none; }

  /* メモ欄も縦向きだけ（本人指示が「縦画面の場合は」）。 */
  html.stage-phone-viewer .stage-phone-memo { display: none; }

  /* ★横向きだけは、情報・ショーのパネルを今までどおり図の上へ重ねる。
     横向きには押し下げる余白が無く、流し込むと図が画面の下へ出てしまうため。
     右の64pxは道具のレールなので、その分を避けて置く。 */
  html.stage-phone-viewer .stage-phone-info,
  html.stage-phone-viewer .stage-phone-source,
  html.stage-phone-viewer .stage-phone-settings {
    position: fixed;
    grid-row: auto;
    top: calc(max(0px, env(safe-area-inset-top)) + 8px);
    left: max(8px, env(safe-area-inset-left));
    right: calc(64px + max(8px, env(safe-area-inset-right)));
    border: 1px solid var(--line-dark);
    box-shadow: 0 12px 28px rgba(0,0,0,0.55);

  html.stage-phone-viewer .stage-phone-toolbar .stage-phone-button {
    flex: 1 1 44px;
    width: 100%;
    min-height: 44px;
    border-left: 0;
    border-bottom: 1px solid rgba(240,231,214,0.1);
  }

  html.stage-phone-viewer .stage-phone-scene-current {
    position: fixed;
    z-index: 4;
    top: max(0px, env(safe-area-inset-top));
    right: calc(max(0px, env(safe-area-inset-right)) + 64px);
    left: max(0px, env(safe-area-inset-left));
    height: 32px;
    padding: 8px 42px 0;
    background: linear-gradient(rgba(13,12,11,0.72), transparent);
    pointer-events: auto;
  }

  html.stage-phone-viewer .stage-canvas-stack {
    grid-column: 1;
    grid-row: 1;
    grid-template-rows: minmax(0, 1fr);
    place-items: center;
    justify-items: end;
    align-content: center;
    padding: 0;
  }

  html.stage-phone-viewer .stage-board-frame {
    /* 横向きでは図が縦いっぱいを使う。以前は下の音楽帯44px＋罫線2pxを引いていたが、
       楽曲をPC専用にして帯ごと取り除いたので、その分も図の取り分になった。
       ★以前は `calc(100dvh * 16/9)` で幅を逆算していたが、100dvhは実際にこの枠へ
       渡る高さ（safe-area等を引いた後の値）と食い違うことがあり、iPhone 13 Pro Maxで
       上下がわずかに切れる報告があった（2026-08-28）。dvhを使わず、実際に配られた
       グリッドの高さ（height:100%）から幅をaspect-ratioで逆算する形にする。
       これなら安全マージンの引き算が要らず、どんな余白の付き方でもズレない。 */
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    aspect-ratio: 16 / 9;
  }

  html.stage-phone-viewer .stage-phone-info,
  html.stage-phone-viewer .stage-phone-source,
  html.stage-phone-viewer .stage-phone-settings {
    top: calc(max(0px, env(safe-area-inset-top)) + 38px);
    right: calc(max(8px, env(safe-area-inset-right)) + 68px);
    askRunning: document.getElementById("stage-ask-running"),
    askElapsed: document.getElementById("stage-ask-elapsed"),
    askStop: document.getElementById("stage-ask-stop"),
