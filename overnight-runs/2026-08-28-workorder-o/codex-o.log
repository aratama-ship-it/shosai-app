        }
        .stage-reach-body tbody td.col-away { background: rgba(184,168,136,.2); }
        .stage-reach-body tbody td::before {
          content: attr(data-label);
          display: block;
          margin-bottom: 1px;
          color: var(--ink-soft);
          font-size: 9px;
          letter-spacing: 0;
        }
        .stage-reach-body tbody td u { font-size: 8.5px; }
      }
    
