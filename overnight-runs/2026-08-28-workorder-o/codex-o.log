      color: var(--milk);
      text-align: left;
    }
    
    .company-radar-row:hover,
    .company-radar-row.selected { background: var(--desk-2); }
    .company-radar-row.selected { box-shadow: inset 3px 0 0 var(--rust); padding-left: 8px; }
    
    .company-radar-row-index {
      color: var(--rust);
