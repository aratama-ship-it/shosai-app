+  });
+
+  // 同じ登録を隣り合う場面の別演者へ移し、密度を落とさず受け渡しを残す。
+  const handoffItem = registrations[0];
+  if (!handoffItem) return;
+  for (let index = 0; index < rows.length - 1; index += 1) {
+    const beforeScene = rows[index];
+    const afterScene = rows[index + 1];
