   481	function collectShowFiles(explicitPaths = []) {
   482	  const paths = [];
   483	  const exclusions = [];
   484	  const inputs = explicitPaths.length ? explicitPaths : defaultShowDirectories();
   485	  for (const input of inputs) {
   486	    try {
   487	      const info = statSync(input);
   488	      if (info.isDirectory()) paths.push(...jsonFilesIn(input));
   489	      else if (info.isFile() && input.endsWith(".json")) paths.push(input);
   490	      else exclusions.push({ file: input, reason: "JSONファイルでもディレクトリでもありません。" });
   491	    } catch (error) {
   492	      exclusions.push({ file: input, reason: `読めません: ${error.message}` });
   493	    }
   494	  }
   495	  const unique = [...new Set(paths.map((file) => path.resolve(file)))].sort((a, b) => a.localeCompare(b, "en"));
   496	  const shows = [];
   497	  for (const file of unique) {
   498	    try {
   499	      const doc = JSON.parse(readFileSync(file, "utf8"));
   500	      const project = doc && (doc.project || doc);
   501	      if (!project || !Array.isArray(project.scenes)) {
   502	        exclusions.push({ file, reason: "project.scenes（または直下scenes）が配列ではありません。" });
   503	        continue;
   504	      }
   505	      shows.push({ file, project });
   506	    } catch (error) {
   507	      exclusions.push({ file, reason: `JSONを読めません: ${error.message}` });
   508	    }
   509	  }
   510	  return { shows, exclusions };
   511	}
