   428	function parseArgs(argv) {
   429	  const options = { wave: "both", lang: "ja", seed: 42, viewport: DEFAULT_VIEWPORT, matrix: false, shows: [] };
   430	  for (let index = 0; index < argv.length; index += 1) {
   431	    const arg = argv[index];
   432	    if (arg === "--help" || arg === "-h") { options.help = true; continue; }
   433	    if (arg === "--matrix") { options.matrix = true; continue; }
   434	    if (arg === "--wave") {
   435	      options.wave = requireValue(argv, index, arg).toLowerCase(); index += 1;
   436	      if (!new Set(["a", "b", "both"]).has(options.wave)) throw new Error(`--wave は a|b|both: ${options.wave}`);
   437	      continue;
   438	    }
   439	    if (arg === "--lang") {
   440	      options.lang = requireValue(argv, index, arg).toLowerCase(); index += 1;
   441	      if (!new Set(["ja", "en"]).has(options.lang)) throw new Error(`--lang は ja|en: ${options.lang}`);
   442	      continue;
   443	    }
   444	    if (arg === "--seed") {
   445	      options.seed = Number(requireValue(argv, index, arg)); index += 1;
   446	      if (!Number.isInteger(options.seed)) throw new Error("--seed は整数で指定してください。");
   447	      continue;
   448	    }
   449	    if (arg === "--width") { options.viewport = parseViewport(requireValue(argv, index, arg)); index += 1; continue; }
   450	    if (arg === "--out") { options.out = path.resolve(requireValue(argv, index, arg)); index += 1; continue; }
   451	    if (arg === "--json") { options.json = path.resolve(requireValue(argv, index, arg)); index += 1; continue; }
   452	    if (arg === "--shows") {
   453	      index += 1;
   454	      while (index < argv.length && !argv[index].startsWith("--")) { options.shows.push(path.resolve(argv[index])); index += 1; }
   455	      index -= 1;
   456	      if (!options.shows.length) throw new Error("--shows の後に1つ以上のパスが必要です。");
   457	      continue;
   458	    }
   459	    throw new Error(`未知の引数です: ${arg}`);
   460	  }
   460	  }
   461	  return options;
   462	}
