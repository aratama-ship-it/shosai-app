   543	async function startStaticServer() {
   544	  const server = createServer((request, response) => {
   545	    try {
   546	      const url = new URL(request.url || "/", "http://127.0.0.1");
   547	      const relative = decodeURIComponent(url.pathname).replace(/^\/+/, "");
   548	      const file = path.resolve(APP_ROOT, relative || "stage.html");
   549	      if (file !== APP_ROOT && !file.startsWith(`${APP_ROOT}${path.sep}`)) {
   550	        response.writeHead(403); response.end("forbidden"); return;
   551	      }
   552	      const info = statSync(file);
   553	      if (!info.isFile()) { response.writeHead(404); response.end("not found"); return; }
   554	      const body = readFileSync(file);
   555	      response.writeHead(200, { "content-type": contentType(file), "cache-control": "no-store" });
   556	      response.end(request.method === "HEAD" ? undefined : body);
   557	    } catch (_) {
   558	      response.writeHead(404); response.end("not found");
   559	    }
   560	  });
   561	  await new Promise((resolve, reject) => {
   562	    server.once("error", reject);
   563	    server.listen(0, "127.0.0.1", resolve);
   564	  });
   565	  const address = server.address();
   566	  return { server, origin: `http://127.0.0.1:${address.port}` };
   567	}
