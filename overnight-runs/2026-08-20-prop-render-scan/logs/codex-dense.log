   295	  // 左手は空いている演者の場面を選ぶ。右手と同じ人でも別スロットなのでよい。
   296	  if (registrations.length > 1) {
   297	    const holderScene = handoffPair?.beforeScene || rows.find((scene) =>
   298	      (scene.pieces || []).some((piece) => piece.type === "performer"));
   299	    const holder = holderScene && (holderScene.pieces || []).find((piece) => piece.type === "performer");
   300	    if (holder) Object.assign(byScene.get(holderScene).get(registrations[1].id), { heldBy: holder.id, holdSide: "L" });
   301	  }
   302	
   303	  // 一つは前場面にだけ残し、次場面から取り除いて「はける」を作る。
   304	  if (rows.length > 1 && registrations.length) {
   305	    const item = registrations[Math.min(4, registrations.length - 1)];
   306	    const disappearAt = handoffPair ? rows.indexOf(handoffPair.beforeScene) : 0;
   307	    const nextScene = rows[disappearAt + 1];
   308	    if (nextScene) {
   309	      const removed = byScene.get(nextScene).get(item.id);
   310	      nextScene.pieces = nextScene.pieces.filter((piece) => piece !== removed);
