   601	  page.on("pageerror", (error) => issues.push(issueFor(show, combo, "A1", "fatal", error.message, error.stack)));
   602	  page.on("console", (message) => {
   603	    if (message.type() === "error") issues.push(issueFor(show, combo, "A2", "render", message.text()));
   604	    if (message.type() === "warning") issues.push(issueFor(show, combo, "A3", "warning", message.text()));
   605	  });
   606	  page.on("requestfailed", (request) => issues.push(issueFor(show, combo, "A4", "network", `${request.url()} | ${request.failure()?.errorText || "理由不明"}`)));
   607	  page.on("crash", () => issues.push(issueFor(show, combo, "A5", "fatal", "ページがクラッシュしました。")));
   608	
   609	  await page.addInitScript(({ projectValue, storageKey, tourKey, langKey, lang }) => {
   610	    localStorage.setItem(storageKey, JSON.stringify({ project: projectValue }));
   611	    localStorage.setItem(tourKey, "done");
   612	    localStorage.setItem(langKey, lang);
