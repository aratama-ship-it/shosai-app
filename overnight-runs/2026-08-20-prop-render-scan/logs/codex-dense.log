   262	    floor.heldBy = null;
   263	    floor.u = 0.35;
   264	    floor.v = 0.55;
   265	    const outside = map.get(registrations[Math.min(3, registrations.length - 1)].id);
   266	    outside.heldBy = null;
   267	    outside.u = -0.45;
   268	    outside.v = -0.45;
   269	  }
   270	
   271	  // 隣り合う場面に別の演者がいる所を探し、同じ小道具を右手から受け渡す。
   272	  let handoffPair = null;
   273	  for (let index = 0; index < rows.length - 1 && !handoffPair; index += 1) {
   274	    const beforePeople = (rows[index].pieces || []).filter((piece) => piece.type === "performer");
   275	    const afterPeople = (rows[index + 1].pieces || []).filter((piece) => piece.type === "performer");
   276	    for (const before of beforePeople) {
   277	      const after = afterPeople.find((candidate) => performerKey(candidate) !== performerKey(before));
   278	      if (after) { handoffPair = { beforeScene: rows[index], afterScene: rows[index + 1], before, after }; break; }
   279	    }
   280	  }
   281	  if (handoffPair && registrations.length) {
   282	    const item = registrations[0];
   283	    Object.assign(byScene.get(handoffPair.beforeScene).get(item.id), {
   284	      heldBy: handoffPair.before.id, holdSide: "R",
   285	    });
   286	    Object.assign(byScene.get(handoffPair.afterScene).get(item.id), {
   287	      heldBy: handoffPair.after.id, holdSide: "R",
   288	    });
   289	  } else if (registrations.length) {
   290	    const holderScene = rows.find((scene) => (scene.pieces || []).some((piece) => piece.type === "performer"));
   291	    const holder = holderScene && (holderScene.pieces || []).find((piece) => piece.type === "performer");
   292	    if (holder) Object.assign(byScene.get(holderScene).get(registrations[0].id), { heldBy: holder.id, holdSide: "R" });
   293	  }
