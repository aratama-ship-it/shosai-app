   227	  let pieceNumber = 1;
   228	  const nextPieceId = () => {
   229	    while (usedPieceIds.has(`scanpiece-${pieceNumber}`)) pieceNumber += 1;
   230	    const id = `scanpiece-${pieceNumber}`;
   231	    usedPieceIds.add(id);
   232	    pieceNumber += 1;
