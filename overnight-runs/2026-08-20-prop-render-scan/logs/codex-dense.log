   322	function propInjectionCoverage(project, registrations, onStageArea = () => true) {
   323	  const ids = new Set((registrations || []).map((item) => item.id));
   324	  const rows = sceneRows(project || {});
   325	  const coverage = { right: false, left: false, floor: false, offstage: false, handoff: false, disappears: false };
   326	  rows.forEach((scene) => {
   327	    const pieces = scene.pieces || [];
   328	    pieces.filter((piece) => ids.has(piece.setId)).forEach((piece) => {
   329	      if (piece.heldBy && piece.holdSide === "R") coverage.right = true;
   330	      if (piece.heldBy && piece.holdSide === "L") coverage.left = true;
   331	      if (!piece.heldBy && onStageArea(piece.u, piece.v)) coverage.floor = true;
   332	      if (!piece.heldBy && !onStageArea(piece.u, piece.v)) coverage.offstage = true;
   333	    });
   334	  });
   335	  for (let index = 0; index < rows.length - 1; index += 1) {
   336	    const before = rows[index].pieces || [];
   337	    const after = rows[index + 1].pieces || [];
   338	    for (const id of ids) {
   339	      const a = before.find((piece) => piece.setId === id);
   340	      const b = after.find((piece) => piece.setId === id);
   341	      if (a && !b) coverage.disappears = true;
   342	      if (!a?.heldBy || !b?.heldBy) continue;
   343	      const holderA = before.find((piece) => piece.id === a.heldBy && piece.type === "performer");
   344	      const holderB = after.find((piece) => piece.id === b.heldBy && piece.type === "performer");
   345	      if (holderA && holderB && performerKey(holderA) !== performerKey(holderB)) coverage.handoff = true;
   346	    }
   347	  }
   348	  return coverage;
   349	}
