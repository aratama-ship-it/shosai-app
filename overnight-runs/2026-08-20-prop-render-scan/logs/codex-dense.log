   238	    const injected = new Map();
   239	    registrations.forEach((item, propIndex) => {
   240	      const u = 0.12 + rng() * 0.76;
   241	      const v = 0.12 + rng() * 0.76;
   242	      const piece = {
   243	        id: nextPieceId(), type: "prop", setId: item.id, propShape: item.propShape,
