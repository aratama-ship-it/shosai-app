+    }
+  }
+  if (handoffPair && registrations.length) {
+    const item = registrations[0];
+    Object.assign(byScene.get(handoffPair.beforeScene).get(item.id), {
+      heldBy: handoffPair.before.id, holdSide: "R",
+    });
