+  if (!shows.length) { console.error("ERROR: 対象ショーが0件です。対象外一覧を確認してください。"); exclusions.forEach((item) => console.error(`- ${item.file}: ${item.reason}`)); process.exitCode = 2; return; }
+  const combinations = combinationsFor(options);
+  const issues = [];
