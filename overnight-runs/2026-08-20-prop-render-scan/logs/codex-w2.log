+          const injected = synthesizeProps(project, contract.propShapes, options.seed, contract.onStageArea);
+          project = injected.project;
+          injectedNames = injected.registrations.map((item) => item.name);
+          const missing = Object.entries(injected.coverage).filter(([, value]) => !value).map(([key]) => key);
+          if (missing.length) issues.push(issueFor(show, combo, "B0", "render", `注入した6状態を作れませんでした: ${missing.join(", ")}`));
+        }
+        try {
+          issues.push(...await scanOneShow(browser, show, combo, project, injectedNames, contract, serverInfo.origin));
