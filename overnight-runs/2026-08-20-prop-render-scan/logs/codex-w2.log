+      const combo = combinations[comboIndex];
+      console.log(`[${comboIndex + 1}/${combinations.length}] 波${combo.wave.toUpperCase()} ${combo.lang} ${combo.viewport.width}x${combo.viewport.height} — ${shows.length}ショー`);
+      for (let showIndex = 0; showIndex < shows.length; showIndex += 1) {
