+function parseViewport(value) {
+  const match = String(value || "").match(/^(\d+)x(\d+)$/);
+  if (!match) throw new Error(`画面幅は 1440x900 の形で指定してください: ${value}`);
+  const viewport = { width: Number(match[1]), height: Number(match[2]) };
