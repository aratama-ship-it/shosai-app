+      index += 1;
+      while (index < argv.length && !argv[index].startsWith("--")) { options.shows.push(path.resolve(argv[index])); index += 1; }
+      index -= 1;
+      if (!options.shows.length) throw new Error("--shows の後に1つ以上のパスが必要です。");
+      continue;
