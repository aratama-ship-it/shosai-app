+  return issues;
+}
+
+async function scanOneShow(browser, show, combo, project, injectedNames, contract, origin) {
+  const context = await browser.newContext({ viewport: combo.viewport, serviceWorkers: "block" });
+  let timer;
+  try {
+    return await Promise.race([
