      setNames: setRows.map((row) => row.querySelector(".stage-cast-name")?.textContent?.trim() || ""),
      blankPropRows: propRows.filter((row) => !(row.querySelector(".stage-cast-name")?.textContent || "").trim()).length,
    };
  }, { ids: contract.domIds });
