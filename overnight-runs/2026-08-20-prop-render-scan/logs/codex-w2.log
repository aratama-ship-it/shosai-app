+    path.join(APP_ROOT, ".stage-sketch-mcp", "exports"),
+    path.join(parent, "jjk-show"),
+    path.join(parent, "show-creation"),
+    path.join(parent, "show-creation", "demo-11works-2026-08-16", "sketches"),
