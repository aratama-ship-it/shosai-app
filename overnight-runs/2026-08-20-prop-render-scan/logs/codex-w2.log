+    const nextScene = rows[disappearAt + 1];
+    if (nextScene) {
+      const removed = byScene.get(nextScene).get(item.id);
+      nextScene.pieces = nextScene.pieces.filter((piece) => piece !== removed);
+      byScene.get(nextScene).delete(item.id);
+    }
+  }
