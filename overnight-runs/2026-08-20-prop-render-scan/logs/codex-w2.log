  };
  function dimLabel(kind, key) {
    if (isEn()) {
      return tm("dimBy", `${kind}.${key}`, null) || tm("dim", key, DIM_META[key].label);
    }
    return (DIM_LABELS[kind] && DIM_LABELS[kind][key]) || DIM_META[key].label;
  }

