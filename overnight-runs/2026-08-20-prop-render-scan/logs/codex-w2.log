+      propRows: propRows.length,
+      setRows: setRows.length,
+      castRows: rows(ids.castList).length,
+      propsHidden: Boolean(document.getElementById(ids.groupProps)?.hidden),
+      setText: document.getElementById(ids.setList)?.textContent || "",
