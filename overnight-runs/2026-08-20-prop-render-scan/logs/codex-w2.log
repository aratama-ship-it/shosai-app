+      }
+      const side = piece.holdSide === "L" ? "L" : "R";
+      const slot = `${piece.heldBy}:${side}`;
+      if (slots.has(slot)) {
+        findings.push({ code: "E2", sceneId: scene.id || "", detail: `${piece.heldBy} の${side}手を ${slots.get(slot)} と ${piece.id || "(idなし)"} が同時に指しています。` });
