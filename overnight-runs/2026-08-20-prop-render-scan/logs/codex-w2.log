+      }
+      const info = statSync(file);
+      if (!info.isFile()) { response.writeHead(404); response.end("not found"); return; }
+      const body = readFileSync(file);
+      response.writeHead(200, { "content-type": contentType(file), "cache-control": "no-store" });
