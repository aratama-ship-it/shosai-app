+    const snapshot = await page.evaluate(({ ids }) => {
+      const props = document.getElementById(ids.propList);
+      const moves = document.getElementById(ids.propMoves);
+      const cast = document.getElementById(ids.castList);
+      return {
+        propRows: [...(props?.children || [])].filter((child) => child.tagName === "DIV").length,
+        castRows: [...(cast?.children || [])].filter((child) => child.tagName === "DIV").length,
