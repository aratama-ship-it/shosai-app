function scenePerformerKeys(project, sceneId) {
  const scene = sceneRows(project).find((item) => item.id === sceneId);
  return new Set((scene?.pieces || []).filter((piece) => piece.type === "performer" && piece.castId).map((piece) => piece.castId)).size;
}

async function scanInContext(context, show, combo, project, injectedNames, contract, origin) {
