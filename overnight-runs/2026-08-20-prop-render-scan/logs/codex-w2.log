+      return {
+        propRows: [...(props?.children || [])].filter((child) => child.tagName === "DIV").length,
+        castRows: [...(cast?.children || [])].filter((child) => child.tagName === "DIV").length,
+        movesEmpty: !(moves?.textContent || "").trim(),
+        movesHidden: Boolean(moves?.hidden),
