    ? project.activeSceneId : sceneRows(project)[0]?.id;
  const initial = await page.evaluate(({ ids }) => {
    const rows = (id) => [...(document.getElementById(id)?.children || [])].filter((child) => child.tagName === "DIV");
    const propRows = rows(ids.propList);
