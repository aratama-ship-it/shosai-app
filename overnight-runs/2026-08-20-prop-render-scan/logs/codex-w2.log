+    nonLightSets: sets.filter((item) => item && item.kind !== "light").length,
+    injectedNames,
+    scenes: sceneRows(project).length,
+  };
+}
+
+function scenePerformerKeys(project, sceneId) {
+  const scene = sceneRows(project).find((item) => item.id === sceneId);
