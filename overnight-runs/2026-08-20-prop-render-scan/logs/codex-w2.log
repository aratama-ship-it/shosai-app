+  try {
+    return await Promise.race([
+      scanInContext(context, show, combo, project, injectedNames, contract, origin),
+      new Promise((_, reject) => { timer = setTimeout(() => reject(new Error("1ショー90秒の上限を超えました。")), SHOW_TIMEOUT_MS); }),
