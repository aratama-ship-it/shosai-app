+  if (snapshot.setRows + snapshot.propRows !== expected.nonLightSets) {
+    failures.push({ code: "B1", detail: `セット+小道具行 ${snapshot.setRows + snapshot.propRows} / light以外の登録 ${expected.nonLightSets}` });
+  }
