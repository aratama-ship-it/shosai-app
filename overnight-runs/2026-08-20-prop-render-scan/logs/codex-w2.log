+  page.on("pageerror", (error) => issues.push(issueFor(show, combo, "A1", "fatal", error.message, error.stack)));
+  page.on("console", (message) => {
+    if (message.type() === "error") issues.push(issueFor(show, combo, "A2", "render", message.text()));
