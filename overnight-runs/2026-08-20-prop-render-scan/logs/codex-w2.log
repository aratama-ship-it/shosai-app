+      const selected = issues.filter((item) => item.combination === comboLabel(combo)
+        || (item.combination === "元データ" && combo.wave === "a"));
+      const file = path.join(DEFAULT_REPORT_DIR, `report-${combo.wave}-${combo.lang}-${combo.viewport.width}x${combo.viewport.height}.md`);
