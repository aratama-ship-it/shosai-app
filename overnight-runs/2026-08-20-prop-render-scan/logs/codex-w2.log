+      document: { write() {}, close() {} },
+      close() {},
+      focus() {},
+    });
+  }, { projectValue: project, storageKey: contract.storageKey, tourKey: contract.tourKey, langKey: contract.langKey, lang: combo.lang });
+
+  await page.goto(`${origin}/stage.html`, { waitUntil: "load" });
