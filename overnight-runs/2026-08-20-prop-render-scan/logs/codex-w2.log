+    if (snapshot.movesEmpty !== snapshot.movesHidden) issues.push(issueFor(show, combo, "D2", "render", `シーン ${scene.id}: 受け渡し行の空文字=${snapshot.movesEmpty} / hidden=${snapshot.movesHidden}`));
