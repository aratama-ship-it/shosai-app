  actual: |-
    const CACHE_NAME = "stage-sketch-pwa-v163";
    const APP_SHELL = [
      "./stage.html",
      "./style.css?v=212",
      "./stage-venues.js?v=20",
      "./stage-venue-lines.js?v=4",
      "./stage-i18n.js?v=86",
